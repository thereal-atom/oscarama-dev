      .calh{display:grid;grid-template-columns:calc(100% / 7) 1fr calc(100% / 7);align-items:stretch;background:var(--K2)}
      .calh b{display:grid;place-items:center;font:400 18px/1 var(--pxf);text-transform:uppercase;min-height:46px}
      .calb{border:0;border-radius:0;background:none;color:inherit;font:400 20px/1 var(--pxf);cursor:pointer;padding:0}
      .calb:hover:not(:disabled){background:var(--M);color:var(--K)}
      .calb:disabled{opacity:.3;cursor:default}
      #cal-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:2px}
      #cal-grid>*{aspect-ratio:1;display:grid;place-items:center;font:400 clamp(16px,1.5cqw,21px)/1 var(--pxf);font-style:normal}
      #cal-grid span{aspect-ratio:auto;font:500 10px/1 var(--mono);opacity:.7;padding:8px 0 5px}
      #cal-grid button{border:0;border-radius:0;background:var(--K2);color:inherit;cursor:pointer;padding:0;margin:0}
      #cal-grid button:hover:not(:disabled){background:var(--M);color:var(--K)}
      #cal-grid button:disabled{opacity:.32;cursor:default}
      #cal-grid button[aria-pressed="true"]{background:var(--G);color:var(--OG)}
      .tiles{display:grid;grid-template-columns:repeat(var(--tc,2),minmax(0,1fr));gap:2px}
      .tile{position:relative;display:block;min-height:54px}
      .tile input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
      .tile span{position:absolute;inset:0;display:flex;align-items:flex-end;padding:9px 10px;background:var(--K2);font:400 15px/1.05 var(--pxf);text-transform:uppercase}
      .tile:hover span{background:var(--M);color:var(--K)}
      .tile input:checked+span{background:var(--G);color:var(--OG)}
      .tile input:focus-visible+span{outline:3px solid var(--M);outline-offset:-3px}
      .inp{width:100%;border:0;border-radius:0;background:var(--M);color:var(--K);font:500 17px/1.3 var(--sans);padding:15px 14px;display:block;resize:vertical;margin:0;-webkit-appearance:none;appearance:none}
      .inp::placeholder{color:var(--phc)}
      .inp:focus{outline:3px solid var(--G);outline-offset:-3px}
      .two{display:grid;gap:2px}
      .send{border:0;border-radius:0;cursor:pointer;width:100%;background:var(--G);color:var(--OG);display:flex;justify-content:space-between;align-items:center;gap:14px;padding:calc(var(--p) * 1.6) calc(var(--p) * 1.4);font:400 clamp(27px,3cqw,46px)/1 var(--pxf);text-transform:uppercase;text-align:left}
      .send .bm{--k:.55}
      .send:hover,.send:focus-visible{background:var(--M);color:var(--K)}
      .fine{font:400 12px/1.5 var(--mono);opacity:.8;margin-top:10px}
