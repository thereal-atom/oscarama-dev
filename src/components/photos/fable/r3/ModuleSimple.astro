---
import Switcher from "@/components/photos/Switcher.astro";
import Viewer from "@/components/photos/fable/r3/Viewer.astro";
import { events, contact, clients } from "@/data/photos";
import { mixed, shotIndex } from "@/components/photos/fable/derive";
import { schemes, alpha, onAccent, type SchemeId } from "@/components/photos/schemes";

interface Props { scheme: SchemeId }
const S = schemes[Astro.props.scheme];
// same colour logic as fable 2: dark swaps ink and paper; type on the accent is paper unless contrast is too low
const ink = S.dark ? S.paper : S.ink, paper = S.dark ? S.ink : S.paper;
const onA = S.dark ? paper : onAccent(S, "paper", 3);
const vars = [
  `--acc:${S.accent}`, `--ink:${ink}`, `--paper:${paper}`, `--on-a:${onA}`,
  `--rule:${alpha(ink, 0.16)}`, `--rule-i:${alpha(paper, 0.2)}`, `--rule-a:${alpha(onA, 0.35)}`,
].join(";");

// selects as justified rows: each photo's width follows its aspect ratio, so rows are flush with no holes.
// Row lengths alternate so sizes vary without any packing machinery.
const picks = mixed.slice(0, 18);
const pattern = [2, 3, 3, 2, 3, 3];
const rows: (typeof picks)[] = [];
for (let i = 0, k = 0; i < picks.length; k++) { const n = pattern[k % pattern.length]; rows.push(picks.slice(i, i + n)); i += n; }

const lead = events[2].shots[4];
const links = [
  { href: "#work", t: "Work", d: "selected frames" },
  { href: "#about", t: "About", d: "who's holding the camera" },
  { href: "#get", t: "What you get", d: "photo · video · portraits" },
  { href: "#contact", t: "Contact", d: "send a message" },
];
const get = [
  { t: "Event photography", d: "Conferences, hackathons, demo nights, launches. Candid over posed — the room as it actually felt." },
  { t: "Recap video", d: "A 60–90 second reel cut for socials, plus a longer cut if you want one for the website." },
  { t: "Speaker portraits", d: "Speakers, founders, your team. A mini studio in a corner of the venue, or whatever light we've got." },
  { t: "Quick selects", d: "A first batch of the best frames lands fast, so you can post while people are still talking about it." },
];
const kinds = ["hackathon", "demo night", "conference", "launch", "meetup", "something else"];
const needs = ["photos", "recap video", "portraits"];
const ig = `https://instagram.com/${contact.instagram}`, tw = `https://x.com/${contact.x}`;
const pad = (n: number) => String(n).padStart(2, "0");
---

<!--
  FABLE 2 — SIMPLE
  Fable 2 with most of the machinery taken out, as a clean base to add things back to.
  Kept:    the type (Inter Tight caps), the scheme colours and section inversions, big one-per-line hero links,
           mixed-size selects, logos, the accent contact slab with "Send message", the pixel email in the footer.
  Removed: visible grid lines + their draw-in animation, sticky column ruler, row numbers, section letters and
           meta labels, open grid cells, photo numbers, pixel icons, testimonials, the footer dissolve,
           the month calendar (now a native date field), the floating contact button.
-->
<!doctype html>
<html lang="en" style={vars} data-scheme={S.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={paper} />
    <title>Oscar shoots events — photo + video for tech events, London</title>
    <meta name="description" content="Freelance event photography and recap video for hackathons, demo nights, conferences and launches. London, will travel." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://picsum.photos" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;800;900&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:inline>
      @font-face{font-family:"Geist Pixel";src:url("https://cdn.jsdelivr.net/npm/geist@1.9.2/dist/fonts/geist-pixel/GeistPixel-Square.woff2") format("woff2");font-display:swap}
      :root{--sans:"Inter Tight","Helvetica Neue",Helvetica,Arial,sans-serif;--mono:"Geist Mono",ui-monospace,monospace;--px:"Geist Pixel","Geist Mono",monospace;
        --side:16px;--sec:64px;--gap:6px}
      @media (min-width:900px){:root{--side:32px;--sec:120px;--gap:10px}}
      *{box-sizing:border-box}
      html{background:var(--paper);scroll-behavior:smooth;-webkit-text-size-adjust:100%}
      body{margin:0;background:var(--paper);color:var(--ink);font:500 16px/1.45 var(--sans);overflow-x:clip;-webkit-font-smoothing:antialiased}
      a{color:inherit;text-decoration:none}
      p,h1,h2,h3,figure{margin:0}
      ::selection{background:var(--acc);color:var(--on-a)}
      :focus-visible{outline:3px solid var(--acc);outline-offset:2px}
      .mono{font:500 12px/1.4 var(--mono);text-transform:uppercase;letter-spacing:.04em}

      .sec{padding:var(--sec) var(--side)}
      .t-paper{background:var(--paper);color:var(--ink);--hi:var(--acc);--line:var(--rule)}
      .t-ink{background:var(--ink);color:var(--paper);--hi:var(--paper);--line:var(--rule-i)}
      .t-acc{background:var(--acc);color:var(--on-a);--hi:var(--on-a);--line:var(--rule-a)}
      .cap{font:900 clamp(48px,9.5vw,160px)/.86 var(--sans);letter-spacing:-.045em;text-transform:uppercase;color:var(--hi)}
      .kick{display:block;margin-bottom:18px;opacity:.7}

      /* ── top bar ── */
      .bar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px var(--side)}
      .bar b{font:900 18px/1 var(--sans);letter-spacing:-.02em}
      .bar nav{display:flex;gap:18px}
      .bar nav a:hover{color:var(--acc)}

      /* ── hero ── */
      .hero{padding:24px var(--side) 0;display:grid;gap:24px}
      .hero h1{font-size:clamp(64px,17.5vw,250px)}
      .hero h1 span{display:block}
      .lede{max-width:34ch;font-size:17px}
      .lead{display:block;aspect-ratio:4/5;overflow:hidden;cursor:zoom-in;background:var(--ink)}
      .lead img{width:100%;height:100%;object-fit:cover;display:block}
      @media (max-width:899px){.lead{display:none}} /* on a phone the links come straight after the headline */
      @media (min-width:900px){
        .hero{grid-template-columns:minmax(0,2fr) minmax(0,1fr);align-items:end;gap:32px}
        .hero h1{font-size:clamp(80px,12.2vw,220px)}
        .lede{font-size:19px;margin-top:28px}
      }
      .links{margin:40px 0 0;padding:0;list-style:none;border-top:1px solid var(--line)}
      .links a{display:flex;align-items:baseline;gap:16px;padding:14px var(--side);border-bottom:1px solid var(--line);transition:background-color .1s,color .1s}
      .links .n{flex:0 0 2.5em;color:var(--acc)}
      .links .t{flex:1;font:800 clamp(30px,6vw,72px)/1 var(--sans);letter-spacing:-.035em;text-transform:uppercase}
      .links .d{display:none}
      .links a:hover,.links a:focus-visible{background:var(--acc);color:var(--on-a)}
      .links a:hover .n,.links a:focus-visible .n{color:inherit}
      @media (min-width:900px){.links .d{display:block;flex:0 0 16em;opacity:.65}}

      /* ── selects ── */
      .head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:40px;flex-wrap:wrap}
      .head p{max-width:36ch}
      .rows{display:flex;flex-direction:column;gap:var(--gap)}
      .row{display:flex;gap:var(--gap)}
      .ph{flex:var(--ar) 1 0;min-width:0;aspect-ratio:var(--ar);overflow:hidden;background:var(--ink);cursor:zoom-in;display:block}
      .ph img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s cubic-bezier(.3,.7,.1,1)}
      .ph:hover img{transform:scale(1.03)}
      @media (max-width:899px){.row{flex-wrap:wrap}.row .ph:nth-child(3){flex-basis:100%}}

      /* ── about ── */
      .say{font:800 clamp(28px,4.4vw,64px)/1.04 var(--sans);letter-spacing:-.03em;max-width:22ch;text-wrap:balance}
      .say em{font-style:normal;color:var(--acc)}
      .about .more{margin-top:32px;max-width:52ch;font-size:17px;opacity:.85}
      @media (min-width:900px){.about .more{margin-left:auto;margin-right:8%}}

      /* ── what you get ── */
      .get{display:grid;gap:0;border-top:1px solid var(--line)}
      .get article{padding:24px 0;border-bottom:1px solid var(--line)}
      .get h3{font:800 clamp(24px,2.4vw,36px)/1 var(--sans);letter-spacing:-.03em;text-transform:uppercase;margin:10px 0 10px}
      .get p{max-width:38ch;opacity:.8}
      .get .n{color:var(--acc)}
      @media (min-width:900px){.get{grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}.get article{padding:24px 24px 40px 0;border-bottom:0}.get article+article{padding-left:24px;border-left:1px solid var(--line)}}

      /* ── clients ── */
      .logos{display:grid;grid-template-columns:repeat(2,1fr);gap:40px 24px;align-items:center;margin-top:8px}
      .logos img{height:clamp(36px,4vw,60px);width:auto;max-width:80%;object-fit:contain;display:block;margin:0 auto}
      @media (min-width:900px){.logos{grid-template-columns:repeat(4,1fr)}}

      /* ── contact ── */
      .contact{display:grid;gap:40px}
      .contact .intro p{margin-top:24px;max-width:30ch;font-size:19px}
      .contact .intro a{text-decoration:underline}
      @media (min-width:900px){.contact{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px}}
      form{display:grid;gap:28px}
      fieldset{border:0;margin:0;padding:0;min-width:0}
      legend{padding:0;margin-bottom:10px}
      .chips{display:flex;flex-wrap:wrap;gap:6px}
      .chip{position:relative}
      .chip input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
      .chip span{display:block;padding:10px 14px;border:1.5px solid currentColor;font:800 16px/1 var(--sans);text-transform:uppercase;letter-spacing:-.01em}
      .chip:hover span{background:var(--on-a);color:var(--acc);opacity:.85}
      .chip input:checked+span{background:var(--on-a);color:var(--acc);opacity:1}
      .chip input:focus-visible+span{outline:3px solid var(--on-a);outline-offset:2px}
      .fields{display:grid;gap:6px}
      @media (min-width:600px){.fields{grid-template-columns:1fr 1fr}.fields .w{grid-column:1/-1}}
      .fields input,.fields textarea{width:100%;border:0;border-radius:0;background:var(--paper);color:var(--ink);font:500 17px/1.3 var(--sans);padding:14px;display:block}
      .fields textarea{min-height:110px;resize:vertical}
      .fields input::placeholder,.fields textarea::placeholder{color:var(--ink);opacity:.45}
      .fields input:focus,.fields textarea:focus{outline:3px solid var(--on-a);outline-offset:0}
      .send{border:0;border-radius:0;cursor:pointer;width:100%;display:flex;justify-content:space-between;align-items:center;padding:18px 20px;background:var(--on-a);color:var(--acc);font:900 clamp(30px,3.6vw,52px)/1 var(--sans);letter-spacing:-.04em;text-transform:uppercase}
      .send:hover,.send:focus-visible{background:var(--ink);color:var(--paper)}
      .fine{font:400 12px/1.45 var(--mono);opacity:.85}
      .fine a{text-decoration:underline}

      /* ── footer ── */
      .foot{padding:var(--sec) var(--side) 32px}
      .mailw{display:block;color:var(--acc)}
      .mail{font:400 30px/1 var(--px);white-space:nowrap;letter-spacing:-.03em;display:inline-block}
      .mailw:hover{color:var(--ink)}
      .soc{display:grid;margin-top:40px;border-top:1px solid var(--line)}
      .soc a{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:16px 0;border-bottom:1px solid var(--line);font:900 clamp(36px,6vw,96px)/.9 var(--sans);letter-spacing:-.04em;text-transform:uppercase}
      .soc a small{font:500 12px/1.2 var(--mono);letter-spacing:.02em;text-transform:none;opacity:.7}
      .soc a:hover{color:var(--acc)}
      @media (min-width:900px){.soc{grid-template-columns:1fr 1fr;column-gap:32px}}
      .end{display:flex;justify-content:space-between;margin-top:32px;opacity:.7}
      [id]{scroll-margin-top:8px}
      @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.ph img{transition:none}}
    </style>
  </head>
  <body>
    <header class="t-paper" id="top">
      <div class="bar">
        <b>OSCAR</b>
        <nav class="mono">
          <a href={ig} target="_blank" rel="noopener">Instagram ↗</a>
          <a href={tw} target="_blank" rel="noopener">X ↗</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
      <div class="hero">
        <div>
          <h1 class="cap" aria-label="Oscar shoots events."><span>Oscar</span><span>shoots</span><span>events.</span></h1>
          <p class="lede">Event photography and recap video for hackathons, demo nights, conferences and launches. {contact.basedIn}, will travel.</p>
        </div>
        <a class="lead" href={lead.src} data-shot={shotIndex.get(lead.id)} aria-label={`open photo: ${lead.caption}`}>
          <img src={lead.src} alt={lead.caption} width={lead.width} height={lead.height} decoding="async" fetchpriority="high" />
        </a>
      </div>
      <ul class="links">
        {links.map((l, i) => (
          <li><a href={l.href}><span class="n mono">{pad(i + 1)}</span><span class="t">{l.t}</span><span class="d mono">{l.d}</span><span aria-hidden="true">↓</span></a></li>
        ))}
      </ul>
    </header>

    <section class="sec t-paper" id="work">
      <div class="head">
        <h2 class="cap">Selects</h2>
        <p>A few favourites from recent hackathons, demo nights and launches. Tap any frame to open it.</p>
      </div>
      <div class="rows">
        {rows.map((row) => (
          <div class="row">
            {row.map((s) => (
              <a class="ph" href={s.src} data-shot={shotIndex.get(s.id)} aria-label={`${s.caption} — ${s.event.name}`} style={`--ar:${(s.width / s.height).toFixed(3)}`}>
                <img src={s.thumb} srcset={`${s.thumb} 533w, ${s.src} 1600w`} sizes="(min-width:900px) 45vw, 100vw" alt="" width={s.width} height={s.height} loading="lazy" decoding="async" />
              </a>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section class="sec t-ink about" id="about">
      <span class="kick mono">About</span>
      <p class="say">I'm Oscar. I shoot the events tech people actually go to — <em>hackathons</em> at hour 22, <em>demo nights</em>, <em>launch parties</em>, panels, and founders in wetsuits.</p>
      <p class="more">I build things too, so I know which moments matter: the demo that lands, the room reacting, the hallway chat that turns into a company. I work quietly, I don't need a long brief, and you get pictures people actually want to post.</p>
    </section>

    <section class="sec t-paper" id="get">
      <h2 class="cap" style="margin-bottom:40px">What you get</h2>
      <div class="get">
        {get.map((s, i) => (
          <article><span class="n mono">{pad(i + 1)}</span><h3>{s.t}</h3><p>{s.d}</p></article>
        ))}
      </div>
    </section>

    <section class="sec t-ink" id="clients">
      <span class="kick mono">Shot for</span>
      <div class="logos">
        {clients.map((c) => <img src={S.dark && c.name === "SpaceX AI" ? "/photos/opus/spacexai-mark.svg" : c.logo.src} alt={c.name} loading="lazy" style={S.dark ? "filter:brightness(0)" : undefined} />)}
      </div>
    </section>

    <section class="sec t-acc" id="contact" aria-label="contact me">
      <div class="contact">
        <div class="intro">
          <h2 class="cap">Contact<br />me</h2>
          <p>Tell me what it is and when. I'll reply within a day with availability and a quote.</p>
        </div>
        <form id="form" novalidate>
          <fieldset>
            <legend class="mono">What is it?</legend>
            <div class="chips">{kinds.map((k) => <label class="chip"><input type="radio" name="kind" value={k} /><span>{k}</span></label>)}</div>
          </fieldset>
          <fieldset>
            <legend class="mono">What do you need?</legend>
            <div class="chips">{needs.map((k, i) => <label class="chip"><input type="checkbox" name="need" value={k} checked={i === 0} /><span>{k}</span></label>)}</div>
          </fieldset>
          <div class="fields">
            <input type="text" name="name" placeholder="Your name" autocomplete="name" aria-label="your name" />
            <input type="email" name="email" placeholder="Your email" autocomplete="email" aria-label="your email" required />
            <input class="w" type="date" name="date" aria-label="event date (optional)" title="Event date (optional)" />
            <textarea class="w" name="note" placeholder="Anything else? Venue, size, vibe — optional" aria-label="anything else"></textarea>
          </div>
          <button class="send" type="submit"><span>Send message</span><span aria-hidden="true">→</span></button>
          <p class="fine" id="sent">Opens your email app with this written out. Or just write to <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        </form>
      </div>
    </section>

    <footer class="foot t-paper">
      <a class="mailw" href={`mailto:${contact.email}`}><span class="mail" id="mail">{contact.email}</span></a>
      <div class="soc">
        <a href={ig} target="_blank" rel="noopener"><span>Instagram ↗</span><small>@{contact.instagram}</small></a>
        <a href={tw} target="_blank" rel="noopener"><span>X ↗</span><small>@{contact.x}</small></a>
      </div>
      <p class="end mono"><span>{contact.basedIn}, will travel</span><a href="#top">Back to top ↑</a></p>
    </footer>

    <Viewer bg={S.ink} fg={S.paper} accent={S.paper} onAccent={S.accent} bookHref="#contact" bookLabel="contact me about a shoot like this →" mono='"Geist Mono", ui-monospace, monospace' display='"Inter Tight", sans-serif' />
    <Switcher />

    <script define:vars={{ email: contact.email }}>window.__mail = email;</script>
    <script>
      import { wireBook, fitText } from "@/components/photos/fable/r3/book";
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      fitText($("mail"));
      wireBook({ form: $<HTMLFormElement>("form"), email: (window as any).__mail, sent: $("sent") });
    </script>
  </body>
</html>
