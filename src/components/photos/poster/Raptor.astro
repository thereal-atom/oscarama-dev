---
// RAPTOR: the "Raptor" study poster, translated to a hire page.
// Paper sheet with a dot grid, faint crumple + fold, black brush-ink marks, bright hand-lettered titles (Knewave),
// tiny grotesk labels placed asymmetrically, one small coloured tag. Photos sit on the sheet as studies.
// Signature interaction: the brush marks draw themselves (once) as they come into view; the hero photo is an
// ink-print study (greyscale, multiplied into the paper) that opens in full colour.
import Switcher from "@/components/photos/Switcher.astro";
import Viewer from "@/components/photos/fable/r3/Viewer.astro";
import { schemes, mix, type SchemeId } from "@/components/photos/schemes";
import { allShots, services, contact, clients } from "@/data/photos";

interface Props { scheme: SchemeId }
const S = schemes[Astro.props.scheme];
const accInk = mix(S.accent, S.ink, 0.18); // accent for tiny text on paper

const picked = (() => {
  const by = new Map<string, typeof allShots>();
  allShots.forEach((s) => by.set(s.event.slug, [...(by.get(s.event.slug) ?? []), s]));
  const lists = [...by.values()];
  const out: typeof allShots = [];
  for (let i = 0; out.length < 10 && i < 8; i++) for (const l of lists) if (l[i] && out.length < 10 && i + lists.indexOf(l) > 0) out.push(l[i]);
  return out;
})();
const hero = allShots[0];
const idx = (id: string) => allShots.findIndex((s) => s.id === id);
const pad = (n: number) => String(n).padStart(2, "0");
const month = (iso: string) => new Date(iso + "T12:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
// desktop: column start / span / top offset (px) on a 12-col sheet; mobile: width % + side
const place = [
  { c: 2, s: 6, t: 0, mw: 100, r: false },
  { c: 9, s: 3, t: 140, mw: 64, r: true },
  { c: 4, s: 4, t: 40, mw: 78, r: false },
  { c: 9, s: 4, t: 160, mw: 70, r: true },
  { c: 1, s: 7, t: 30, mw: 100, r: false },
  { c: 9, s: 3, t: 220, mw: 62, r: false },
  { c: 3, s: 3, t: 0, mw: 70, r: true },
  { c: 7, s: 5, t: 90, mw: 86, r: false },
  { c: 2, s: 5, t: 20, mw: 74, r: true },
  { c: 8, s: 4, t: 150, mw: 80, r: false },
];

const ig = `https://instagram.com/${contact.instagram}`;
const tw = `https://x.com/${contact.x}`;
const kinds = ["conference", "hackathon", "demo night", "launch", "panel", "meetup", "offsite", "something else"];
const needs = ["photos", "recap video", "portraits", "24h selects"];

// paper: crumple (lit turbulence, remapped so flat paper stays white) + sparse ink specks
const svg = (s: string) => `url("data:image/svg+xml,${encodeURIComponent(s)}")`;
const crumple = svg(`<svg xmlns='http://www.w3.org/2000/svg' width='1100' height='1100'><filter id='c' x='0' y='0' width='100%' height='100%'><feTurbulence type='fractalNoise' baseFrequency='0.011' numOctaves='5' seed='11' stitchTiles='stitch'/><feDiffuseLighting lighting-color='#fff' surfaceScale='2.4'><feDistantLight azimuth='225' elevation='52'/></feDiffuseLighting><feComponentTransfer><feFuncR type='linear' slope='1.5' intercept='-0.18'/><feFuncG type='linear' slope='1.5' intercept='-0.18'/><feFuncB type='linear' slope='1.5' intercept='-0.18'/></feComponentTransfer></filter><rect width='100%' height='100%' filter='url(#c)'/></svg>`);
const specks = svg(`<svg xmlns='http://www.w3.org/2000/svg' width='700' height='700'><filter id='n' x='0' y='0'><feTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='1' seed='4' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.07 0 0 0 0 0.07 0 0 0 0 0.07 0 0 0 40 -31.4'/></filter><rect width='100%' height='100%' filter='url(#n)'/></svg>`);
const vars = [`--acc:${S.accent}`, `--acc-ink:${accInk}`, `--ink:${S.ink}`, `--paper:${S.paper}`, `--crumple:${crumple}`, `--specks:${specks}`].join(";");
---
<!doctype html>
<html lang="en" style={vars} data-scheme={S.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={S.paper} />
    <title>Oscar Falemara — event photography + video for tech & startup events</title>
    <meta name="description" content="Event photography and recap video for tech and startup events. London based. Contact me to book." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Knewave&display=swap" rel="stylesheet" />
  </head>
  <body>
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <!-- wet brush edge for every ink mark -->
      <filter id="rp-brush" x="-10%" y="-20%" width="120%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.09" numOctaves="2" seed="5" result="t" />
        <feDisplacementMap in="SourceGraphic" in2="t" scale="5" />
      </filter>
      <!-- ragged ink edge for the hero study -->
      <filter id="rp-rag" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="3" seed="8" result="t" />
        <feDisplacementMap in="SourceGraphic" in2="t" scale="9" />
      </filter>
    </svg>

    <div class="sheet">
      <i class="crumple" aria-hidden="true"></i>

      <!-- ═════════════ HERO ═════════════ -->
      <header class="hero" id="top">
        <i class="fold" aria-hidden="true"></i>
        <a class="lab name" href="#top">Oscar Falemara</a>
        <nav class="lab nav" aria-label="main">
          <a href="#selects">Selects</a>
          <a href="#about">About</a>
          <a href="#services">What you get</a>
          <a href="#contact" class="hot">Contact me</a>
        </nav>
        <div class="tagbox">
          <span class="tag">Photo + Video</span>
          <span class="lab">For hire</span>
        </div>

        <button class="study" type="button" data-shot={idx(hero.id)} aria-label={`open photo: ${hero.caption}`}>
          <span class="study-in"><img src={hero.thumb} alt={`${hero.caption}, ${hero.event.name}`} width={Math.round(hero.width / 3)} height={Math.round(hero.height / 3)} fetchpriority="high" decoding="async" /></span>
        </button>
        <svg class="ink ink-corner" viewBox="0 0 120 120" aria-hidden="true"><path pathLength="1" d="M8 112 C 6 80, 7 44, 12 10 C 40 8, 76 9, 112 12" /></svg>
        <svg class="ink ink-dash" viewBox="0 0 220 40" aria-hidden="true"><path pathLength="1" d="M6 26 C 50 12, 120 8, 214 20" /></svg>

        <p class="lab l-a">Event photography<br />+ recap video</p>
        <h1 class="letter hero-letter"><span class="sr">Oscar Falemara: event photography and video for tech and startup events</span><span aria-hidden="true">Oscar</span></h1>
        <p class="lede">Event photos + video for tech &amp; startup events. London, will travel.</p>
        <p class="lab l-b">Tech &amp; startup<br />events study</p>
        <div class="lab l-c">
          <span>Conferences, hackathons</span>
          <span class="a">launches, demo nights</span>
          <span class="a">panels, meetups, offsites</span>
        </div>
        <p class="lab l-d"><a href={ig} target="_blank" rel="noopener">Instagram ↗</a> <a href={tw} target="_blank" rel="noopener">X ↗</a> <a href={`mailto:${contact.email}`}>Email ↗</a></p>
      </header>

      <main>
        <!-- ═════════════ SELECTS ═════════════ -->
        <section class="sel" id="selects" aria-labelledby="sel-h">
          <div class="shead">
            <p class="lab">No. 01<br /><span class="a">Selected studies</span></p>
            <h2 class="letter" id="sel-h">Selects</h2>
            <p class="lab right">Tap a print<br />to see it full size</p>
          </div>
          <div class="prints">
            {picked.map((s, i) => {
              const p = place[i];
              return (
                <figure class="print" style={`--c:${p.c};--s:${p.s};--t:${p.t}px;--mw:${p.mw}%`} data-r={p.r ? "" : undefined}>
                  <button type="button" data-shot={idx(s.id)} aria-label={`open photo: ${s.caption}, ${s.event.name}`}>
                    <img src={s.thumb} alt={`${s.caption}, ${s.event.name}`} width={Math.round(s.width / 3)} height={Math.round(s.height / 3)} loading={i < 2 ? "eager" : "lazy"} decoding="async" />
                  </button>
                  <figcaption class="lab">
                    <span>Study {pad(i + 1)} — {s.caption}</span>
                    <span class="a">{s.event.name}, {month(s.event.date)}</span>
                  </figcaption>
                  {i === 2 && <svg class="ink ink-ring" viewBox="0 0 240 90" aria-hidden="true"><path pathLength="1" d="M30 62 C 6 40, 40 10, 120 9 C 196 8, 236 30, 220 58 C 204 84, 110 88, 52 76 C 30 70, 22 52, 44 36" /></svg>}
                  {i === 4 && <svg class="ink ink-arrow" viewBox="0 0 160 120" aria-hidden="true"><path pathLength="1" d="M150 10 C 120 30, 70 40, 40 100 M 22 78 C 30 90, 36 100, 40 106 C 52 98, 62 94, 74 92" /></svg>}
                </figure>
              );
            })}
          </div>
        </section>

        <!-- ═════════════ ABOUT ═════════════ -->
        <section class="about" id="about" aria-labelledby="about-h">
          <div class="shead">
            <p class="lab">No. 02<br /><span class="a">About / what I shoot</span></p>
            <h2 class="letter" id="about-h">Hi, I'm Oscar</h2>
          </div>
          <div class="about-body">
            <p class="bio">I photograph and film tech and startup events in London and wherever they take me. Keynotes, 3am hackathon tables, launch-night toasts. I move fast, stay out of the way, and catch the <span class="mark">candid<svg class="ink ink-under" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M4 15 C 50 8, 130 6, 196 13" /></svg></span> stuff people actually share.</p>
            <ul class="lab shoots">
              <li>Conferences</li><li>Hackathons</li><li class="a">Demo nights</li><li>Launches</li><li class="a">Panels</li><li>Meetups</li><li>Offsites</li>
            </ul>
          </div>
        </section>

        <!-- ═════════════ WHAT YOU GET (ink sheet) ═════════════ -->
        <section class="svc" id="services" aria-labelledby="svc-h">
          <div class="shead">
            <p class="lab">No. 03<br /><span class="a">What you get</span></p>
            <h2 class="letter" id="svc-h">What you get</h2>
          </div>
          <ol class="svc-list">
            {services.map((s, i) => (
              <li style={`--i:${i}`}>
                <span class="lab a">{pad(i + 1)}</span>
                <h3>{s.name}</h3>
                <p>{s.detail}</p>
              </li>
            ))}
          </ol>
        </section>

        <!-- ═════════════ CLIENTS ═════════════ -->
        <section class="cli" aria-labelledby="cli-h">
          <p class="lab"><span id="cli-h">No. 04</span><br /><span class="a">Shot for</span></p>
          <ul class="logos">
            {clients.map((c) => (
              <li><img src={c.name === "SpaceX AI" ? "/photos/opus/spacexai-mark.svg" : c.logo.src} alt={c.name} loading="lazy" /><span class="lab">{c.name}</span></li>
            ))}
          </ul>
        </section>

        <!-- ═════════════ CONTACT ═════════════ -->
        <section class="con" id="contact" aria-labelledby="con-h">
          <div class="shead">
            <p class="lab">No. 05<br /><span class="a">Tell me about your event</span></p>
            <h2 class="letter" id="con-h">Contact me</h2>
          </div>
          <form class="form" id="form" novalidate>
            <fieldset>
              <legend class="lab">What is it?</legend>
              <div class="chips">{kinds.map((k, i) => <label class="chip"><input type="radio" name="kind" value={k} checked={i === 0} /><span>{k}</span></label>)}</div>
            </fieldset>
            <fieldset>
              <legend class="lab">What do you need?</legend>
              <div class="chips">{needs.map((k, i) => <label class="chip"><input type="checkbox" name="need" value={k} checked={i === 0} /><span>{k}</span></label>)}</div>
            </fieldset>
            <div class="row">
              <label class="fld"><span class="lab">When (optional)</span><input type="date" name="date" /></label>
              <label class="fld"><span class="lab">Your name</span><input type="text" name="name" autocomplete="name" /></label>
              <label class="fld"><span class="lab">Your email</span><input type="email" name="email" autocomplete="email" required /></label>
            </div>
            <label class="fld"><span class="lab">Anything else? Venue, size, vibe</span><textarea name="note" rows="3"></textarea></label>
            <p class="say" id="say" aria-live="polite"></p>
            <div class="send-row">
              <button class="send" type="submit">Send message →</button>
              <p class="lab fine" id="sent">Opens your email app with this written out.<br />Or write to <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
            </div>
          </form>
        </section>
      </main>
    </div>

    <!-- ═════════════ FOOTER (accent sheet) ═════════════ -->
    <footer class="foot">
      <p class="lab">No. 06<br />Or skip the form</p>
      <a class="mail letter" href={`mailto:${contact.email}`}><span data-fit>{contact.email}</span></a>
      <div class="foot-row lab">
        <a href={ig} target="_blank" rel="noopener">Instagram ↗<br />@{contact.instagram}</a>
        <a href={tw} target="_blank" rel="noopener">X ↗<br />@{contact.x}</a>
        <span>Based in<br />{contact.basedIn}</span>
        <a href="#top">Back<br />to top ↑</a>
      </div>
    </footer>

    <Viewer bg={S.paper} fg={S.ink} accent={S.accent} onAccent="#FFFFFF" mono="Inter, system-ui, sans-serif" display="Knewave, cursive" bookHref="#contact" bookLabel="Contact me about a shoot →" />
    <Switcher />

    <script>
      import { wireBook } from "@/components/photos/fable/r3/book";
      // the one signature: ink marks draw themselves once, as you reach them
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const marks = document.querySelectorAll<SVGElement>(".ink");
      if (reduced || !("IntersectionObserver" in window)) marks.forEach((m) => m.classList.add("on"));
      else {
        document.documentElement.classList.add("ink-anim");
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("on"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -18% 0px" });
        marks.forEach((m) => io.observe(m));
      }
      // fit the footer email to the width
      const fit = () => document.querySelectorAll<HTMLElement>("[data-fit]").forEach((el) => {
        const p = el.parentElement!; const cs = getComputedStyle(p);
        el.style.fontSize = "100px";
        el.style.fontSize = (100 * (p.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight)) * 0.98) / el.scrollWidth + "px";
      });
      fit(); addEventListener("resize", fit); (document as any).fonts?.ready.then(fit);
      wireBook({ form: document.getElementById("form") as HTMLFormElement, email: "hello@oscarama.dev", say: document.getElementById("say"), sent: document.getElementById("sent") });
    </script>

    <style is:inline>
      html { -webkit-text-size-adjust: 100%; background: var(--paper); scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body { margin: 0; overflow-x: clip; color: var(--ink); background: var(--paper); font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; }
      .defs { position: absolute; width: 0; height: 0; overflow: hidden; }
      a { color: inherit; }
      .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      /* ── the sheet ── */
      .sheet {
        position: relative; isolation: isolate;
        background-color: var(--paper);
        background-image: var(--specks), radial-gradient(circle, color-mix(in srgb, var(--ink) 30%, transparent) 1.1px, transparent 1.5px);
        background-size: 700px 700px, 26px 26px;
        background-position: 0 0, 13px 13px;
      }
      .crumple { position: absolute; inset: 0; z-index: -1; pointer-events: none; background-image: var(--crumple); background-size: 1100px 1100px; mix-blend-mode: multiply; opacity: .75; }
      .fold { position: absolute; left: 0; right: 0; top: 46%; height: 8px; pointer-events: none; z-index: -1;
        background: linear-gradient(to bottom, transparent, rgba(0,0,0,.045) 45%, rgba(255,255,255,.55) 58%, transparent); }
      .hero::after { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 8px; pointer-events: none; z-index: -1;
        background: linear-gradient(to right, transparent, rgba(0,0,0,.035) 45%, rgba(255,255,255,.5) 58%, transparent); }

      /* ── type ── */
      .lab { font-size: 11px; line-height: 1.32; font-weight: 500; letter-spacing: .01em; text-transform: uppercase; margin: 0; }
      .a, .lab .a { color: var(--acc-ink); }
      .letter { font-family: Knewave, "Marker Felt", cursive; font-weight: 400; color: var(--acc); margin: 0; line-height: .9; letter-spacing: -0.01em; }

      /* ── ink marks ── */
      .ink { position: absolute; overflow: visible; pointer-events: none; z-index: 2; }
      .ink path { fill: none; stroke: var(--ink); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; filter: url(#rp-brush); }
      html.ink-anim .ink path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s cubic-bezier(.6,.05,.3,1); }
      html.ink-anim .ink.on path { stroke-dashoffset: 0; }

      /* ── hero ── */
      .hero {
        position: relative; min-height: 100svh; box-sizing: border-box; padding: 16px;
        display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto 1fr auto auto auto auto; column-gap: 12px;
      }
      .name { grid-column: 1; grid-row: 1; text-decoration: none; font-weight: 600; }
      .nav { grid-column: 2; grid-row: 1 / span 2; justify-self: end; display: grid; gap: 7px; text-align: right; font-size: 12px; }
      .nav a { text-decoration: none; padding: 2px 0; }
      .nav a:hover, .nav a:focus-visible { color: var(--acc-ink); outline: none; text-decoration: underline; }
      .nav .hot { color: var(--acc-ink); font-weight: 700; }
      .tagbox { grid-column: 1; grid-row: 2; display: grid; justify-items: start; gap: 8px; margin-top: 26px; }
      .tag { display: inline-block; background: var(--acc); color: #fff; font-size: 11px; font-weight: 600; padding: 6px 9px 5px; letter-spacing: .02em; text-transform: uppercase; }
      .study { grid-column: 1 / -1; grid-row: 3; align-self: center; justify-self: center; width: min(86%, 560px); margin: 34px 0 10px; padding: 0; border: 0; background: none; cursor: zoom-in; position: relative; }
      .study-in { display: block; filter: url(#rp-rag); }
      .study img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; filter: grayscale(1) contrast(1.6) brightness(1.06); mix-blend-mode: multiply; }
      .study:hover img, .study:focus-visible img { filter: grayscale(.2) contrast(1.4); }
      .study:focus-visible { outline: 2px solid var(--acc); outline-offset: 6px; }
      .ink-corner { width: 64px; height: 64px; grid-column: 1; grid-row: 3; align-self: center; left: 2%; margin-top: -170px; }
      .ink-dash { width: 120px; height: 22px; grid-column: 2; grid-row: 3; align-self: end; justify-self: end; position: relative; margin-bottom: 0; }
      .l-a { grid-column: 2; grid-row: 4; justify-self: start; margin: 10px 0 6px; }
      .hero-letter { grid-column: 1 / -1; grid-row: 5; justify-self: center; font-size: clamp(108px, 34vw, 300px); transform: rotate(-3deg); margin: 0 0 0 -2%; }
      .lede { grid-column: 1 / -1; grid-row: 6; margin: 14px 0 0; font-size: 15px; line-height: 1.3; font-weight: 500; max-width: 26ch; justify-self: center; text-align: center; }
      .l-b { grid-column: 2; grid-row: 7; justify-self: end; text-align: right; margin-top: 22px; }
      .l-c { grid-column: 1; grid-row: 7; display: grid; margin-top: 22px; align-self: end; }
      .l-d { grid-column: 1 / -1; grid-row: 8; margin-top: 18px; display: flex; gap: 16px; font-size: 12px; }
      .l-d a { text-decoration: none; border-bottom: 1px solid currentColor; padding: 4px 0 1px; }
      @media (min-width: 760px) {
        .hero { padding: 28px 40px 36px; grid-template-columns: repeat(12, 1fr); column-gap: 16px; grid-template-rows: auto auto 1fr auto auto auto; }
        .name { grid-column: 1 / span 3; }
        .nav { grid-column: 4 / span 3; grid-row: 1; justify-self: start; text-align: left; display: flex; gap: 22px; font-size: 11px; }
        .tagbox { grid-column: 10 / span 3; grid-row: 1 / span 2; margin: 0; justify-self: start; }
        .study { grid-column: 4 / span 5; grid-row: 2 / span 2; width: 100%; max-width: 600px; margin: 40px 0 10px; }
        .ink-corner { grid-column: 3; grid-row: 2; width: 80px; height: 80px; margin: 20px 0 0 10px; align-self: start; }
        .ink-dash { grid-column: 9 / span 3; grid-row: 3; width: 170px; height: 30px; justify-self: start; margin: 0 0 20px 10px; }
        .l-a { grid-column: 10 / span 3; grid-row: 3; align-self: center; margin: 0 0 0 10px; }
        .hero-letter { grid-column: 3 / span 7; grid-row: 4; justify-self: start; font-size: clamp(140px, 15.5vw, 260px); margin: -10px 0 0 4%; }
        .lede { grid-column: 9 / span 4; grid-row: 4; align-self: end; justify-self: start; text-align: left; font-size: 16px; margin: 0 0 30px 10px; max-width: 24ch; }
        .l-b { grid-column: 8 / span 3; grid-row: 5; justify-self: start; text-align: left; margin-top: 18px; }
        .l-c { grid-column: 1 / span 4; grid-row: 6; margin-top: 18px; }
        .l-d { grid-column: 10 / span 3; grid-row: 6; align-self: end; margin: 0; justify-content: flex-end; font-size: 11px; }
      }

      /* ── section heads ── */
      .shead { position: relative; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 14px 12px; padding: 90px 16px 34px; }
      .shead > .lab:first-child { grid-column: 1 / -1; }
      .shead .letter { grid-column: 1 / -1; font-size: clamp(64px, 17vw, 160px); transform: rotate(-2deg); transform-origin: 0 100%; }
      .shead .right { grid-column: 1 / -1; justify-self: end; text-align: right; }
      @media (min-width: 760px) {
        .shead { grid-template-columns: repeat(12, 1fr); padding: 150px 40px 50px; column-gap: 16px; }
        .shead > .lab:first-child { grid-column: 1 / span 2; align-self: start; padding-top: 1.2em; }
        .shead .letter { grid-column: 3 / span 8; }
        .shead .right { grid-column: 11 / span 2; justify-self: start; text-align: left; align-self: end; padding-bottom: 1em; }
      }

      /* ── selects: prints on the sheet ── */
      .prints { position: relative; display: grid; gap: 54px; padding: 0 16px 120px; }
      .print { margin: 0; position: relative; width: var(--mw); }
      .print[data-r] { margin-left: auto; }
      .print button { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
      .print img { display: block; width: 100%; height: auto; box-shadow: 0 1px 0 rgba(0,0,0,.06), 0 10px 22px -16px rgba(0,0,0,.35); transition: transform .25s ease; }
      .print button:hover img { transform: translateY(-2px); }
      .print button:focus-visible { outline: 2px solid var(--acc); outline-offset: 5px; }
      .print figcaption { display: grid; gap: 1px; margin-top: 10px; }
      .print[data-r] figcaption { text-align: right; }
      .ink-ring { width: 230px; height: 86px; left: -18px; bottom: -30px; }
      .print[data-r] .ink-ring { left: auto; right: -18px; }
      .ink-arrow { width: 96px; height: 72px; right: 8px; top: -70px; }
      @media (min-width: 760px) {
        .prints { grid-template-columns: repeat(12, 1fr); column-gap: 16px; row-gap: 70px; padding: 0 40px 200px; align-items: start; }
        .print, .print[data-r] { grid-column: var(--c) / span var(--s); width: auto; margin: var(--t) 0 0; }
        .print[data-r] figcaption { text-align: left; }
        .print[data-r] .ink-ring { left: -18px; right: auto; }
        .ink-arrow { width: 140px; height: 105px; right: -120px; top: -40px; }
      }

      /* ── about ── */
      .about-body { padding: 0 16px 110px; display: grid; gap: 34px; }
      .bio { margin: 0; font-size: clamp(22px, 5.6vw, 40px); line-height: 1.18; letter-spacing: -0.02em; font-weight: 500; max-width: 26ch; }
      .mark { position: relative; white-space: nowrap; }
      .ink-under { left: -4%; width: 108%; height: .5em; bottom: -.3em; }
      .ink-under path { stroke-width: 4; }
      .shoots { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 18px; max-width: 320px; justify-self: end; }
      @media (min-width: 760px) {
        .about-body { grid-template-columns: repeat(12, 1fr); column-gap: 16px; padding: 0 40px 180px; }
        .bio { grid-column: 3 / span 7; }
        .shoots { grid-column: 11 / span 2; display: grid; align-self: end; justify-self: start; }
      }

      /* ── services: ink sheet (contrast flip) ── */
      .svc {
        background-color: var(--ink); color: var(--paper);
        background-image: radial-gradient(circle, color-mix(in srgb, var(--paper) 22%, transparent) 1.1px, transparent 1.5px);
        background-size: 26px 26px; background-position: 13px 13px;
      }
      .svc .a { color: var(--acc); }
      [data-scheme="ink-blue"] .svc .a { color: color-mix(in srgb, var(--acc) 80%, white); }
      .svc-list { list-style: none; margin: 0; padding: 10px 16px 120px; display: grid; gap: 44px; align-items: start; }
      .svc-list li { display: grid; gap: 8px; max-width: 30ch; align-content: start; }
      .svc-list li:nth-child(even) { justify-self: end; text-align: right; }
      .svc-list h3 { margin: 0; font-size: 26px; line-height: 1.02; font-weight: 600; letter-spacing: -0.025em; }
      .svc-list p { margin: 0; font-size: 14px; line-height: 1.4; opacity: .78; }
      @media (min-width: 760px) {
        .svc-list { grid-template-columns: repeat(12, 1fr); column-gap: 16px; row-gap: 0; padding: 10px 40px 180px; }
        .svc-list li, .svc-list li:nth-child(even) { justify-self: start; text-align: left; }
        .svc-list li:nth-child(1) { grid-column: 3 / span 4; }
        .svc-list li:nth-child(2) { grid-column: 8 / span 4; margin-top: 120px; }
        .svc-list li:nth-child(3) { grid-column: 2 / span 4; margin-top: 40px; }
        .svc-list li:nth-child(4) { grid-column: 7 / span 4; margin-top: 150px; }
        .svc-list h3 { font-size: 34px; }
      }

      /* ── clients ── */
      .cli { padding: 90px 16px 100px; display: grid; gap: 40px; }
      .logos { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 50px 20px; }
      .logos li { display: grid; gap: 12px; justify-items: start; }
      .logos li:nth-child(even) { margin-top: 40px; }
      .logos img { height: 44px; width: auto; max-width: 100%; object-fit: contain; filter: brightness(0); mix-blend-mode: multiply; }
      @media (min-width: 760px) {
        .cli { grid-template-columns: repeat(12, 1fr); column-gap: 16px; padding: 140px 40px 150px; }
        .cli > .lab { grid-column: 1 / span 2; }
        .logos { grid-column: 3 / span 10; grid-template-columns: repeat(4, 1fr); }
        .logos img { height: 62px; }
      }

      /* ── contact ── */
      .form { padding: 0 16px 120px; display: grid; gap: 28px; max-width: 900px; }
      fieldset { border: 0; margin: 0; padding: 0; }
      legend { padding: 0; margin-bottom: 12px; }
      .chips { display: flex; flex-wrap: wrap; gap: 8px; }
      .chip { position: relative; cursor: pointer; }
      .chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
      .chip span { display: block; font-size: 14px; font-weight: 500; padding: 9px 12px 8px; border: 1px solid var(--ink); background: color-mix(in srgb, var(--paper) 80%, transparent); }
      .chip input:checked + span { background: var(--acc); border-color: var(--acc); color: #fff; }
      .chip input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: 2px; }
      .row { display: grid; gap: 22px; }
      .fld { display: grid; gap: 4px; }
      .fld input, .fld textarea {
        font: 500 18px/1.3 Inter, system-ui, sans-serif; color: var(--ink); background: transparent; border: 0; border-bottom: 1.5px solid var(--ink);
        padding: 8px 0; min-height: 44px; width: 100%; box-sizing: border-box; border-radius: 0;
      }
      .fld input:focus, .fld textarea:focus { outline: none; border-bottom-color: var(--acc); border-bottom-width: 3px; }
      .say { margin: 0; font-size: clamp(20px, 4.6vw, 30px); line-height: 1.2; letter-spacing: -0.02em; font-weight: 500; max-width: 30ch; }
      .say b { color: var(--acc-ink); font-weight: 600; }
      .send-row { display: grid; gap: 14px; }
      .send { justify-self: start; font: 400 clamp(30px, 8vw, 54px)/1 Knewave, cursive; color: #fff; background: var(--acc); border: 0; padding: 16px 22px 14px; cursor: pointer; transform: rotate(-1.5deg); }
      .send:hover, .send:focus-visible { background: var(--ink); outline: none; }
      .fine { text-transform: none; font-size: 12px; font-weight: 400; }
      @media (min-width: 760px) {
        .con .form { margin-left: calc((100% - 80px - 11 * 16px) / 12 * 2 + 32px + 40px); padding: 0 40px 180px 0; }
        .row { grid-template-columns: 1fr 1fr 1.3fr; }
        .send-row { grid-template-columns: auto 1fr; align-items: center; gap: 30px; }
      }

      /* ── footer: accent sheet ── */
      .foot { background: var(--acc); color: #fff; padding: 60px 16px 100px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 26px; overflow: hidden; }
      .mail { color: var(--ink); text-decoration: none; display: block; }
      .mail span { display: block; width: max-content; font-size: 14vw; line-height: 1; }
      .mail:hover span, .mail:focus-visible span { color: #fff; }
      .foot-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
      .foot-row a { text-decoration: none; }
      .foot-row a:hover { text-decoration: underline; }
      @media (min-width: 760px) {
        .foot { padding: 90px 40px 110px; }
        .foot-row { grid-template-columns: repeat(4, max-content); gap: 60px; }
      }

      @media (prefers-reduced-motion: reduce) { .print img { transition: none; } }
    </style>
  </body>
</html>
