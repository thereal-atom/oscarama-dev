---
// Oscar Shoots concepts, rounds 2–3: double meanings (the Oscar, laurels) and photo techniques applied to the type
// itself (bracketing, long exposure, double exposure, histogram, thirds, zoom, ISO noise, raw file, crop).
// Same colour contract as Mark.astro.
import Bits from "@/components/photos/fable/r3/Bits.astro";
import { glyphRows } from "@/components/photos/fable/r3/bits";
import { statuette, shootsWord, osWord, oGlyph, expose, laurelL, laurelR, trail, histogram, noise, type IdeaId } from "./marks";

interface Props { id: IdeaId; mark?: boolean }
const { id, mark = false } = Astro.props;
const glyphOrWord = (m: boolean) => (m ? glyphRows("S") : glyphRows("SHOOTS"));
const evs = [["−1", -1], ["0", 0], ["+1", 1]] as const;
---
<span class:list={["mk", `id-${id}`, { compact: mark }]}>
  {id === "statuette" && <span class="stat"><Bits rows={statuette} class="fig" />{!mark && <span class="sw2"><small>and the</small><span class="wm sm">oscar shoots</span></span>}</span>}

  {id === "bracket" && (
    mark
      ? <span class="brk3"><i /><i /><i /></span>
      : <span class="brk">{evs.map(([ev], i) => <span class:list={["ev", `e${i}`]}><small>{ev}</small><span class="wm sm">oscar shoots</span></span>)}</span>
  )}

  {id === "bracket-px" && (
    mark
      ? <span class="brkp-m">{evs.map(([, ev]) => <Bits rows={expose(oGlyph, ev, 5)} class="pxo" />)}</span>
      : <span class="brk px">{evs.map(([label, ev]) => <span class="ev"><small>{label}</small><Bits rows={expose(shootsWord, ev, 9)} class="pxr" /></span>)}</span>
  )}

  {id === "laurels" && (
    <span class="lau"><Bits rows={laurelL} class="lf" /><span class="lw">{mark ? "OS" : <>OSCAR<br />SHOOTS</>}</span><Bits rows={laurelR} class="lf" /></span>
  )}

  {id === "trail" && <Bits rows={mark ? trail(oGlyph, 2, 5) : trail(shootsWord, 7, 16)} class="px7" />}

  {id === "double" && <span class="dbl"><span class="a">{mark ? "o" : "oscar"}</span><span class="b">{mark ? "s" : "shoots"}</span></span>}

  {id === "histogram" && <Bits rows={histogram(mark ? osWord : shootsWord)} class={mark ? "hm" : "hg"} />}

  {id === "thirds" && <span class="thr"><i class="pt" />{!mark && <span class="wm sm">oscar shoots</span>}</span>}

  {id === "zoom" && <span class="zm"><span class="wm">{mark ? "o" : "oscar"}</span><Bits rows={glyphOrWord(mark)} class="px7" /></span>}

  {id === "noise" && <span class="ns"><Bits rows={noise(mark ? osWord : shootsWord, 21)} class="px9n" />{!mark && <small>ISO 6400</small>}</span>}

  {id === "raw" && <span class="raw">{mark ? <b>.raw</b> : <>oscar_shoots<b>.RAW</b></>}</span>}

  {id === "crop" && (
    <span class="crp">
      <span class="wm">{mark ? "os" : "oscar shoots"}</span>
      <span class="cf"><i /><i /><i /><i /></span>
    </span>
  )}
</span>

