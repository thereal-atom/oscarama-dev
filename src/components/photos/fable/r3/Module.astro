            <span class="cap rot" id="rot" aria-hidden="true" data-words={JSON.stringify(words)} style="--am:4/1/span 1/span 6;--ad:6/1/span 2/span 12"><span class="w">{words[0]}</span><canvas></canvas></span>
          </h1>
          <p class="c mono lede mo" style="--am:5/1/span 1/span 6">Photo + video for startups and tech: mostly events, plus product shoots, launch videos and more. Based in {contact.basedIn}.</p>
          {links.map((l, i) => (
            <a class="c lk" href={l.href} style={`--am:${6 + i}/1/span 1/span 6;--ad:8/${1 + i * 3}/span 2/span 3`}>
              <span class="n mono"><span>{pad(i + 1)}</span><span class="dk" aria-hidden="true">↓</span></span>
              <span class="m"><span class="t">{l.t}</span><span class="d mono">{l.d}</span></span>
              <span class="a" aria-hidden="true">↓</span>
            </a>
          ))}
          <p class="c mono lede dk" style="--ad:8/13/span 2/span 4">Mostly events, plus product shoots, sports, launch videos and other bits. I turn up, stay out of the way, and you get pictures people actually post.</p>
          <a class="ph" href={lead.src} data-shot={shotIndex.get(lead.id)} aria-label={`open photo: ${lead.caption}`} style="--am:10/1/span 4/span 6;--ad:2/13/span 6/span 4">
            <img src={lead.src} alt={lead.caption} width={lead.width} height={lead.height} decoding="async" fetchpriority="high" />
