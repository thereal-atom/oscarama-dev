          {clients.map((c, i) => <div class="logo" style={`--am:${2 + Math.floor(i / 2) * 2}/${(i % 2) + 1}/span 2/span 1;--ad:2/${i + 1}/span 2/span 1`}><img class:list={{ sm: c.name === "SPACEXAI" }} src={S.dark && c.name === "SPACEXAI" ? "/photos/opus/spacexai-mark.svg" : c.logo.src} alt={c.name} loading="lazy" style={S.dark ? "filter:brightness(0)" : undefined} /><span class="mono">{c.name}</span></div>)}
          <a class="c fill you" href="#contact" style="--am:6/2/span 2/span 1;--ad:2/6/span 2/span 1"><span class="mono">next</span><b>YOUR LOGO →</b></a>
        </section>

        {showSaid && (
