---
// Logo concepts for oscarama, drawn in the fable 2 language: Inter Tight 900, Geist Mono labels, Geist Pixel,
// the 7-row bitmap alphabet, Caveat for the handwritten bits, one accent. Each concept shows the full lockup on
// the page ground, then the compact mark on the accent, inverted, and at 32px / 16px (favicon sizes).
import Switcher from "@/components/photos/Switcher.astro";
import Mark from "./Mark.astro";
import ShootsMark from "./ShootsMark.astro";
import IdeaMark from "./IdeaMark.astro";
import type { MarkId, ShootsId, IdeaId } from "./marks";
import { schemes, alpha, onAccent, type SchemeId } from "@/components/photos/schemes";

interface Props { scheme: SchemeId }
const S = schemes[Astro.props.scheme];
const ink = S.dark ? S.paper : S.ink, paper = S.dark ? S.ink : S.paper;
const onA = S.dark ? paper : onAccent(S, "paper", 3);
const vars = [`--acc0:${S.accent}`, `--ink:${ink}`, `--paper:${paper}`, `--on-a:${onA}`, `--line:${alpha(S.accent, S.dark ? 0.22 : 0.28)}`, `--grid:${alpha(ink, 0.06)}`, `--sub:${alpha(ink, 0.55)}`].join(";");

const concepts: Array<{ id: MarkId; t: string; d: string }> = [
  { id: "wordmark", t: "Wordmark", d: "Lowercase Inter Tight 900, tight, with a square accent full stop. The plainest option." },
  { id: "split", t: "Name split", d: "oscar + ama. Your name in ink, the rest in the accent." },
  { id: "stack", t: "Stacked caps", d: "The headline caps from the page, stacked 4 + 4 into a block." },
  { id: "pixel", t: "Pixel wordmark", d: "The page's 7-row bitmap alphabet, with the accent pixel as a full stop." },
  { id: "dissolve", t: "Dissolve", d: "The pixel wordmark breaking up to the right, like the footer dissolve." },
  { id: "lens", t: "Lens", d: "A 9×9 pixel lens: rings and one accent pixel in the middle." },
  { id: "camera", t: "Pixel camera", d: "A pixel camera with the record light in the accent. Pairs with the pixel font." },
  { id: "module", t: "Module o", d: "An o built from eight grid modules, one in the accent. The page grid as a mark." },
  { id: "viewfinder", t: "Viewfinder", d: "Accent viewfinder corners framing the name." },
  { id: "hand", t: "Handwritten", d: "Caveat with a drawn arrow, like the note on the hero photo." },
  { id: "sticker", t: "Sticker", d: "The hero's tilted accent tag on its own." },
  { id: "app", t: "App tile", d: "o. on an accent square. Built for avatars and favicons first." },
];
const pad = (n: number) => String(n).padStart(2, "0");

const ideas: Array<{ id: IdeaId; t: string; d: string }> = [
  { id: "sprout", t: "Green shoots", d: "Startup speak for early growth, and your clients are startups. A pixel sprout grows out of the full stop." },
  { id: "statuette", t: "The Oscar", d: "And the Oscar goes to… A pixel statuette, holding a camera up to its eye like your hero photo." },
  { id: "screen", t: "Camera screen", d: "The name as it'd look on the back of the camera: REC, battery, settings, focus box." },
  { id: "peaking", t: "Focus peaking", d: "Cameras mark in-focus edges with bright speckles. The name, outlined in accent peaking dots." },
  { id: "contact", t: "Contact sheet", d: "The name on a strip of film, with the select circled in grease pencil." },
  { id: "pass", t: "All-access pass", d: "The lanyard everyone at an event wears. Yours says photo + video." },
  { id: "slate", t: "Slate", d: "A clapperboard for the video side. Prod: Oscar Shoots, scene 01, take 01." },
  { id: "rolling", t: "Rolling shutter", d: "The wobble a fast pan gives video: the name sheared in slices, one slice in the accent." },
  { id: "burst", t: "Burst", d: "Shoots fired in burst mode, trailing accent echoes." },
  { id: "bracket", t: "Bracketed", d: "Exposure bracketing: the same shot at −1, 0 and +1." },
  { id: "aperture", t: "Aperture o", d: "The o of oscar as six aperture blades, the opening in the accent." },
];

const shoots: Array<{ id: ShootsId; t: string; d: string }> = [
  { id: "wordmark", t: "Wordmark", d: "Lowercase Inter Tight 900 with the square accent stop. Compact: os." },
  { id: "weights", t: "Two weights", d: "oscar heavy, shoots light: the who, then the what." },
  { id: "verb", t: "Accent verb", d: "The verb in the accent. Reads like the hero line it came from." },
  { id: "stack", t: "Stacked caps", d: "OSCAR / SHOOTS in the headline caps, with an accent rule. Compact: O over S." },
  { id: "pixel", t: "Pixel stack", d: "Both words in the page's bitmap alphabet, stacked, with the accent pixel full stop." },
  { id: "lens-o", t: "Lens o", d: "The o of oscar is a pixel lens with an accent centre. The lens alone is the icon." },
  { id: "viewfinder", t: "Viewfinder", d: "Accent viewfinder corners framing the name." },
  { id: "rec", t: "Rec", d: "A record light before the name. The light alone works as a tiny mark." },
  { id: "hand", t: "Handwritten", d: "Caveat with a drawn arrow, like the note on your hero photo." },
  { id: "sticker", t: "Sticker", d: "The hero's tilted accent tag with the new name on it." },
  { id: "tile", t: "App tile", d: "os. on an accent square, beside the wordmark. Made for avatars and favicons." },
];

// Name ideas for the photo + video side. Grouped by where the idea comes from. Availability (domains, handles)
// is not checked: every one needs a search before it's taken seriously.
const names: Array<{ group: string; items: Array<{ n: string; d: string; px?: boolean }> }> = [
  { group: "From you", items: [
    { n: "Oscar Shoots", d: "Lifted straight from the hero line. Says exactly what it is, and it's still your name." },
    { n: "Falemara", d: "Your surname alone. Rare enough to own, sounds like a studio." },
    { n: "Falll", d: "From @oscarfalll. Odd, short, and already your handle." },
    { n: "Oscar & Co", d: "Leaves room for a second shooter or an editor later." },
  ] },
  { group: "Photo terms", items: [
    { n: "Hot Pixel", d: "A sensor pixel stuck bright. It's the orange pixel in every mark on this page.", px: true },
    { n: "Contact Sheet", d: "Every frame from a shoot, printed small. Doubles as the contact page." },
    { n: "Selects", d: "What you hand over after an event. Already the name of the photo section." },
    { n: "Burst Mode", d: "Firing frames fast, like the first selects going out the same night." },
    { n: "One Two Fifty", d: "1/250s: a shutter speed that freezes a room full of people." },
    { n: "Rolling Shutter", d: "Photo and video in one name. Also just sounds like it's moving." },
  ] },
  { group: "Startup + event terms", items: [
    { n: "Run Sheet", d: "The event organiser's bible. Says you know how events actually run." },
    { n: "Green Room", d: "Backstage, where the good candids happen." },
    { n: "Demo Frame", d: "Demo days and launches, framed." },
    { n: "Shipped", d: "Launch-day language. Every shoot is a thing that shipped." },
  ] },
  { group: "From the design", items: [
    { n: "Module", d: "The square grid everything on the site sits on.", px: true },
    { n: "Dither", d: "The pixel dissolve that runs through every hover and the footer.", px: true },
  ] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Oscar Shoots — logos</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;800;900&family=Geist+Mono:wght@400;500&family=Caveat:wght@600;700&display=swap" rel="stylesheet" />
    <style is:inline>
      @font-face{font-family:"Geist Pixel";src:url("https://cdn.jsdelivr.net/npm/geist@1.9.2/dist/fonts/geist-pixel/GeistPixel-Square.woff2") format("woff2");font-display:swap}
      *,*::before,*::after{box-sizing:border-box}
      html{-webkit-text-size-adjust:100%}
      body{margin:0;background:var(--paper);color:var(--ink);font:400 13px/1.45 "Geist Mono",ui-monospace,monospace}
      .wrap{max-width:1440px;margin:0 auto;padding:0 16px 96px}
      @media (min-width:900px){.wrap{padding:0 26px 120px}}
      .mono{font-family:"Geist Mono",ui-monospace,monospace}
      header{padding:22px 0 28px;border-bottom:1px solid var(--line)}
      .lab{display:flex;justify-content:space-between;gap:12px;text-transform:uppercase;letter-spacing:.04em;font-size:11px;color:var(--acc0)}
      .lab b{font-weight:500;color:var(--sub)}
      h1{margin:18px 0 10px;font:900 clamp(64px,14vw,200px)/.82 "Inter Tight","Helvetica Neue",Arial,sans-serif;letter-spacing:-.045em;text-transform:uppercase}
      header p{max-width:52ch;margin:0;color:var(--sub)}

      /* names */
      .names{display:grid;gap:28px;margin-top:28px}
      .nb{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin-top:10px}
      .nm{background:var(--paper);padding:18px 14px 14px;display:grid;align-content:space-between;gap:14px;min-height:150px}
      .nw{margin:0;font:900 clamp(34px,3.6vw,48px)/.9 "Inter Tight","Helvetica Neue",Arial,sans-serif;letter-spacing:-.05em;display:flex;align-items:baseline;flex-wrap:wrap}
      .nw i{display:inline-block;width:.2em;height:.2em;background:var(--acc0);margin-left:.06em}
      .pxn{font:400 .9em/1 "Geist Pixel","Geist Mono",monospace;letter-spacing:0}
      .nd{margin:0;color:var(--sub);font-size:12px}
      header.h2{margin-top:56px;border-top:1px solid var(--line)}
      /* the board: 1px gaps on the line colour read as the grid */
      .board{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,400px),1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin-top:28px}
      .card{background:var(--paper);display:grid;grid-template-rows:auto 1fr auto}
      .card h2{margin:0;padding:12px 14px 0;display:flex;gap:10px;align-items:baseline;font:500 11px/1.2 "Geist Mono",monospace;text-transform:uppercase;letter-spacing:.04em}
      .card h2 .n{font:400 15px/1 "Geist Pixel","Geist Mono",monospace;color:var(--acc0)}
      .card .d{margin:6px 14px 0;color:var(--sub);font-size:12px;min-height:3em}
      .stage{display:grid;place-items:center;min-height:220px;padding:28px 18px;font-size:clamp(40px,5.2vw,64px);
        background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:24px 24px;background-position:center}
      .row{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}
      .tile{display:grid;grid-template-rows:1fr auto;place-items:center;aspect-ratio:1;min-height:0;border-left:1px solid var(--line);padding:8px 4px 6px}
      .tile:first-child{border-left:0}
      .tile small{font-size:9.5px;letter-spacing:.04em;text-transform:uppercase;color:var(--sub)}
      .tile .sw{display:grid;place-items:center;width:64%;aspect-ratio:1;font-size:clamp(22px,2.6vw,32px);overflow:hidden}
      .tile .fav{display:grid;place-items:center;overflow:hidden}
      .tile .f32{width:32px;height:32px;font-size:21px}
      .tile .f16{width:16px;height:16px;font-size:10.5px}

      /* colour contexts. currentColor = main, --acc = accent, --acc-fg = type on an accent shape */
      .on-g{color:var(--ink);--acc:var(--acc0);--acc-fg:var(--paper)}
      .on-a{background:var(--acc0);color:var(--paper);--acc:var(--ink);--acc-fg:var(--acc0)}
      .on-i{background:var(--ink);color:var(--paper);--acc:var(--acc0);--acc-fg:var(--ink)}
      .fav.on-g{outline:1px dashed var(--line);outline-offset:3px}

      /* ── the marks ── */
      .mk{display:inline-flex;align-items:center;gap:.28em;line-height:1;white-space:nowrap}
      .wm{font:900 1em/.9 "Inter Tight","Helvetica Neue",Arial,sans-serif;letter-spacing:-.055em;display:inline-flex;align-items:baseline}
      .wm.sm{font-size:.62em;letter-spacing:-.045em}
      .wm .stop,.app .stop{display:inline-block;width:.2em;height:.2em;background:var(--acc);margin-left:.06em}
      .wm b{color:var(--acc);font-weight:inherit}
      .stk{font:900 1em/.8 "Inter Tight","Helvetica Neue",Arial,sans-serif;letter-spacing:-.04em;text-transform:uppercase;display:block;padding:.08em 0}
      .stk::first-line{color:inherit}
      .mk-stack .stk{border-left:.12em solid var(--acc);padding-left:.12em}
      .bm{display:block;fill:currentColor;shape-rendering:crispEdges;width:auto;overflow:visible}
      .bm .ac{fill:var(--acc)}
      .bm.px7{height:.78em}
      .bm.px9{height:.95em}
      .compact .bm.px7{height:.7em}
      .pxt{font:400 .5em/1 "Geist Pixel","Geist Mono",monospace;letter-spacing:.02em}
      .mod{display:block;height:.95em;width:.95em;fill:currentColor}
      .mod .ac{fill:var(--acc)}
      .vf{position:relative;display:inline-flex;padding:.22em .3em}
      .vf i{position:absolute;width:.3em;height:.3em;border:0 solid var(--acc)}
      .vf i:nth-child(1){left:0;top:0;border-width:.06em 0 0 .06em}
      .vf i:nth-child(2){right:0;top:0;border-width:.06em .06em 0 0}
      .vf i:nth-child(3){left:0;bottom:0;border-width:0 0 .06em .06em}
      .vf i:nth-child(4){right:0;bottom:0;border-width:0 .06em .06em 0}
      .compact .vf{padding:.12em .2em}
      .compact .vf .wm.sm{font-size:.8em}
      .hd{position:relative;font:700 1.15em/1 "Caveat","Bradley Hand",cursive;color:var(--acc);letter-spacing:0}
      .hd .arw{position:absolute;left:96%;top:-.35em;width:.9em;height:.6em;overflow:visible}
      .hd .arw path{fill:none;stroke:var(--acc);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}
      .compact .hd{font-size:1.4em}
      .stkr{font:700 1em/1 "Caveat","Bradley Hand",cursive;background:var(--acc);color:var(--acc-fg);padding:.04em .24em .12em;transform:rotate(-7deg);display:inline-block}
      .compact .stkr{font-size:1.2em;padding:0 .2em .08em}
      .app{display:inline-flex;align-items:baseline;justify-content:center;width:1.15em;height:1.15em;padding-top:.08em;background:var(--acc);color:var(--acc-fg);border-radius:.22em;font:900 .9em/1 "Inter Tight",sans-serif;letter-spacing:-.05em}
      .app .stop{background:var(--acc-fg)}
      .compact .app{width:1.3em;height:1.3em;font-size:.85em;line-height:1.3;padding-top:0;align-items:center}
      .compact .app .stop{align-self:flex-end;margin-bottom:.32em}
      .f16 .app,.f32 .app{font-size:1em}
      /* round 2 */
      .spr{height:.78em;margin-left:.08em}
      .compact .spr{height:1em;margin:0}
      .stat{display:inline-flex;align-items:flex-end;gap:.3em}
      .fig{height:1.6em}
      .compact .fig{height:1em}
      .sw2{display:grid;gap:.12em;padding-bottom:.05em}
      .sw2 small{font:700 .42em/1 "Caveat",cursive;color:var(--acc)}
      .scr{display:inline-grid;gap:.18em;padding:.22em .32em;border:.035em solid currentColor;border-radius:.14em;font-size:.9em}
      .compact .scr{padding:.12em;border-width:.06em;gap:0}
      .hud{display:flex;justify-content:space-between;gap:.8em;font:500 .2em/1 "Geist Mono",monospace;letter-spacing:.04em;opacity:.8}
      .hud .dot,.compact .hud .dot{display:inline-block;width:.8em;height:.8em;border-radius:50%;background:var(--acc);vertical-align:-.05em}
      .compact .hud{font-size:.3em;justify-content:flex-start}
      .fb{position:relative;display:inline-flex;justify-content:center;padding:.1em .3em}
      .fb i{position:absolute;width:.22em;height:.22em;border:0 solid var(--acc)}
      .fb i:nth-child(1){left:0;top:0;border-width:.045em 0 0 .045em}.fb i:nth-child(2){right:0;top:0;border-width:.045em .045em 0 0}
      .fb i:nth-child(3){left:0;bottom:0;border-width:0 0 .045em .045em}.fb i:nth-child(4){right:0;bottom:0;border-width:0 .045em .045em 0}
      .compact .fb .wm.sm{font-size:.5em}
      .pk{height:1em;width:auto;overflow:visible}
      .pk text{font:900 92px "Inter Tight",sans-serif;fill:currentColor;fill-opacity:.16;stroke:var(--acc);stroke-width:3.2;stroke-dasharray:1.5 5;stroke-linecap:square}
      .cs{position:relative;display:inline-block}
      .strip{display:flex;gap:.08em;padding:.16em .1em;border-radius:.03em;background-image:radial-gradient(circle,var(--paper-ctx,var(--paper)) .045em,transparent .05em),radial-gradient(circle,var(--paper-ctx,var(--paper)) .045em,transparent .05em);
        background-color:currentColor;background-size:.2em .2em;background-repeat:repeat-x;background-position:0 .03em,0 calc(100% - .03em)}
      .fr{display:grid;place-items:center;min-width:.7em;height:.9em;padding:0 .12em;background:var(--paper-ctx,var(--paper));color:currentColor}
      .fr span{font:900 .5em/1 "Inter Tight",sans-serif;letter-spacing:-.04em;color:var(--ink)}
      .on-a{--paper-ctx:var(--acc0)}.on-i{--paper-ctx:var(--ink)}
      .on-a .fr span{color:var(--paper)}.on-i .fr span{color:var(--paper)}
      .ring{position:absolute;left:0;top:0;width:0;height:0;overflow:visible;pointer-events:none}
      .ring path{fill:none;stroke:var(--acc);stroke-width:3;stroke-linecap:round;vector-effect:non-scaling-stroke}
      .cs .ring{left:var(--rx,50%);top:-.04em;width:var(--rw,1.6em);height:1.3em}
      .id-contact:not(.compact) .cs{--rx:calc(50% - .1em);--rw:1.7em}
      .compact .cs{--rx:-.12em;--rw:1.1em}
      .compact .cs .ring{height:1.15em;top:-.04em}
      .pass{position:relative;display:inline-grid;justify-items:start;gap:.1em;padding:.5em .4em .3em;background:var(--paper-ctx,var(--paper));border:.03em solid currentColor;border-radius:.1em;transform:rotate(-4deg);min-width:3.4em}
      .compact .pass{min-width:0;padding:.42em .2em .18em;transform:rotate(-6deg)}
      .pass .slot{position:absolute;top:.14em;left:50%;width:.7em;height:.1em;margin-left:-.35em;border-radius:.06em;border:.03em solid currentColor}
      .compact .pass .slot{width:.5em;margin-left:-.25em;top:.12em}
      .pass .band{align-self:stretch;justify-self:stretch;background:var(--acc);color:var(--acc-fg);font:500 .2em/1 "Geist Mono",monospace;letter-spacing:.12em;padding:.4em .5em;min-height:.8em}
      .compact .pass .band{padding:0;height:.14em;min-height:0}
      .pass .who{font:900 .62em/.85 "Inter Tight",sans-serif;letter-spacing:-.04em}
      .compact .pass .who{font-size:.5em}
      .pass .role{font:500 .17em/1 "Geist Mono",monospace;letter-spacing:.08em;opacity:.7}
      .slate{display:inline-grid;width:3.6em}
      .compact .slate{width:1em}
      .clap{height:.36em;background:repeating-linear-gradient(-45deg,currentColor 0 .2em,var(--acc) .2em .4em);transform:rotate(-8deg);transform-origin:0 100%;margin-bottom:.04em}
      .compact .clap{height:.3em;background:repeating-linear-gradient(-45deg,currentColor 0 .14em,var(--acc) .14em .28em)}
      .slate .body{display:grid;grid-template-columns:auto 1fr;gap:.25em .4em;padding:.3em .3em;border:.03em solid currentColor;font:500 .17em/1 "Geist Mono",monospace;letter-spacing:.06em}
      .slate .body b{font:900 1.9em/1 "Inter Tight",sans-serif;letter-spacing:-.03em}
      .slate .body.s{height:.62em;padding:0;border-width:.07em}
      .roll{position:relative;display:inline-block}
      .roll .sl{position:absolute;left:0;top:0}
      .roll .base{visibility:hidden}
      .roll .sl.ac{color:var(--acc)}
      .bst .echo{text-shadow:-.09em 0 0 color-mix(in srgb,var(--acc) 75%,transparent),-.18em 0 0 color-mix(in srgb,var(--acc) 45%,transparent),-.27em 0 0 color-mix(in srgb,var(--acc) 20%,transparent)}
      .compact.id-burst .wm{text-shadow:-.09em 0 0 color-mix(in srgb,var(--acc) 70%,transparent),-.18em 0 0 color-mix(in srgb,var(--acc) 35%,transparent)}
      .brk{display:grid;gap:.06em}
      .brk .ev{display:grid;grid-template-columns:1.1em auto;align-items:center}
      .brk small{font:500 .2em/1 "Geist Mono",monospace;opacity:.7}
      .brk .e0 .wm{opacity:.3}.brk .e2 .wm{color:var(--acc)}
      .brk3{display:grid;grid-template-columns:repeat(3,.3em);gap:.05em}
      .brk3 i{height:.9em;background:currentColor}.brk3 i:nth-child(1){opacity:.3}.brk3 i:nth-child(3){background:var(--acc)}
      .ap{display:inline-flex;align-items:baseline;gap:.04em}
      .apx{height:.6em;width:.6em;overflow:visible;transform:translateY(.03em)}
      .compact .apx{height:1em;width:1em}
      .apx circle{fill:none;stroke:currentColor;stroke-width:7}
      .apx polygon{fill:var(--acc)}
      .apx path{stroke:currentColor;stroke-width:5;stroke-linecap:round}
      /* oscar shoots */
      .board.long .stage{font-size:clamp(30px,3.8vw,52px)}
      .wm .lt{font-weight:500;letter-spacing:-.04em;margin-left:.06em}
      .bm.px16{height:1.5em}
      .lo{display:inline-flex;align-items:baseline;gap:.03em}
      .lo .bm.pxx{height:.56em;align-self:baseline;transform:translateY(.02em)}
      .compact .lo .bm.pxx{height:.95em}
      .rec{display:inline-flex;align-items:center;gap:.3em}
      .rec .dot{display:inline-block;width:.34em;height:.34em;border-radius:50%;background:var(--acc)}
      .rec .recw{font:900 .8em/1 "Inter Tight",sans-serif;letter-spacing:-.05em}
      .compact .rec .dot{width:.7em;height:.7em}
      .compact .rec .recw{display:none}
      .app.wide{width:auto;padding:.08em .14em 0 .12em}
      .compact .app.wide{width:auto;padding:0 .16em;font-size:.62em;height:1.6em;border-radius:.3em}
    </style>
  </head>
  <body style={vars}>
    <div class="wrap">
      <header>
        <p class="lab mono"><span>LG — Oscar Shoots</span><b>{ideas.length} ideas · {S.label}</b></p>
        <h1>Oscar Shoots</h1>
        <p>Round 2: ideas from the double meanings and from the kit. Each one shows the full lockup, then the compact mark on the accent, inverted, and at favicon sizes. The first round, the name ideas and the oscarama marks are further down.</p>
      </header>
      <main class="board long">
        {ideas.map((c, i) => (
          <section class="card" aria-label={c.t}>
            <div>
              <h2><span class="n">{pad(i + 1)}</span><span>{c.t}</span></h2>
              <p class="d">{c.d}</p>
            </div>
            <div class="stage on-g"><IdeaMark id={c.id} /></div>
            <div class="row">
              <div class="tile"><span class="sw on-a"><IdeaMark id={c.id} mark /></span><small>accent</small></div>
              <div class="tile"><span class="sw on-i"><IdeaMark id={c.id} mark /></span><small>inverse</small></div>
              <div class="tile"><span class="fav f32 on-g"><IdeaMark id={c.id} mark /></span><small>32px</small></div>
              <div class="tile"><span class="fav f16 on-g"><IdeaMark id={c.id} mark /></span><small>16px</small></div>
            </div>
          </section>
        ))}
      </main>
      <header class="h2">
        <p class="lab mono"><span>First round — Oscar Shoots</span><b>{shoots.length} marks</b></p>
        <h1>Round 1</h1>
        <p>The straighter type treatments.</p>
      </header>
      <main class="board long">
        {shoots.map((c, i) => (
          <section class="card" aria-label={c.t}>
            <div>
              <h2><span class="n">{pad(i + 1)}</span><span>{c.t}</span></h2>
              <p class="d">{c.d}</p>
            </div>
            <div class="stage on-g"><ShootsMark id={c.id} /></div>
            <div class="row">
              <div class="tile"><span class="sw on-a"><ShootsMark id={c.id} mark /></span><small>accent</small></div>
              <div class="tile"><span class="sw on-i"><ShootsMark id={c.id} mark /></span><small>inverse</small></div>
              <div class="tile"><span class="fav f32 on-g"><ShootsMark id={c.id} mark /></span><small>32px</small></div>
              <div class="tile"><span class="fav f16 on-g"><ShootsMark id={c.id} mark /></span><small>16px</small></div>
            </div>
          </section>
        ))}
      </main>
      <header class="h2">
        <p class="lab mono"><span>Earlier — Names</span><b>{names.reduce((n, g) => n + g.items.length, 0)} names · {concepts.length} marks · {S.label}</b></p>
        <h1>Names</h1>
        <p>The first round of name ideas, set the way the wordmark would be. None of the domains or handles were checked.</p>
      </header>
      <section class="names" aria-label="name ideas">
        {names.map((g) => (
          <div class="ng">
            <p class="lab mono"><span>{g.group}</span><b>{g.items.length}</b></p>
            <div class="nb">
              {g.items.map((it) => (
                <article class="nm">
                  <p class="nw">{it.px ? <span class="pxn">{it.n.toLowerCase()}</span> : it.n.toLowerCase()}<i /></p>
                  <p class="nd">{it.d}</p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </section>
      <header class="h2">
        <p class="lab mono"><span>Earlier — oscarama marks</span><b>{concepts.length} marks</b></p>
        <h1>Logos</h1>
        <p>Rough marks, drawn for oscarama but they work with most of the names above. Each one shows the full lockup, then the compact mark on the accent, inverted, and at favicon sizes.</p>
      </header>
      <main class="board">
        {concepts.map((c, i) => (
          <section class="card" aria-label={c.t}>
            <div>
              <h2><span class="n">{pad(i + 1)}</span><span>{c.t}</span></h2>
              <p class="d">{c.d}</p>
            </div>
            <div class="stage on-g"><Mark id={c.id} /></div>
            <div class="row">
              <div class="tile"><span class="sw on-a"><Mark id={c.id} mark /></span><small>accent</small></div>
              <div class="tile"><span class="sw on-i"><Mark id={c.id} mark /></span><small>inverse</small></div>
              <div class="tile"><span class="fav f32 on-g"><Mark id={c.id} mark /></span><small>32px</small></div>
              <div class="tile"><span class="fav f16 on-g"><Mark id={c.id} mark /></span><small>16px</small></div>
            </div>
          </section>
        ))}
      </main>
    </div>
    <Switcher />
  </body>
</html>
