---
// Social banners + avatars for the "burst, in pixels" Oscar Shoots logo. Each page is exactly the platform's
// pixel size; design/social/*.png are screenshots of these (see design/social/README.md).
// Content stays inside each platform's safe area: X and LinkedIn put the profile photo over the bottom-left,
// and YouTube crops its 2560×1440 art down to 1546×423 in the middle on most screens.
import { burstWord, burstO } from "@/components/photos/logos/marks";
import { dissolve } from "@/components/photos/fable/r3/bits";
import openai from "@/assets/logos/openai.png";
import vercel from "@/assets/logos/vercel.png";
import corgi from "@/assets/logos/corgi.png";

type Spec = { w: number; h: number; safe: [number, number, number, number]; align: "center" | "end"; kind: "banner" | "avatar"; bg?: "dark" | "accent"; dz?: number };
const specs: Record<string, Spec> = {
  x: { w: 1500, h: 500, safe: [380, 60, 1060, 380], align: "end", kind: "banner" },
  linkedin: { w: 1584, h: 396, safe: [560, 40, 984, 316], align: "end", kind: "banner" },
  // LinkedIn company page cover (personal profiles use the 1584×396 one above); the logo sits over the bottom-left
  "linkedin-page": { w: 1128, h: 191, safe: [300, 16, 800, 159], align: "end", kind: "banner", dz: 2 },
  youtube: { w: 2560, h: 1440, safe: [507, 508, 1546, 423], align: "center", kind: "banner" },
  "avatar-dark": { w: 800, h: 800, safe: [0, 0, 800, 800], align: "center", kind: "avatar", bg: "dark" },
  "avatar-orange": { w: 800, h: 800, safe: [0, 0, 800, 800], align: "center", kind: "avatar", bg: "accent" },
};
// banner variants, from busiest to calmest:
// a: wordmark / tagline + London / divider / "shot for" + logos with names
// b: no divider, tagline and London on one line
// c: like b, logos without names or label
// d: two tiers: wordmark, then one line with "photo + video · London" on the left and the logos on the right
type Variant = "a" | "b" | "c" | "d";
export function getStaticPaths() {
  const banners = ["x", "linkedin", "linkedin-page", "youtube"], variants = ["a", "b", "c", "d"];
  return [...banners.flatMap((b) => variants.map((v) => `${b}-${v}`)), "avatar-dark", "avatar-orange"].map((id) => ({ params: { id } }));
}
const { id: full } = Astro.params as { id: string };
const vm = full.match(/^(x|linkedin-page|linkedin|youtube)-([a-d])$/);
const id = vm ? vm[1] : full, v = (vm ? vm[2] : "a") as Variant;
const s = specs[id];
const ACC = "#FF3B1F", INK = "#111111", PAPER = "#F3F1EA";
const accentBg = s.bg === "accent";
const ground = accentBg ? ACC : INK, fg = accentBg ? INK : PAPER, echo = accentBg ? PAPER : ACC;
const [sx, sy, sw, sh] = s.safe;
// "shot for" row: each logo is used as a mask so they all come out in one colour; ar = width / height
const worked = [
  { name: "SpaceXAI", src: "/photos/opus/spacexai-mark.svg", ar: 512 / 240 },
  { name: "OpenAI", src: openai.src, ar: 485 / 480 },
  { name: "Vercel", src: vercel.src, ar: 2310 / 2000 },
  { name: "Corgi", src: corgi.src, ar: 628 / 667 },
];

// the grid module: banners get 10 rows of module across their height (YouTube: across the safe strip)
const m = s.kind === "avatar" ? s.w / 8 : id === "youtube" ? sh / 6 : s.h / 8;
// wordmark: fit the safe width (banners) or ~62% of the avatar
const dzH = s.kind === "avatar" ? 0 : (s.dz ?? 3) * (m / 2);
const bottom = Math.min(sy + sh, s.h - dzH - m / 2);
const b = s.kind === "avatar" ? burstO : burstWord;
const cell = s.kind === "avatar" ? Math.floor((s.w * 0.5) / b.w) : Math.floor(Math.min((sw * 0.92) / b.w, (bottom - sy) / (b.h + ({ a: 15, b: 12, c: 12, d: 8 } as const)[v])));
const ww = cell * b.w, wh = cell * b.h;
// bottom dissolve, the F2 footer, in module-sized cells
const dzCols = Math.ceil(s.w / (m / 2)), dzRows = s.kind === "avatar" ? 0 : s.dz ?? 3;
const dz = dzRows ? dissolve(id.length * 7 + 3, dzCols, dzRows) : [];
const dzPath = dz.map((row, y) => [...row].map((c, x) => (c === "#" ? `M${x} ${y}h1v1h-1z` : "")).join("")).join("");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{full}</title>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@500&display=block" rel="stylesheet" />
    <style is:inline>
      html,body{margin:0;padding:0}
      body{overflow:hidden}
      .c{position:relative;overflow:hidden}
      .grid{position:absolute;inset:0}
      .safe{position:absolute;display:flex;flex-direction:column;justify-content:center;gap:0}
      .safe>*{flex-shrink:0}
      .tag{font:500 var(--ts)/1.2 "Geist Mono",ui-monospace,monospace;letter-spacing:.06em;text-transform:uppercase;display:flex;gap:1.4em;white-space:nowrap}
      .tag b{font-weight:500}
      svg{display:block}
      .shot{display:flex;align-items:center;white-space:nowrap;font:500 var(--ts)/1 "Geist Mono",ui-monospace,monospace;letter-spacing:.06em;text-transform:uppercase}
      .shot .lbl{opacity:.5}
      .shot .co{display:flex;align-items:center;gap:.6em}
      .shot i{display:block;height:var(--lh);background:currentColor;-webkit-mask:var(--u) center/contain no-repeat;mask:var(--u) center/contain no-repeat}
      astro-dev-toolbar{display:none !important}
    </style>
  </head>
  <body>
    <div class="c" style={`width:${s.w}px;height:${s.h}px;background:${ground};color:${fg}`}>
      <svg class="grid" width={s.w} height={s.h} aria-hidden="true">
        <defs><pattern id="g" width={m} height={m} patternUnits="userSpaceOnUse" x={s.kind === "avatar" ? 0 : sx + sw - Math.floor(sw / m) * m} y={0}><path d={`M${m} 0V${m}H0`} fill="none" stroke={accentBg ? INK : ACC} stroke-opacity={accentBg ? 0.14 : 0.2} stroke-width="1" /></pattern></defs>
        <rect width={s.w} height={s.h} fill="url(#g)" />
      </svg>
      {dzRows > 0 && (
        <svg style={`position:absolute;left:0;bottom:0`} width={dzCols * (m / 2)} height={dzRows * (m / 2)} viewBox={`0 0 ${dzCols} ${dzRows}`} shape-rendering="crispEdges" aria-hidden="true"><path d={dzPath} fill={ACC} /></svg>
      )}
      <div class="safe" style={`left:${sx}px;top:${sy}px;width:${sw}px;height:${bottom - sy}px;align-items:${s.align === "end" ? "flex-end" : "center"}`}>
        <svg width={ww} height={wh} viewBox={`0 0 ${b.w} ${b.h}`} shape-rendering="crispEdges" aria-label="Oscar Shoots">
          {b.echoes.map((e) => <path d={e.d} fill={echo} fill-opacity={e.o} />)}
          <path d={b.ink} fill={fg} />
        </svg>
        {s.kind === "banner" && v === "a" && (
          <p class="tag" style={`--ts:${Math.round(cell * 1.9)}px;margin:${Math.round(cell * 3.2)}px 0 0;width:${ww}px;justify-content:space-between`}>
            <span>Photo + video for startups &amp; tech</span><b style={`color:${ACC}`}>London</b>
          </p>
        )}
        {s.kind === "banner" && (v === "b" || v === "c") && (
          <p class="tag" style={`--ts:${Math.round(cell * 1.9)}px;margin:${Math.round(cell * 3.2)}px 0 0;width:${ww}px;justify-content:space-between`}>
            <span>Photo + video for startups &amp; tech <span style={`color:${ACC}`}>·</span> <b style={`color:${ACC}`}>London</b></span>
          </p>
        )}
        {s.kind === "banner" && v === "a" && (
          <div class="shot" style={`--ts:${Math.round(cell * 1.5)}px;--lh:${Math.round(cell * 2.4)}px;margin-top:${Math.round(cell * 2.6)}px;width:${ww}px;gap:${Math.round(cell * 1.6)}px;justify-content:space-between;padding-top:${Math.round(cell * 2.6)}px;border-top:1px solid ${ACC}55`}>
            <span class="lbl">Shot for</span>
            {worked.map((c) => <span class="co"><i style={`--u:url(${c.src});width:${Math.round(cell * 2.4 * c.ar)}px`} /><span>{c.name}</span></span>)}
          </div>
        )}
        {s.kind === "banner" && v === "b" && (
          <div class="shot" style={`--ts:${Math.round(cell * 1.5)}px;--lh:${Math.round(cell * 2.4)}px;margin-top:${Math.round(cell * 3.6)}px;width:${ww}px;gap:${Math.round(cell * 1.6)}px;justify-content:space-between`}>
            <span class="lbl">Shot for</span>
            {worked.map((c) => <span class="co"><i style={`--u:url(${c.src});width:${Math.round(cell * 2.4 * c.ar)}px`} /><span>{c.name}</span></span>)}
          </div>
        )}
        {s.kind === "banner" && v === "c" && (
          <div class="shot" style={`--lh:${Math.round(cell * 2.6)}px;margin-top:${Math.round(cell * 3.6)}px;width:${ww}px;gap:${Math.round(cell * 4)}px;justify-content:flex-start;opacity:.85`}>
            {worked.map((c) => <i style={`--u:url(${c.src});width:${Math.round(cell * 2.6 * c.ar)}px`} />)}
          </div>
        )}
        {s.kind === "banner" && v === "d" && (
          <div class="shot" style={`--ts:${Math.round(cell * 1.9)}px;--lh:${Math.round(cell * 2.4)}px;margin-top:${Math.round(cell * 3.4)}px;width:${ww}px;justify-content:space-between`}>
            <span class="tag" style="gap:.6em"><span>Photo + video</span><span style={`color:${ACC}`}>·</span><b style={`color:${ACC}`}>London</b></span>
            <span style={`display:flex;align-items:center;gap:${Math.round(cell * 2.8)}px;opacity:.85`}>{worked.map((c) => <i style={`--u:url(${c.src});width:${Math.round(cell * 2.4 * c.ar)}px`} />)}</span>
          </div>
        )}
      </div>
    </div>
  </body>
</html>
