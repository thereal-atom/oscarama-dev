    <Viewer bg={S.ink} fg={S.paper} accent={GH} onAccent={S.ink} mono='"Geist Mono", ui-monospace, monospace' display='"Geist", sans-serif' />
    <Switcher />

    <script define:vars={{ email: contact.email }}>window.__mail = email;</script>
    <script>
      import { wireBook, fitText } from "@/components/photos/fable/r3/book";
      import { mosaic, type RGB } from "@/components/photos/fable/r3/pixel";
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const tones = JSON.parse(document.documentElement.dataset.tones ?? "[]") as RGB[]; // ink, accent, milk from the scheme
      const wide = matchMedia("(min-width:900px)");
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const dims = (el: HTMLElement) => ((wide.matches ? el.dataset.d : el.dataset.m) ?? "1,1").split(",").map(Number);
      const ready = (im: HTMLImageElement) => im.complete && im.naturalWidth > 0;

      // ── every select: its box at one-cell resolution, and the frame itself resolving in hard steps ──
      const items = [...document.querySelectorAll<HTMLElement>(".it")];
      function paint(it: HTMLElement) {
        const im = it.querySelector("img")!; if (!ready(im)) return;
        const [bw, bh, pw, ph] = dims(it);
        mosaic(it.querySelector<HTMLCanvasElement>(".halo")!, im, bw, bh, tones);
        if (!it.classList.contains("on") && !it.dataset.go) mosaic(it.querySelector<HTMLCanvasElement>(".res")!, im, pw, ph, tones);
        it.dataset.rdy = "1";
        if (it.dataset.vis) resolve(it);
      }
      function resolve(it: HTMLElement) {
        if (it.dataset.go || !it.dataset.rdy) return; it.dataset.go = "1";
        if (still) { it.classList.add("on"); return; }
        const im = it.querySelector("img")!, cv = it.querySelector<HTMLCanvasElement>(".res")!, [, , pw, ph] = dims(it);
        const steps: Array<[number, boolean]> = [[2, true], [4, false], [8, false]];
        let i = 0;
        const next = () => {
          if (i >= steps.length) { it.classList.add("on"); return; }
          const [k, flat] = steps[i++]; mosaic(cv, im, pw * k, ph * k, flat ? tones : null); setTimeout(next, 110);
        };
        setTimeout(next, 140 + Math.random() * 160);
      }
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { const it = e.target as HTMLElement; it.dataset.vis = "1"; resolve(it); io.unobserve(it); } }), { threshold: 0.35 });
      items.forEach((it) => {
        const im = it.querySelector("img")!;
        if (ready(im)) paint(it); else im.addEventListener("load", () => paint(it), { once: true });
        im.addEventListener("error", () => it.classList.add("on"), { once: true });
        io.observe(it);
      });

      // ── flat mosaics that aren't selects: the hero frame and the closing strip ──
      const band = $("band"), bandImg = band.querySelector("img")!;
      const flats: Array<[HTMLElement, HTMLImageElement]> = [[band, bandImg]];
      document.querySelectorAll<HTMLElement>(".strip[data-src]").forEach((el) => { const im = new Image(); im.crossOrigin = "anonymous"; im.src = el.dataset.src!; flats.push([el, im]); });
      const flat = (el: HTMLElement, im: HTMLImageElement) => { if (!ready(im)) return; const [c, r] = dims(el); mosaic(el.querySelector("canvas")!, im, c, r, tones); };
      flats.forEach(([el, im]) => { if (ready(im)) flat(el, im); else im.addEventListener("load", () => flat(el, im), { once: true }); });

      // ── hero window: follows the mouse one cell at a time; steps along by itself otherwise ──
      const num = (v: string) => parseFloat(getComputedStyle(band).getPropertyValue(v)) || 0;
      let hovering = false, dir = 1, seen = false;
      const place = (x: number, y: number) => {
        const cols = num("--n"), rows = num("--br"), ww = num("--ww"), wh = num("--wh");
        band.style.setProperty("--wx", String(Math.max(0, Math.min(cols - ww, x))));
        band.style.setProperty("--wy", String(Math.max(0, Math.min(rows - wh, y))));
      };
      band.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return; hovering = true;
        const r = band.getBoundingClientRect(), c = r.width / num("--n");
        place(Math.round((e.clientX - r.left) / c - num("--ww") / 2), Math.round((e.clientY - r.top) / c - num("--wh") / 2));
      });
      band.addEventListener("pointerleave", () => { hovering = false; });
      new IntersectionObserver(([e]) => { seen = e.isIntersecting; }, { threshold: 0.4 }).observe(band);
      if (!still) setInterval(() => {
        if (!seen || hovering || document.hidden) return;
        const x = num("--wx"), max = num("--n") - num("--ww");
        if (x + dir > max || x + dir < 0) dir = -dir;
        place(x + dir, num("--wy"));
      }, 1100);

      wide.addEventListener("change", () => {
        band.style.removeProperty("--wx"); band.style.removeProperty("--wy");
        items.forEach(paint); flats.forEach(([el, im]) => flat(el, im));
      });

      new IntersectionObserver(([e]) => $("cta").classList.toggle("on", !e.isIntersecting && e.boundingClientRect.top < 0)).observe(band);
      fitText($("mail"));
      wireBook({
        form: $<HTMLFormElement>("form"), email: (window as any).__mail,
        cal: { grid: $("cal-grid"), title: $("cal-title"), prev: $<HTMLButtonElement>("cal-prev"), next: $<HTMLButtonElement>("cal-next") },
        nodate: $<HTMLInputElement>("nodate"), sent: $("sent"), picked: $("cal-picked"),
      });
    </script>
  </body>
</html>
