  <div class="flex flex-col mt-8">
    <p class="text-sm text-white/70">
      in 2026 I'm on a mission to meet as many new people as possible.
    </p>
    <p class="text-sm text-white/70 mt-4">
      whether you're building something cool, exploring a wild idea, or just want to talk about
      rockets and climbing walls - I'm always down for a good conversation.
    </p>
    <a class="text-sm text-[#E56717] mt-4 underline" href="/chat">book a time &rarr;</a>
    <p class="text-sm text-white/70 mt-4">
      this is a convenient way to do it, but I'd honestly rather you just DM me :)<br />{" "}
      <a
        href="https://x.com/oscarfalll"
        target="_blank"
        class="text-[#E56717] hover:underline"
        onclick="window.posthog?.capture('social_link_clicked', { platform: 'X' })">Twitter</a
      >{" "}
      /{" "}
      <a
        href="https://linkedin.com/in/oscarfalemara"
        target="_blank"
        class="text-[#E56717] hover:underline"
        onclick="window.posthog?.capture('social_link_clicked', { platform: 'LinkedIn' })"
        >LinkedIn</a
      > - DMs are open.
    </p>
  </div> -->
</PageLayout>
