---
// A one-sheet poster for an event series. Pure CSS art, one look per series.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  slug: string;
  name: string;
  logo: ImageMetadata;
  tagline: string;
  billing: string[];
  screen: number;
  href?: string;
  large?: boolean;
}
const { slug, name, logo, tagline, billing, screen, href, large = false } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class:list={["poster", `poster--${slug}`, large && "poster--large"]} href={href}>
  <span class="poster__art" aria-hidden="true">
    <i class="pa pa--1"></i>
    <i class="pa pa--2"></i>
    <i class="pa pa--3"></i>
    <i class="pa pa--4"></i>
  </span>
  <span class="poster__top">
    <span>oscarama pictures presents</span>
    <span>screen {screen}</span>
  </span>
  <span class="poster__mid">
    <Image src={logo} alt="" width={96} height={96} class="poster__logo" />
    <span class="poster__title">{name}</span>
    <span class="poster__tag">{tagline}</span>
  </span>
  <span class="poster__bottom">
    <span class="poster__billing">
      {billing.map((b, i) => <span class={i % 2 ? "pb-s" : "pb-b"}>{b}</span>)}
    </span>
    {href && <span class="poster__cta">showtimes →</span>}
  </span>
</Tag>
