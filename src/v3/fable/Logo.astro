---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  size?: number;
  /** tile colour behind the logo ("none" for no tile) */
  tile?: "none" | "dark" | "light";
  class?: string;
}

const { src, size = 20, tile = "none", class: cls } = Astro.props;
const url =
  typeof src === "string"
    ? src
    : (await getImage({ src, width: size * 3, height: size * 3, fit: "contain", format: "webp" }))
        .src;
---

<img
  class:list={["logo", `logo-${tile}`, cls]}
  src={url}
  width={size}
  height={size}
  alt=""
  loading="lazy"
  decoding="async"
  draggable="false"
/>
