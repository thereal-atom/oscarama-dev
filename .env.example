# Existing forms and email delivery.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Sanity identifiers are public and may be included in the browser bundle.
PUBLIC_SANITY_PROJECT_ID=your_project_id
PUBLIC_SANITY_DATASET=production

# Sanity Studio reads variables with the SANITY_STUDIO_ prefix.
SANITY_STUDIO_PROJECT_ID=your_project_id
SANITY_STUDIO_DATASET=production

# Only needed when the dataset is private. Never prefix this token with PUBLIC_.
# SANITY_API_READ_TOKEN=

# Mux credentials are entered in Sanity Studio and stored in Sanity's protected secrets document.
