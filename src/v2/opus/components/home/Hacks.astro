---
import BoardingPass from "../BoardingPass.astro";
import { hacks, logos } from "../../data/content";

const stamps: Record<string, string> = {
  won: "won ★",
  pitched: "pitched to 100+",
  tobogganed: "tobogganed",
};
const tilts = [-1.4, 0.9, -0.6];
---

<section class="hacks on-dark" id="hacks" data-alt="10000" data-theme="dark" data-zone="cruising">
  <svg class="hacks__trail" viewBox="0 0 1440 600" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-40 520 C 300 420, 700 380, 1480 90"></path>
    <path d="M-40 532 C 300 432, 700 392, 1480 102"></path>
  </svg>

  <div class="wrap">
    <header class="sec-head label" data-reveal>
      <span class="no">§04</span><span>cruising altitude</span><span class="rule"></span><span
        >fl 360 · seatbelts off</span
      >
    </header>

    <div class="hacks__intro">
      <h2 class="hacks__h display" data-reveal>
        hackathons,<br /><span class="serif">or: how i keep getting</span><br />flown places
      </h2>
      <p class="hacks__lede dim" data-reveal style="--d:120">
        some people collect stamps in their passport. i collect lanyards. three hacks, two flights,
        one toboggan.
      </p>
    </div>

    <div class="hacks__stack">
      {
        hacks.map((h, i) => (
          <BoardingPass
            flight={h.flight}
            from={h.from}
            fromName={h.fromName}
            to={h.to}
            toName={h.toName}
            event={h.event}
            eventHref={"eventHref" in h ? h.eventHref : undefined}
            project={h.project}
            projectHref={"projectHref" in h ? h.projectHref : undefined}
            logo={"logo" in h ? logos[h.logo] : undefined}
            stamp={stamps[h.status]}
            seat={h.seat}
            body={h.body}
            tilt={tilts[i]}
            index={i}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .hacks {
    position: relative;
    padding: clamp(40px, 6vw, 90px) 0 clamp(64px, 8vw, 120px);
    background: linear-gradient(to bottom, var(--sky-1) 0%, var(--sky-2) 100%);
    overflow: hidden;
    isolation: isolate;
  }
  .hacks__trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .hacks__trail path {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-opacity: 0.08;
    vector-effect: non-scaling-stroke;
  }
  .hacks__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px;
    align-items: end;
    margin: 28px 0 clamp(40px, 5vw, 72px);
  }
  .hacks__h {
    font-size: clamp(54px, 8.4vw, 132px);
  }
  .hacks__h .serif {
    display: inline-block;
    margin: 0.06em 0 0.1em;
    text-transform: none;
    font-size: 0.62em;
    color: #ffb48f;
    letter-spacing: -0.01em;
  }
  .hacks__lede {
    max-width: 40ch;
    padding-bottom: 10px;
    color: #b9c4dc;
  }
  .hacks__stack {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3.4vw, 44px);
    max-width: 1060px;
    margin-inline: auto;
  }
  @media (min-width: 1100px) {
    .hacks__stack > :global(:nth-child(2)) {
      margin-left: 56px;
      margin-right: -56px;
    }
  }

  @media (max-width: 760px) {
    .hacks__intro {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
