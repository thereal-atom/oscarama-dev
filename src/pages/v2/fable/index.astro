---
import { getImage } from "astro:assets";
import Layout from "@/v2/fable/Layout.astro";
import Hud from "@/v2/fable/Hud.astro";
import Stars from "@/v2/fable/Stars.astro";
import Chip from "@/v2/fable/Chip.astro";
import { series as eventSeriesList } from "@/v2/fable/series";

import coloopLogo from "@/assets/logos/coloop.png";
import outpostLogo from "@/assets/logos/outpost.png";
import fanksLogo from "@/assets/logos/fanks.png";
import expLogo from "@/assets/logos/exp.png";
import helioLogo from "@/assets/logos/helio.png";
import omisphereLogo from "@/assets/logos/omisphere.png";
import archieLogo from "@/assets/logos/archie.png";
import basedHackLogo from "@/assets/logos/basedhack.png";
import basedLogo from "@/assets/logos/based.png";
import umLogo from "@/assets/logos/um.png";
import ycLogo from "@/assets/logos/yc.png";
import capturedAboveLogo from "@/assets/logos/capturedabove.png";
import vercelLogo from "@/assets/logos/vercel.png";
import openaiLogo from "@/assets/logos/openai.png";
import corgiLogo from "@/assets/logos/corgi.png";
import coderabbitLogo from "@/assets/logos/coderabbit.png";
import brightdataLogo from "@/assets/logos/brightdata.png";
import mubitLogo from "@/assets/logos/mubit.png";
import spacexaiLogo from "@/assets/logos/spacexai.svg?url";
import daytonaLogo from "@/assets/logos/daytona.svg?url";

import typescriptIcon from "@/assets/techs/typescript.svg";
import bunIcon from "@/assets/techs/bun.svg";
import nextjsIcon from "@/assets/techs/nextjs.svg";
import svelteIcon from "@/assets/techs/svelte.svg";
import rustIcon from "@/assets/techs/rust.svg";
import tailwindIcon from "@/assets/techs/tailwindcss.svg";
import pythonIcon from "@/assets/techs/python.svg";
import awsIcon from "@/assets/techs/aws.svg";

const stack = [
  { name: "typescript", icon: typescriptIcon },
  { name: "bun", icon: bunIcon },
  { name: "sveltekit", icon: svelteIcon },
  { name: "next.js", icon: nextjsIcon },
  { name: "rust", icon: rustIcon },
  { name: "python", icon: pythonIcon },
  { name: "tailwind", icon: tailwindIcon },
  { name: "aws", icon: awsIcon },
];

const projects = [
  "docdepot",
  "alertbots",
  "openai.js",
  "papr",
  "notes ai",
  "a solana arb bot",
  "project liquid",
  "saasalytics",
];

const gear = [
  "running",
  "hiking",
  "camping",
  "mountaineering",
  "bouldering",
  "rock climbing",
  "skiing",
  "photography",
  "videography",
  "flying drones",
];

const small = async (src: ImageMetadata, w = 160) =>
  (await getImage({ src, width: w, height: w })).src;

const series = await Promise.all(
  eventSeriesList.map(async (s) => ({ ...s, img: await small(s.logo) }))
);
const outpostImg = await small(outpostLogo, 320);
const stageLogos = {
  fanks: await small(fanksLogo, 96),
  exp: await small(expLogo, 96),
  helio: await small(helioLogo, 96),
};

// ── generated scenery (deterministic, so builds are stable) ──
let seed = 31;
const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

const ridge = (base: number, amp: number, step: number, phase: number) => {
  let d = `M0 600 L0 ${base}`;
  for (let x = 0; x <= 1440; x += step) {
    const y =
      base -
      amp *
        (0.55 * Math.sin(x * 0.0043 + phase) +
          0.3 * Math.sin(x * 0.011 + phase * 2.3) +
          0.5 * Math.abs(Math.sin(x * 0.0021 + phase * 0.7))) -
      rnd() * amp * 0.22;
    d += ` L${x} ${y.toFixed(1)}`;
  }
  return d + " L1440 600 Z";
};
const ridges = [
  { d: ridge(250, 150, 48, 0.4), fill: "#a8324f", k: 0.16 },
  { d: ridge(330, 120, 40, 2.1), fill: "#de5a36", k: 0.11 },
  { d: ridge(415, 95, 34, 4.0), fill: "#f2a676", k: 0.06 },
  { d: ridge(505, 70, 30, 5.6), fill: "#ece5d5", k: 0 },
];

const blocks = (n: number, minH: number, maxH: number) => {
  const out: { x: number; w: number; h: number }[] = [];
  let x = -10;
  while (x < 1450 && out.length < n) {
    const w = 18 + rnd() * 44;
    out.push({ x, w, h: minH + rnd() * (maxH - minH) });
    x += w + rnd() * 6 - 2;
  }
  return out;
};
const cityBack = blocks(60, 34, 92);
const cityFront = blocks(60, 12, 50);

// topo map: a few gaussian hills, contoured with marching squares
const hills = Array.from({ length: 9 }, () => ({
  x: rnd() * 1440,
  y: rnd() * 810,
  r: 150 + rnd() * 260,
  h: 0.5 + rnd() * 0.9,
}));
const elev = (x: number, y: number) =>
  hills.reduce((a, c) => a + c.h * Math.exp(-((x - c.x) ** 2 + (y - c.y) ** 2) / (c.r * c.r)), 0);
const GX = 96;
const GY = 54;
const cell = 15;
const grid = Array.from({ length: GY + 1 }, (_, j) =>
  Array.from({ length: GX + 1 }, (_, i) => elev(i * cell, j * cell))
);
let topo = "";
for (let lv = 0.16; lv < 2.2; lv += 0.115) {
  for (let j = 0; j < GY; j++) {
    for (let i = 0; i < GX; i++) {
      const a = grid[j][i],
        b = grid[j][i + 1],
        c = grid[j + 1][i + 1],
        d = grid[j + 1][i];
      const pts: string[] = [];
      const cut = (v1: number, v2: number, x1: number, y1: number, x2: number, y2: number) => {
        if (v1 > lv !== v2 > lv) {
          const t = (lv - v1) / (v2 - v1);
          pts.push(
            `${((x1 + (x2 - x1) * t) * cell).toFixed(1)} ${((y1 + (y2 - y1) * t) * cell).toFixed(1)}`
          );
        }
      };
      cut(a, b, i, j, i + 1, j);
      cut(b, c, i + 1, j, i + 1, j + 1);
      cut(d, c, i, j + 1, i + 1, j + 1);
      cut(a, d, i, j, i, j + 1);
      if (pts.length >= 2) topo += `M${pts[0]}L${pts[1]}`;
      if (pts.length === 4) topo += `M${pts[2]}L${pts[3]}`;
    }
  }
}
const karman = "100 km · kármán line · you are now, officially, in space · ";
---

<Layout>
  <noscript slot="head">
    <style>
      .fable .ascent,
      .fable .wrap,
      .fable .log__list,
      .fable .stages,
      .fable .orbit__txt {
        flex-direction: column !important;
      }
    </style>
  </noscript>

  <Hud />
  <Stars />

  <nav class="rail" aria-label="altitude">
    <div class="rail__line"></div>
    <div class="rail__dot"></div>
  </nav>

  <!--
    this page is stacked bottom → top. the DOM runs in logical order
    (pad first), flex-direction: column-reverse does the rest.
  -->
  <main class="ascent" id="content">
    <!-- 00 · pad -->
    <section class="sec pad light" id="pad" data-alt="0" data-phase="on the pad" data-label="pad">
      <svg
        class="pad__topo"
        viewBox="0 0 1440 810"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <path
          d={topo}
          fill="none"
          stroke="#15130e"
          stroke-width="1"
          stroke-linecap="round"
          vector-effect="non-scaling-stroke"></path>
      </svg>

      <div class="pad__in">
        <p class="pad__eyebrow mono">
          <span>flight plan of-001</span>
          <span>london, earth</span>
          <span><i class="blink"></i>go for launch</span>
        </p>
        <h1 aria-label="oscar falemara">
          <span aria-hidden="true"
            >{
              "oscar".split("").map((ch, i) => (
                <span class="ch" style={`--n:${i}`}>
                  {ch}
                </span>
              ))
            }</span
          >
          <span class="l2" aria-hidden="true"
            >{
              "falemara".split("").map((ch, i) => (
                <span class="ch" style={`--n:${i + 5}`}>
                  {ch}
                </span>
              ))
            }</span
          >
        </h1>
        <div class="pad__row">
          <p class="lede">
            self-taught software engineer. community organiser.
            <span class="serif">future rocket company person.</span>
          </p>
          <div class="pad__cta">
            <p class="pad__hint serif">this site goes up. scroll&nbsp;↑ or hit the button.</p>
            <button class="btn btn--solid" type="button" data-launch>
              <span data-launch-label>launch</span>
              <span aria-hidden="true">↑</span>
            </button>
          </div>
        </div>
      </div>

      <div class="pad__city" aria-hidden="true">
        <svg viewBox="0 0 1440 200" preserveAspectRatio="xMidYMax slice">
          <g fill="#15130e" opacity="0.28">
            {cityBack.map((b) => <rect x={b.x} y={190 - b.h} width={b.w} height={b.h} />)}
          </g>
          <g fill="#15130e">
            {cityFront.map((b) => <rect x={b.x} y={190 - b.h} width={b.w} height={b.h} />)}
            <!-- elizabeth tower -->
            <path d="M176 190V84h3l1-10h2l5-26 5 26h2l1 10h3v106z"></path>
            <circle cx="187" cy="98" r="6" fill="#ece5d5"></circle>
            <!-- the eye -->
            <g fill="none" stroke="#15130e">
              <circle cx="330" cy="118" r="62" stroke-width="3.5"></circle>
              <circle cx="330" cy="118" r="52" stroke-width="1"></circle>
              {
                Array.from({ length: 16 }, (_, i) => {
                  const a = (i / 16) * Math.PI * 2;
                  return (
                    <line
                      x1="330"
                      y1="118"
                      x2={(330 + Math.cos(a) * 62).toFixed(1)}
                      y2={(118 + Math.sin(a) * 62).toFixed(1)}
                      stroke-width="0.8"
                    />
                  );
                })
              }
              <path d="M330 118 L300 190 M330 118 L360 190" stroke-width="3.5"></path>
            </g>
            <!-- gherkin -->
            <path d="M556 190C544 140 552 78 574 60c22 18 30 80 18 130z"></path>
            <!-- shard -->
            <path d="M872 190 898 14h5l26 176z"></path>
            <!-- tower bridge -->
            <path
              d="M1150 190V112l9-26 9 26v78zM1232 190V112l9-26 9 26v78zM1168 120h64v5h-64zM1070 158h260v7h-260z"
            ></path>
            <path
              d="M1150 116Q1105 150 1070 158M1250 116Q1295 150 1330 158"
              fill="none"
              stroke="#15130e"
              stroke-width="2"></path>
            <rect x="-10" y="188" width="1460" height="14"></rect>
          </g>
        </svg>
        <div class="pad__rocket">
          <svg viewBox="0 0 40 150" width="100%" height="100%">
            <g class="flame">
              <path d="M11 129Q20 190 29 129z" fill="#ff4d00"></path>
              <path d="M15 129Q20 162 25 129z" fill="#ffd08a"></path>
            </g>
            <path d="M10 98 0 128h10zM30 98l10 30H30z" fill="#ff4d00"></path>
            <path d="M20 2c8 16 10 34 10 56v62H10V58C10 36 12 18 20 2z" fill="#15130e"></path>
            <path d="M10 76h20v7H10z" fill="#ff4d00"></path>
            <circle cx="20" cy="50" r="5" fill="#ece5d5"></circle>
            <path d="M13 120h14l3 10H10z" fill="#15130e"></path>
          </svg>
        </div>
      </div>
    </section>

    <!-- 01 · ground crew -->
    <section
      class="sec light"
      id="crew"
      data-alt="0"
      data-phase="pre-flight checks"
      data-label="now"
    >
      <div class="wrap">
        <p class="marker"><b>▲ 0 m</b> <span>pre-flight</span> <i>who's flying this thing</i></p>
        <div class="head rv">
          <h2 class="big">
            hi, i'm oscar. <span class="serif">i build things</span> & gather people.
          </h2>
        </div>
        <div class="crew__grid">
          <div class="crew__card rv">
            <span class="mono">day job</span>
            <p>
              i'm a self-taught software engineer from london, currently at
              <Chip href="https://coloop.ai" src={coloopLogo} text="coloop ai" /> (yc s21). i also do
              events, growth engineering and lots of other fun stuff there.
            </p>
          </div>
          <div class="crew__card rv" style="--i:1">
            <span class="mono">the other full-time job</span>
            <p>
              i run
              <Chip href="https://luma.com/londonmaxxing-ai" src={outpostLogo} text="outpost" />, a
              community for those building at the frontier. hackathons, dinners, run clubs, demo
              nights and much more. <a class="ul" href="#orbit" data-jump>more ↑</a>
            </p>
          </div>
        </div>
        <ul class="stats rv">
          <li><b>30+</b><span class="mono">events hosted</span></li>
          <li><b>2,000+</b><span class="mono">people through the door</span></li>
          <li><b>5k+</b><span class="mono">outpost members</span></li>
          <li><b>0</b><span class="mono">university degrees</span></li>
        </ul>
      </div>
    </section>

    <!-- 02 · flight log -->
    <section class="sec light log" id="log" data-alt="150" data-phase="liftoff" data-label="log">
      <div class="wrap">
        <p class="marker"><b>▲ 150 m</b> <span>liftoff</span> <i>read upwards</i></p>
        <div class="head rv">
          <h2 class="big">the flight log, <span class="serif">so far.</span></h2>
        </div>
        <ol class="log__list">
          <li class="log__item rv">
            <span class="log__age" aria-hidden="true">14</span>
            <div class="log__txt">
              <span class="mono">age 14 · ignition</span>
              <p>
                started writing code. got my first freelance client less than 5 months later, still
                14.
              </p>
            </div>
          </li>
          <li class="log__item rv">
            <span class="log__age" aria-hidden="true">16</span>
            <div class="log__txt">
              <span class="mono">age 16 · first aircraft</span>
              <p>
                started a drone videography business with a friend,
                <Chip
                  href="https://capturedabove.vercel.app"
                  src={capturedAboveLogo}
                  text="captured above"
                />, as an economic excuse to buy a drone.
              </p>
            </div>
          </li>
          <li class="log__item rv">
            <span class="log__age" aria-hidden="true">18</span>
            <div class="log__txt">
              <span class="mono">age 18 · skipped a stage</span>
              <p>
                joined a
                <Chip
                  href="https://www.ycombinator.com/companies/coloop"
                  src={ycLogo}
                  text="yc startup"
                /> as a full-time software engineer before i'd finished high school. never did get round
                to uni.
              </p>
            </div>
          </li>
          <li class="log__item rv">
            <span class="log__age" aria-hidden="true">19</span>
            <div class="log__txt">
              <span class="mono">age 19 · new optics</span>
              <p>
                bought a camera. had my first photo and video clients within 2 months of starting.
              </p>
            </div>
          </li>
          <li class="log__item log__item--now rv">
            <span class="log__age" aria-hidden="true">now</span>
            <div class="log__txt">
              <span class="mono">present · nominal</span>
              <p>
                shipping at coloop, running outpost, and reading far too much about rocket engines.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- 03 · highlights -->
    <section
      class="sec light"
      id="highlights"
      data-alt="1500"
      data-phase="climbing"
      data-label="cool stuff"
    >
      <div class="wrap">
        <p class="marker"><b>▲ 1,500 m</b> <span>climbing</span> <i>cool stuff i've done</i></p>
        <div class="head rv">
          <h2 class="big">payload: <span class="serif">the highlights.</span></h2>
        </div>
        <div class="hl__grid">
          <article class="card card--z2a rv">
            <div class="card__top">
              <span class="mono">sat 2 may 2026 · london · my first ever hackathon</span>
              <h3>zero to agent: london</h3>
              <p>
                i ran the london stop of
                <Chip href="https://vercel.com" src={vercelLogo} text="vercel" />'s zero to agent
                for 100 of london's most talented builders. organised the whole thing by myself.
              </p>
            </div>
            <div class="card__top">
              <ul class="z2a__nums">
                <li><b>~100</b><span class="mono">builders</span></li>
                <li><b>3</b><span class="mono">tracks</span></li>
                <li><b>£5.8k</b><span class="mono">cash prizes</span></li>
                <li><b>$1m+</b><span class="mono">in credits</span></li>
              </ul>
              <p>
                sponsored by
                <Chip href="https://coderabbit.ai" src={coderabbitLogo} text="coderabbit" />,
                <Chip href="https://brightdata.com" src={brightdataLogo} text="bright data" /> and
                <Chip href="https://mubit.ai" src={mubitLogo} text="mubit" />.
                <a class="ul" href="/events/zero-to-agent">read the recap →</a>
              </p>
            </div>
          </article>
          <article class="card card--kcl rv" style="--i:1">
            <div class="card__top">
              <span class="mono">sat 31 oct 2026 · king's college london</span>
              <h3>spoke at kcl tech summit</h3>
            </div>
            <p>
              on the
              <a
                class="ul"
                href="https://techsummit.kcltech.co.uk/"
                target="_blank"
                rel="noopener noreferrer">kcl tech summit 2026</a
              > panel “how to break into london's tech scene”, about community building as a full-time
              software engineer who's never been to uni.
            </p>
          </article>
          <article class="card card--ev rv" style="--i:2">
            <div class="card__top">
              <span class="mono">ongoing</span>
              <h3>30+ events, 2,000+ humans</h3>
            </div>
            <div class="card__top">
              <p>hosted and helped organise them, working with companies like</p>
              <p class="logos">
                <Chip href="https://luma.com/codex-ldn-1" src={openaiLogo} text="openai" />
                <Chip href="/events/zero-to-agent" src={vercelLogo} text="vercel" internal />
                <Chip href="https://x.ai" src={spacexaiLogo} text="spacexai" />
                <Chip href="https://www.daytona.io" src={daytonaLogo} text="daytona" />
                <Chip href="https://corgi.insure" src={corgiLogo} text="corgi" />
                <span class="dim">and more!</span>
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- 04 · treeline -->
    <section
      class="sec peaks"
      id="peaks"
      data-alt="4000"
      data-phase="above the treeline"
      data-label="off the clock"
    >
      <div class="peaks__sun" aria-hidden="true"></div>
      <svg
        class="peaks__ridges"
        viewBox="0 0 1440 600"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        {ridges.map((r) => <path d={r.d} fill={r.fill} data-k={r.k} />)}
      </svg>
      <div class="peaks__in">
        <div class="wrap">
          <div class="head rv">
            <h2 class="big">off the clock, <span class="serif">i go outside.</span></h2>
            <p class="lede">
              mountains, mostly. if it involves going uphill slowly or downhill quickly, i'm
              probably into it. there's usually a camera in the bag.
            </p>
          </div>
          <ul class="gear rv">
            {gear.map((g) => <li>{g}</li>)}
          </ul>
          <p class="mono rv">
            <span class="o">▲ 8,849 m</span> &nbsp;everest tops out about here. included for scale, not
            as a brag.
          </p>
        </div>
      </div>
    </section>

    <!-- 05 · cruising altitude -->
    <section
      class="sec dark cruise"
      id="hacks"
      data-alt="10000"
      data-phase="cruising altitude"
      data-label="hacks"
    >
      <div class="wrap">
        <p class="marker"><b>▲ 10 km</b> <span>cruising altitude</span> <i>hackathons</i></p>
        <div class="head rv">
          <h2 class="big">people keep <span class="serif">flying me</span> to hackathons.</h2>
        </div>
        <ul class="passes">
          <li class="pass rv">
            <div class="pass__top">
              <span class="mono">boarding pass · hack 001</span>
              <div class="pass__route">
                <span>0</span>
                <svg viewBox="0 0 60 12" preserveAspectRatio="none" aria-hidden="true"
                  ><path
                    d="M0 6h56M50 1l6 5-6 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"></path></svg
                >
                <span>1st</span>
              </div>
              <p>
                won my first ever hackathon with
                <Chip
                  href="https://github.com/omisphere/omisphere"
                  src={omisphereLogo}
                  text="omisphere"
                />, a project that aims to turn every conversation into part of a collective
                consciousness.
              </p>
            </div>
            <div class="pass__stub">
              <dl>
                <div><dt>class</dt><dd>first timer</dd></div>
                <div><dt>result</dt><dd>won it</dd></div>
              </dl>
              <span class="pass__code" aria-hidden="true"></span>
            </div>
          </li>
          <li class="pass rv" style="--i:1">
            <div class="pass__top">
              <span class="mono">boarding pass · hack 002</span>
              <div class="pass__route">
                <span>ldn</span>
                <svg viewBox="0 0 60 12" preserveAspectRatio="none" aria-hidden="true"
                  ><path
                    d="M0 6h56M50 1l6 5-6 5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"></path></svg
                >
                <span>lt 🇱🇹</span>
              </div>
              <p>
                we got flown out to lithuania for
                <Chip href="https://www.basedhack.com/" src={basedHackLogo} text="based hack" />,
                where we built <Chip href="https://archie.to" src={archieLogo} text="archie." /> and were
                one of the teams chosen to pitch to 100+ people in the room.
              </p>
            </div>
            <div class="pass__stub">
              <dl>
                <div><dt>fare</dt><dd>flown out</dd></div>
                <div><dt>result</dt><dd>pitched</dd></div>
              </dl>
              <span class="pass__code" aria-hidden="true"></span>
            </div>
          </li>
          <li class="pass rv" style="--i:2">
            <div class="pass__top">
              <span class="mono">boarding pass · hack 003</span>
              <div class="pass__route">
                <span>ldn</span>
                <svg viewBox="0 0 60 12" preserveAspectRatio="none" aria-hidden="true"
                  ><path
                    d="M0 6h56M50 1l6 5-6 5"
                    fill="none"
                    stroke="currentColor"
