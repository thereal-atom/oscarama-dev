                  <figure class="it" data-m={`${m.bw},${m.bh},${m.pw},${m.ph}`} data-d={`${d.bw},${d.bh},${d.pw},${d.ph}`}
                    style={`--am:${area(m, m.bw, m.bh)};--mx:${m.x};--my:${m.y};--mw:${m.pw};--mh:${m.ph};--ad:${area(d, d.bw, d.bh)};--dx:${d.x};--dy:${d.y};--dw:${d.pw};--dh:${d.ph}`}>
