          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          <p class="c lab mono" style="--am:1/1/span 1/span 6;--ad:1/1/span 1/span 16"><span>{sec.direct} — Or skip the form</span><b>Based in {contact.basedIn}</b></p>
          <a class="mailw" href={`mailto:${contact.email}`} style="--am:2/1/span 1/span 6;--ad:2/1/span 2/span 16"><span class="mail" id="mail">{contact.email}</span></a>
          <a class="c big" href={ig} target="_blank" rel="noopener" style="--am:3/1/span 1/span 6;--ad:4/1/span 2/span 8"><span>Instagram ↗</span><small>@{contact.instagram}</small></a>
          <a class="c big" href={tw} target="_blank" rel="noopener" style="--am:4/1/span 1/span 6;--ad:4/9/span 2/span 8"><span>X ↗</span><small>@{contact.x}</small></a>
          <p class="c lab mono" style="--am:5/1/span 2/span 6;--ad:6/1/span 1/span 16;align-items:flex-start"><span>Oscar — event photo + video</span><a href="#top">back to top ↑</a></p>
        </footer>
      </div>
    </div>
    <a class="cta mono" id="cta" href="#contact">Contact →</a>

    <Viewer bg={S.ink} fg={S.paper} accent={S.paper} onAccent={S.accent} bookHref="#contact" bookLabel="contact me about a shoot like this →" mono='"Geist Mono", ui-monospace, monospace' display='"Inter Tight", sans-serif' />
    <Switcher />

    <script define:vars={{ email: contact.email }}>window.__mail = email;</script>
    <script>
      import { fitText } from "@/components/photos/fable/r3/book";
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const gs = [...document.querySelectorAll<HTMLElement>(".g")];

      // ── snap: text blocks grow in whole rows ──
      const rowH = () => parseFloat(getComputedStyle(gs[0]).gridAutoRows) || 60;
      function snap() {
        const r = rowH();
        document.querySelectorAll<HTMLElement>("[data-snap]").forEach((el) => {
          const inn = el.querySelector<HTMLElement>(".in"); if (!inn) return;
          const cs = getComputedStyle(el), own = inn.parentElement === el ? parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) : 0;
          inn.style.alignSelf = "flex-start"; const h = inn.offsetHeight + own; inn.style.alignSelf = "";
          el.style.setProperty("--rs", String(Math.max(1, Math.ceil((h - 1) / r))));
        });
        // row numbers down the margin
        const rr = $("rr"), n = Math.round($("body").offsetHeight / r);
        if (rr.childElementCount !== n) rr.innerHTML = Array.from({ length: n }, (_, i) => `<span>${String(i + 1).padStart(3, "0")}</span>`).join("");
      }
      fitText($("mail"));
      snap(); addEventListener("resize", snap); addEventListener("load", snap); (document as any).fonts?.ready.then(snap);

      // ── the grid draws itself, once per section ──
      const draw = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); draw.unobserve(e.target); } }), { rootMargin: "0px 0px -18% 0px" });
      gs.forEach((g) => draw.observe(g));

      // ── sticky ruler re-divides to the current section's columns ──
      const ticks = [...$("rl").querySelectorAll<HTMLElement>("i")], letter = $("rl-s");
      let curG: HTMLElement | null = null;
      function ruler() {
        let g = gs[0];
        for (const x of gs) { if (x.getBoundingClientRect().top <= 60) g = x; }
        if (g === curG) return; curG = g;
        const n = parseInt(getComputedStyle(g).getPropertyValue("--cols")) || 6;
        const wide = g.offsetWidth / gs[0].offsetWidth; // the 7 + 9 pair shares the ruler
        const total = wide < 0.9 ? 16 : n;
        ticks.forEach((t, i) => t.classList.toggle("off", i >= total));
        letter.textContent = g.dataset.sec ?? "";
      }
      let tick = false;
      addEventListener("scroll", () => { if (!tick) { tick = true; requestAnimationFrame(() => { tick = false; ruler(); }); } }, { passive: true });
      addEventListener("resize", () => { curG = null; ruler(); }); ruler();

      new IntersectionObserver(([e]) => $("cta").classList.toggle("on", !e.isIntersecting && e.boundingClientRect.top < 0)).observe($("top"));

      // ── contact: name / email / message → a pre-written email ──
      const form = $<HTMLFormElement>("form"), sent = $("sent"), to: string = (window as any).__mail;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const f = new FormData(form), name = String(f.get("name") ?? "").trim(), email = String(f.get("email") ?? "").trim(), note = String(f.get("note") ?? "").trim();
        if (!/^\S+@\S+\.\S+$/.test(email)) { (form.elements.namedItem("email") as HTMLInputElement).focus(); sent.textContent = "Pop your email in so I can reply."; return; }
        const body = ["Hi Oscar,", "", note || "I'd like to talk about a shoot.", "", name || "—", email].join("\n");
        const url = `mailto:${to}?subject=${encodeURIComponent(`Shoot enquiry${name ? ` — ${name}` : ""}`)}&body=${encodeURIComponent(body)}`;
        sent.innerHTML = `Opening your email app… nothing happened? Write to <a href="${url}">${to}</a>`;
        location.href = url;
      });

      // ── hero: the last word cycles through a pixel wipe on the quarter-module ──
      const rot = $("rot"), word = rot.querySelector<HTMLElement>(".w")!, cv = rot.querySelector("canvas")!, cx = cv.getContext("2d")!;
      const words: string[] = JSON.parse(rot.dataset.words ?? "[]");
      function fitWord() {
        word.style.fontSize = "";
        const avail = rot.clientWidth - parseFloat(getComputedStyle(rot).paddingLeft), w = word.offsetWidth;
        if (w > avail) word.style.fontSize = (parseFloat(getComputedStyle(rot).fontSize) * avail / w) * 0.985 + "px";
      }
      fitWord(); addEventListener("resize", fitWord); (document as any).fonts?.ready.then(fitWord);
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      let wi = 0, visible = true, busy = false;
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(rot);
      const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [a[i], a[j]] = [a[j], a[i]]; } return a; };
      function wipe() {
        if (busy || !visible || document.hidden) return; busy = true;
        const dpr = devicePixelRatio || 1, W = rot.clientWidth, H = rot.clientHeight;
        cv.width = W * dpr; cv.height = H * dpr; cv.style.width = W + "px"; cv.style.height = H + "px"; cx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const cs = rowH() / 4, oldW = word.offsetWidth + 4;
        const next = words[(wi + 1) % words.length];
        word.textContent = next; fitWord(); const newW = word.offsetWidth + 4; word.textContent = words[wi]; fitWord();
        const cols = Math.ceil(Math.min(W, Math.max(oldW, newW)) / cs), rows = Math.ceil(H / cs);
        const cells = shuffle(Array.from({ length: cols * rows }, (_, k) => k));
        cx.fillStyle = getComputedStyle(rot).color;
        const D = 320; let t0 = 0, swapped = false;
        const step = (t: number) => {
          if (!t0) t0 = t; const p = (t - t0) / D;
          cx.clearRect(0, 0, W, H);
          // phase 1 (0→1): pixels switch on over the old word · phase 2 (1→2): they switch off over the new one
          const on = p < 1 ? Math.floor(cells.length * p) : Math.floor(cells.length * Math.max(0, 2 - p));
          if (p >= 1 && !swapped) { swapped = true; wi = (wi + 1) % words.length; word.textContent = words[wi]; fitWord(); shuffle(cells); }
          for (let k = 0; k < on; k++) { const c = cells[k]; cx.fillRect((c % cols) * cs, Math.floor(c / cols) * cs, cs, cs); }
          if (p < 2) requestAnimationFrame(step); else { cx.clearRect(0, 0, W, H); busy = false; }
        };
        requestAnimationFrame(step);
      }
      if (!still && words.length > 1) setInterval(wipe, 2600);
    </script>
  </body>
</html>
