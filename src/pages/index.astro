---
import PageLayout from "@/layouts/PageLayout.astro";
import IconLink from "@/components/IconLink.astro";
// import BackgroundTexture from "../components/BackgroundTexture.astro";
// import { Image } from "astro:assets";

// Import logos
import coolopLogo from "@/assets/logos/coloop.png";
import fanksLogo from "@/assets/logos/fanks.png";
import outBoulderingLogo from "@/assets/logos/out-buildering.png";
import outpostLogo from "@/assets/logos/outpost.png";

import expLogo from "@/assets/logos/exp.png";
import helioLogo from "@/assets/logos/helio.png";
import omisphereLogo from "@/assets/logos/omisphere.png";
import archieLogo from "@/assets/logos/archie.png";
import basedHackLogo from "@/assets/logos/basedhack.png";
import ycLogo from "@/assets/logos/yc.png";
import spacexLogo from "@/assets/logos/spacex.png";
import capturedAboveLogo from "@/assets/logos/capturedabove.png";
import coloopNewLogo from "@/assets/logos/coloop-new.png";
import vercelLogo from "@/assets/logos/vercel.png";
import spacexaiLogo from "@/assets/logos/spacexai.svg?url";
import daytonaLogo from "@/assets/logos/daytona.svg?url";
import openaiLogo from "@/assets/logos/openai.png";
import corgiLogo from "@/assets/logos/corgi.png";
import basedLogo from "@/assets/logos/based.png";
import umLogo from "@/assets/logos/um.png";
import coderabbitLogo from "@/assets/logos/coderabbit.png";
import brightdataLogo from "@/assets/logos/brightdata.png";
import mubitLogo from "@/assets/logos/mubit.png";

// Import tech icons
import typescriptIcon from "@/assets/techs/typescript.svg";
import bunIcon from "@/assets/techs/bun.svg";
import nextjsIcon from "@/assets/techs/nextjs.svg";
import svelteIcon from "@/assets/techs/svelte.svg";
import rustIcon from "@/assets/techs/rust.svg";
import tailwindIcon from "@/assets/techs/tailwindcss.svg";
import pythonIcon from "@/assets/techs/python.svg";
import awsIcon from "@/assets/techs/aws.svg";

const techStack = [
  { name: "TypeScript", icon: typescriptIcon },
  { name: "Bun", icon: bunIcon },
  { name: "Next.js", icon: nextjsIcon },
  { name: "SvelteKit", icon: svelteIcon },
  { name: "Rust", icon: rustIcon },
  { name: "Tailwind", icon: tailwindIcon },
  { name: "Python", icon: pythonIcon },
  { name: "AWS", icon: awsIcon },
];
---

<PageLayout title="oscarama | software eng">
  <h1 class="text-3xl font-bold">oscar falemara</h1>
  <div class="flex flex-col mt-8">
    <p class="text-sm text-white/70">
      I'm a self-taught software engineer from 📍 London, currently working as a software engineer
      at
      <IconLink href="https://coloop.ai" src={coolopLogo.src} alt="coloop ai" text="coloop ai" />
      (yc s21). I also do events, growth engineering and lots of other fun stuff there
    </p>
    <p class="text-sm text-white/70 mt-8">
      I run
      <IconLink
        href="https://luma.com/londonmaxxing-ai"
        src={outpostLogo.src}
        alt="outpost"
        text="outpost"
      />, a community for those building at the frontier. we host hackathons, meetups, dinners,
      coworking, run clubs, cafes, demo nights, bouldering and much more.
    </p>
    <a class="text-sm text-[#E56717] mt-8 underline" href="https://luma.com/londonmaxxing-ai"
      >come to an event!</a
    >
  </div>

  <h3 class="mt-8">hacks</h3>
  <ul class="text-sm text-white/70 mt-4">
    <li>
      won my first ever hackathon with <IconLink
        href="https://github.com/omisphere/omisphere"
        src={omisphereLogo.src}
        alt="OmiSphere"
        text="OmiSphere"
      /> - a project that aims to turn every conversation into part of a collective consciousness
    </li>
    <li>
      we got flown out to Lithuania 🇱🇹 for <IconLink
        href="https://www.basedhack.com/"
        src={basedHackLogo.src}
        alt="based hack"
        text="based hack"
      /> where we built <IconLink
        href="https://archie.to"
        src={archieLogo.src}
        alt="archie"
        text="archie."
      /> and were one of the teams chosen to pitch to 100+ people in the room
    </li>
    <li>
      we are were flown out to Finland 🇫🇮 by <IconLink
        href="https://www.basedcollective.ai/"
        src={basedLogo.src}
        alt="based collective"
        text="based collective"
      /> and <IconLink
        href="https://www.unicornmafia.ai/"
        src={umLogo.src}
        alt="unicorn mafia"
        text="unicorn mafia"
      /> for <a href="https://sunsteadhack.com/" target="_blank" class="underline">sunstead hack</a
      >. we didn't win, but we vibe coded while tobogganing..
    </li>
  </ul>
  <h3 class="mt-4">past</h3>
  <ul class="text-sm text-white/70 mt-4">
    <li>
      helping build better community-brand matching @
      <IconLink href="https://fanks.co" src={fanksLogo.src} alt="fanks" text="fanks" client:load />
    </li>
    <li>
      built bot systems from the ground up @
      <IconLink href="https://discord.gg/exp" src={expLogo.src} alt="EXP" text="EXP" client:load />,
      with bank systems handling $100,000s of in game value, helping it grow from 2k to 45k+ members
    </li>
    <li>
      spent a few months freelancing @ a crypto payments startup, <IconLink
        href="https://hel.io"
        src={helioLogo.src}
        alt="helio"
        text="helio"
      />
    </li>
  </ul>

  <h2 class="text-xl mt-8 sm:mt-12 md:mt-16">fun facts about me (flexing)</h2>
  <ul class="text-sm text-white/70 mt-8">
    <li>
      I ran my first ever <a
        href="/events/zero-to-agent"
        class="underline decoration-white/30 hover:decoration-white">hackathon</a
      > with <IconLink href="https://vercel.com" src={vercelLogo.src} alt="Vercel" text="Vercel" /> for
      100 of London's most talented builders, and gave away over £5k in cash and $1m in credits - and
      organised it all by myself, sponsored by <IconLink
        href="https://coderabbit.ai"
        src={coderabbitLogo.src}
        alt="CodeRabbit"
        text="CodeRabbit"
      />, <IconLink
        href="https://brightdata.com"
        src={brightdataLogo.src}
        alt="Bright Data"
        text="Bright Data"
      /> and <IconLink href="https://mubit.ai" src={mubitLogo.src} alt="Mubit" text="Mubit" />
    </li>
    <li>
      at age 18, before I finished high school, I joined a <IconLink
        href="https://www.ycombinator.com/companies/coloop"
        src={ycLogo.src}
        alt="YC"
        text="YC startup"
      /> as a full time software engineer
    </li>
    <li>
      I've hosted & helped organise over 30 events with 2,000+ people attending, working with
      companies like
      <IconLink
        href="https://luma.com/codex-ldn-1"
        src={openaiLogo.src}
        alt="OpenAI"
        text="OpenAI"
      />, <IconLink href="/events/zero-to-agent" src={vercelLogo.src} alt="Vercel" text="Vercel" />,
      <IconLink href="https://x.ai" src={spacexaiLogo} alt="SpaceXAI" text="SpaceXAI" />,
      <IconLink href="https://www.daytona.io" src={daytonaLogo} alt="Daytona" text="Daytona" />,
      <IconLink href="https://corgi.insure" src={corgiLogo.src} alt="Corgi" text="Corgi" />, and
      more!
    </li>
    <li>
      my passion is aerospace 🚀, and I wanna start an <IconLink
        href="https://spacex.com"
        src={spacexLogo.src}
        alt="spacex"
        text="aerospace company"
      /> soon
    </li>
    <li>in my time off, I like to climb 🏔️ mountains , 🥾 hike, 🧗 boulder and rock climb</li>
    <li>
      I spent a few months freelancing @ a crypto payments startup, <IconLink
        href="https://hel.io"
        src={helioLogo.src}
        alt="helio"
        text="helio"
      /> (which later <a
        href="https://www.moonpay.com/en-gb/newsroom/helio-acquisition"
        target="_blank"
        class="underline">sold for $175m</a
      >)
    </li>
    <li>
      I love <a href="/photo-video" class="underline decoration-white/30 hover:decoration-white"
        >photography/videography</a
      >, so at age 16, I started a drone business with a friend as an economic excuse to buy a drone
      @ <IconLink
        href="https://capturedabove.vercel.app"
        src={capturedAboveLogo.src}
        alt="captured above"
        text="captured above"
      />. then I bought a camera when I was 19 and got my first clients within 2 months of starting
    </li>
    <li>
      I got my first freelance client less than 5 months after I started code, when I was still 14.
    </li>
  </ul>

  <!-- <h2 class="text-xl mt-8 sm:mt-12 md:mt-16">tech that I use</h2>
  <div class="mt-8 grid w-full grid-cols-4 border-l border-t border-white">
    {
      techStack.map((tech) => (
        <div class="group relative flex py-8 items-center justify-center overflow-hidden border-b border-r border-white transition-colors duration-300">
          <Image src={tech.icon} alt={tech.name} class="h-8 sm:w-10 w-8 sm:h-10" />
        </div>
      ))
    }
  </div> -->

