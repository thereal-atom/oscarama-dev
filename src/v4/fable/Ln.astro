---
// inline link with an optional tiny logo. external links open in a new tab.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  logo?: ImageMetadata | string;
  dark?: boolean;
}
const { href, logo, dark = false } = Astro.props;
const ext = /^https?:/.test(href);
const src = logo
  ? typeof logo === "string"
    ? logo
    : (await getImage({ src: logo, width: 48 })).src
  : null;
---

<a class="ln" href={href} {...ext ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  >{
    src && <img src={src} alt="" class:list={{ dark }} width="20" height="20" loading="lazy" />
  }<slot /></a
>
