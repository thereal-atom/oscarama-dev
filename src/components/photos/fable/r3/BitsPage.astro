              {clients.map((c) => <div><img class:list={{ sm: c.name === "SPACEXAI" }} src={c.logo.src} alt={c.name} loading="lazy" /><span class="mono">{c.name}</span></div>)}
              <a class="you" href="#book"><span class="mono">next</span><b>YOUR LOGO →</b></a>
