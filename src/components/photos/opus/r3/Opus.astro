---
/*
  OPUS R3/1 — "SHOOTS EVENTS." (the synthesis)
  Pitch: everything that landed in round 2, folded into one calm, confident
  page. A coral hero that says what he does in three words, then four quick
  links as separate black slabs — one per line, impossible to misread. Under
  it, a tall high-fidelity dither of an event that you can look into with a
  full-colour lens. Then a dense, parallax wall of selects that print in as a
  dither and settle into the real photo; a short "what I shoot" + what you
  get; real client marks instead of numbers; big bold testimonials; a
  full-screen coral booking sheet that's obviously easy; a footer that's just
  the email, huge, in pixels, with the socials underneath.
  Palette: from the scheme (src/components/photos/schemes.ts) — accent · ink ·
  paper ("coral" below = the accent). Sections switch suddenly between
  accent / ink / paper, contrast inverting each time.
  Fonts (3): Archivo (variable wdth+wght — display + body) · Geist Pixel
  Square (numbers, hover state, the email) · Geist Mono (small meta).
  Signature interactions: hero letters slowly trade into Geist Pixel one at a
  time on fixed-width cells (no layout shift) · hovering a slab inverts it and
  swaps its word to Geist Pixel · dither band with a full-quality reveal lens
  (pointer; auto-drifts on touch) · selects: masonry columns drifting at
  different speeds, each tile prints as a coral dither then fades to the
  photo · service names condense on hover (each line nowrap, so nothing
  reflows) · instant viewer (thumb at full size immediately, full-res swapped
  in) with a layered mechanical shutter + mute · one-page booking: date grid +
  tap tiles → "Send message" (mailto).
*/
import Switcher from "@/components/photos/Switcher.astro";
import { selects, logos, quotes, services, contact, socials, sized } from "@/components/photos/opus/r3/data";
import { schemes, mix, rgb, onAccent, accentOnInk, type SchemeId } from "@/components/photos/schemes";

interface Props { scheme: SchemeId }
const S = schemes[Astro.props.scheme];
// Roles. The accent grounds (hero, lens, clients, booking) keep the accent in every scheme. --on is type / rules /
// slabs on the accent (ink; paper on blue); --hi is the accent as type on ink (lifted for blue). Dark: the paper
// grounds (what-you-get, cards, form fields) drop to a dark surface (--pg) with paper type (--pt); ink stays ink.
const on = onAccent(S, "ink", 4.5), hi = accentOnInk(S);
const inkOn = on === S.ink;
const pg = S.dark ? mix(S.ink, S.paper, 0.07) : S.paper, pt = S.dark ? S.paper : S.ink;
const m = (t: number) => mix(S.ink, S.paper, t); // greys on the ink ground
const vars = {
  "--coral": S.accent, "--ink": S.ink, "--paper": S.paper, "--on": on, "--hi": hi, "--pg": pg, "--pt": pt,
  "--lift": S.dark ? mix(pg, S.paper, 0.1) : "#FFFFFF",
  "--sl-hov-bg": inkOn ? S.paper : S.ink, "--sl-hov-fg": inkOn ? S.ink : S.paper,
  "--sel-bg": S.dark ? S.paper : S.ink, "--sel-fg": S.dark ? S.ink : inkOn ? S.accent : S.paper,
  "--frame": m(0.03), "--cell": m(0.06), "--cell-hov": m(0.17), "--rule2": m(0.16), "--rule": m(0.2), "--cell-off": m(0.24),
  "--today": m(0.36), "--mute3": m(0.5), "--mute": m(0.58), "--mute2": m(0.72), "--vbg": mix(S.ink, "#000000", 0.4),
};
const style = Object.entries(vars).map(([k, v]) => `${k}:${v}`).join(";");
const dither = { lens: rgb(on), tile: rgb(hi) };

const shots = selects.slice(0, 32).map((s) => ({ ...s, mid: sized(s.src, 720) }));
const lens = selects.find((s) => s.id === "zero-to-agent-1") ?? selects[2];
const lensShot = { src: sized(lens.src, 1600), small: sized(lens.src, 1200), caption: lens.caption, event: lens.event };

const links = [
  { n: "01", t: "Work", href: "#work" },
  { n: "02", t: "What you get", href: "#get" },
  { n: "03", t: "Book a date", href: "#book" },
  { n: "04", t: "Contact", href: "#contact" },
];
const title = ["Oscar", "shoots", "events."];

// service display lines (each line is nowrap, so condensing never reflows)
const svcLines: Record<string, string[]> = {
  "event photography": ["Event", "photography"],
  "recap video": ["Recap", "video"],
  "speaker & founder portraits": ["Speaker &", "founder", "portraits"],
  "fast turnaround": ["Fast", "turnaround"],
};
const svcTone = ["paper", "coral", "ink", "paper"];
const words = ["hackathons", "demo nights", "launch parties", "founder panels"];
---

<!doctype html>
<html lang="en" style={style} data-scheme={S.id} data-dither={JSON.stringify(dither)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={S.accent} />
    <title>Oscar — Event Photo & Video</title>
    <meta name="description" content="Photos and video for tech and startup events in London — hackathons, demo nights, launches, conferences." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://picsum.photos" />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />
    <style is:inline>
      @font-face {
        font-family: "Geist Pixel";
        src: url("https://cdn.jsdelivr.net/npm/geist@1.9.2/dist/fonts/geist-pixel/GeistPixel-Square.woff2") format("woff2");
        font-display: swap;
      }
      @font-face {
        font-family: "Geist Mono";
        src: url("https://cdn.jsdelivr.net/npm/geist@1.9.2/dist/fonts/geist-mono/GeistMono-Variable.woff2") format("woff2");
        font-weight: 100 900;
        font-display: swap;
      }
    </style>
  </head>
  <body>
    <script type="application/json" id="shots" set:html={JSON.stringify(shots)} />
    <a class="skip" href="#work">Skip to work</a>

    <!-- ───────────── HERO ───────────── -->
    <header class="hero" id="top">
      <div class="bar">
        <a href="#top" class="me mono"><b>Oscar</b> <span>event photo + video · London</span></a>
        <nav class="soc" aria-label="socials">
          {
            socials.map((s) => (
              <a href={s.href} target={s.label === "Email" ? undefined : "_blank"} rel="noopener">
                {s.label}
                <i aria-hidden="true">↗</i>
              </a>
            ))
          }
        </nav>
      </div>

      <h1 class="title" id="title" aria-label="Oscar shoots events.">
        {
          title.map((w) => (
            <span class="w" aria-hidden="true">
              {[...w].map((c) => (
                <span class="ch">{c}</span>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="lede">Photos + video for tech &amp; startup events — hackathons, demo nights, launches, conferences. London, and wherever you need me.</p>

      <nav class="slabs" id="slabs" aria-label="quick links">
        {
          links.map((l) => (
            <a class="slab" href={l.href}>
              <span class="sn px">{l.n}</span>
              <span class="st">{l.t}</span>
              <span class="sa" aria-hidden="true">
                {l.href === "#work" ? "↓" : "→"}
              </span>
            </a>
          ))
        }
      </nav>
    </header>

    <!-- ───────────── DITHER LENS ───────────── -->
    <section class="lens" id="lens" aria-label={`${lensShot.caption}, ${lensShot.event}`} data-src={lensShot.src} data-small={lensShot.small}>
      <canvas id="lcan" aria-hidden="true"></canvas>
      <img id="limg" alt="" crossorigin="anonymous" />
      <div class="lring" id="lring" aria-hidden="true"></div>
      <p class="lcap mono"><span>{lensShot.caption} — {lensShot.event}</span><span class="lhint">move to look closer</span></p>
    </section>

    <main>
      <!-- ───────────── SELECTS ───────────── -->
      <section class="work" id="work" aria-labelledby="work-h">
        <div class="shead">
          <h2 id="work-h" class="big">Selects</h2>
          <p class="mono">A few favourites from hackathons, launches, panels &amp; demo nights.<br />Tap any photo to open it.</p>
        </div>
        <div class="cols" id="cols">
          {
            shots.map((s, i) => {
              const v = [0, 1, 0, 2, 0, 3, 1, 0, 2][i % 9];
              return (
                <button class={`tile v${v}`} data-i={i} style={`--ar:${s.w}/${s.h}`} aria-label={`Open: ${s.caption}, ${s.event}`}>
                  <span class="fr">
                    <canvas aria-hidden="true" />
                    <img data-src={s.mid} alt={s.caption} width={s.w} height={s.h} crossorigin="anonymous" decoding="async" />
                  </span>
                  <span class="cap mono">
                    <b>{s.caption}</b> {s.event}
                  </span>
                </button>
              );
            })
          }
        </div>
      </section>

      <!-- ───────────── WHAT I SHOOT + WHAT YOU GET ───────────── -->
      <section class="get" id="get" aria-labelledby="get-h">
        <p class="kicker mono">What I shoot</p>
        <p class="bio">
          I’ve shot <span class="sw" tabindex="0">{words[0]}</span> at 3am, <span class="sw" tabindex="0">{words[1]}</span> where the wifi held, <span
            class="sw"
            tabindex="0">{words[2]}</span
          >, <span class="sw" tabindex="0">{words[3]}</span> and a kayak offsite on the River Wye. I work like part of your team — quiet in the room, quick after it.
        </p>
        <h2 id="get-h" class="kicker mono">What you get</h2>
        <div class="svc">
          {
            services.map((s, i) => (
              <article class={`box ${svcTone[i]}`} tabindex="0">
                <span class="bn px">{String(i + 1).padStart(2, "0")}</span>
                <h3>
                  {(svcLines[s.name] ?? [s.name]).map((l) => (
                    <span class="ln">{l}</span>
                  ))}
                </h3>
                <p class="mono">{s.detail}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- ───────────── CLIENTS ───────────── -->
      <section class="clients" aria-labelledby="cl-h">
        <h2 id="cl-h" class="mono">Trusted at events for</h2>
        <ul>
          {
            logos.map((l) => (
              <li>
                <span class="mark" style={`--m:url(${l.mask});--r:${l.ratio}`} role="img" aria-label={l.name} />
                <span class="nm">{l.name}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- ───────────── TESTIMONIALS ───────────── -->
      <section class="words" aria-labelledby="w-h">
        <h2 id="w-h" class="kicker mono">Kind words</h2>
        {
          quotes.map((q, i) => (
            <figure class={`q ${i % 2 ? "r" : "l"}`}>
              <span class="qm px" aria-hidden="true">
                “
              </span>
              <blockquote>{q.text.charAt(0).toUpperCase() + q.text.slice(1)}.</blockquote>
              <figcaption class="mono">
                — {q.by}, <span>{q.event}</span>
              </figcaption>
            </figure>
          ))
        }
      </section>

      <!-- ───────────── BOOK ───────────── -->
      <section class="book" id="book" aria-labelledby="book-h">
        <h2 id="book-h" class="bookh"><span id="bookt">Book Oscar</span></h2>
        <p class="bsub">Tell me a little about your event — takes a minute. I’ll reply within a day.</p>
        <form class="bk" id="form" novalidate>
          <div class="step cal">
            <p class="sl"><span class="px">1</span> When is it?</p>
            <div class="calhead">
              <button type="button" id="mprev" aria-label="Previous month">←</button>
              <span id="mlabel" class="px" aria-live="polite"></span>
              <button type="button" id="mnext" aria-label="Next month">→</button>
            </div>
            <div class="dow mono" aria-hidden="true"><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span></div>
            <div class="days" id="days" aria-label="Choose your event date"></div>
            <div class="calfoot">
              <p class="picked" id="picked">No date picked</p>
              <label class="tile-in small"><input type="checkbox" name="unsure" id="unsure" /><span>Not sure yet</span></label>
            </div>
          </div>

          <div class="right">
            <fieldset class="step">
              <legend class="sl"><span class="px">2</span> What’s the event?</legend>
              <div class="tiles">
                {
                  ["Hackathon", "Conference", "Demo night", "Launch party", "Panel / talk", "Meetup", "Offsite", "Something else"].map((t) => (
                    <label class="tile-in">
                      <input type="radio" name="type" value={t} />
                      <span>{t}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <fieldset class="step">
              <legend class="sl"><span class="px">3</span> What do you need? <em class="mono">pick any</em></legend>
              <div class="tiles">
                {
                  ["Photos", "Recap video", "Portraits", "Social cutdowns"].map((t, i) => (
                    <label class="tile-in">
                      <input type="checkbox" name="need" value={t} checked={i === 0} />
                      <span>{t}</span>
                    </label>
                  ))
                }
              </div>
              <div class="tiles four">
                {
                  ["2–3 hours", "Half day", "Full day", "Multi-day"].map((t) => (
                    <label class="tile-in small">
                      <input type="radio" name="len" value={t} />
                      <span>{t}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
            <div class="step">
              <p class="sl"><span class="px">4</span> Your details</p>
              <div class="row2">
                <label class="fld"><span class="mono">Name</span><input name="name" autocomplete="name" required /></label>
                <label class="fld"><span class="mono">Email</span><input name="email" type="email" autocomplete="email" required /></label>
              </div>
              <label class="fld"><span class="mono">Anything else? <em>venue, headcount, budget — optional</em></span><textarea name="notes" rows="3"></textarea></label>
            </div>
            <button class="send" type="submit"><span>Send message</span><span aria-hidden="true">→</span></button>
            <p class="err mono" id="err" role="alert"></p>
            <p class="mono fine">Opens your email app with everything filled in — nothing is stored. Or just write to <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
          </div>
        </form>
      </section>
    </main>

    <!-- ───────────── FOOTER ───────────── -->
    <footer class="foot" id="contact" aria-labelledby="ct-h">
      <h2 id="ct-h" class="mono kicker">Say hello</h2>
      <a class="email px" id="email" href={`mailto:${contact.email}`}>{contact.email}</a>
      <ul class="fsoc">
        {
          socials
            .filter((s) => s.label !== "Email")
            .map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">
                  <span>{s.label}</span>
                  <span class="mono">{s.handle} ↗</span>
                </a>
              </li>
            ))
        }
      </ul>
      <p class="mono colo"><span>Oscar · event photo + video · {contact.basedIn}</span><a href="#top">Back to top ↑</a></p>
    </footer>

    <a class="fab" id="fab" href="#book">Book a date →</a>

    <!-- ───────────── VIEWER ───────────── -->
    <div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
      <div class="vtop mono">
        <span id="vnum"></span>
        <span class="vbtns">
          <button type="button" id="mute">Sound on</button>
          <button type="button" id="vclose">Close ×</button>
        </span>
      </div>
      <div class="vstage"><img id="vimg" alt="" crossorigin="anonymous" /><div class="blink" id="blink"></div></div>
      <div class="vbot">
        <div><p class="vcap" id="vcap"></p><p class="mono" id="vexif"></p></div>
        <div class="vnav"><button type="button" id="vprev" aria-label="Previous photo">←</button><button type="button" id="vnext" aria-label="Next photo">→</button></div>
      </div>
    </div>

    <Switcher />

    <style is:inline>
      :root {
        --sans: "Archivo", "Helvetica Neue", Arial, sans-serif;
        --px: "Geist Pixel", "Geist Mono", ui-monospace, monospace;
        --mono: "Geist Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
        --g: 16px;
      }
      @media (min-width: 900px) {
        :root {
          --g: 28px;
        }
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: var(--coral);
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
      body {
        margin: 0;
        background: var(--coral);
        color: var(--on);
        font-family: var(--sans);
        font-variation-settings: "wdth" 100;
        overflow-x: clip;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
      }
      button {
        font: inherit;
        color: inherit;
        cursor: pointer;
      }
      :focus-visible {
        outline: 3px solid var(--ink);
        outline-offset: 3px;
      }
      .mono {
        font-family: var(--mono);
      }
      .px {
        font-family: var(--px);
        font-weight: 400;
      }
      .skip {
        position: absolute;
        left: -999px;
        top: 8px;
        z-index: 100;
        background: var(--ink);
        color: var(--paper);
        padding: 8px 12px;
      }
      .skip:focus {
        left: 8px;
      }
      .kicker {
        font: 500 12px/1 var(--mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin: 0 0 18px;
      }

      /* ── hero ── */
      .hero {
        min-height: 100svh;
        padding: calc(10px + env(safe-area-inset-top)) var(--g) var(--g);
        display: flex;
        flex-direction: column;
      }
      .bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .me {
        text-decoration: none;
        font-size: 12px;
        line-height: 1.2;
      }
      .me b {
        font-weight: 700;
        text-transform: uppercase;
      }
      .soc {
        display: flex;
        gap: 6px;
      }
      .soc a {
        font: 600 13px/1 var(--sans);
        text-decoration: none;
        border: 1.5px solid var(--on);
        padding: 9px 12px;
        border-radius: 999px;
        display: inline-flex;
        gap: 6px;
        transition:
          background 0.15s,
          color 0.15s;
      }
      .soc a i {
        font-style: normal;
      }
      .soc a:hover {
        background: var(--on);
        color: var(--coral);
      }
      @media (max-width: 520px) {
        .me span {
          display: none;
        }
        .soc a {
          padding: 9px 10px;
        }
      }
      .title {
        margin: clamp(28px, 6vh, 64px) 0 0;
        font-weight: 900;
        font-variation-settings: "wdth" 112;
        text-transform: uppercase;
        line-height: 0.86;
        letter-spacing: -0.02em;
        font-size: 17vw;
      }
      .title .w {
        display: inline-block;
        white-space: nowrap;
        margin-right: 0.22em;
      }
      .title .w:last-child {
        margin-right: 0;
      }
      .title .ch {
        display: inline-block;
        text-align: center;
      }
      .title .ch.pxl {
        font-family: var(--px);
        font-weight: 400;
        font-size: 0.92em;
        letter-spacing: 0;
      }
      .title .w:nth-child(2) {
        margin-right: 0;
      }
      .title .w:nth-child(2)::after {
        content: "";
        display: block;
      }
      @media (max-width: 699px) {
        .title .w {
          display: block;
          width: max-content;
          margin: 0;
        }
        .title .w::after {
          display: none !important;
        }
        .hero {
          padding-bottom: 60px;
        }
        .slab .sn {
          align-self: center;
          padding-top: 0;
        }
        .slab .st {
          font-variation-settings: "wdth" 80;
          font-weight: 900;
        }
      }
      .lede {
        font: 500 clamp(15px, 1.5vw, 20px) / 1.35 var(--sans);
        max-width: 38em;
        margin: 18px 0 clamp(20px, 4vh, 44px);
      }
      .slabs {
        display: grid;
        gap: 6px;
        margin-top: auto;
      }
      .slab {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: clamp(10px, 2vw, 28px);
        background: var(--on);
        color: var(--coral);
        text-decoration: none;
        padding: 0 clamp(14px, 2vw, 28px);
        height: var(--sh, 72px);
        overflow: hidden;
        transition:
          background 0.18s,
          color 0.18s;
      }
      .slab .sn {
        font-size: clamp(14px, 1.6vw, 22px);
        align-self: start;
        padding-top: 0.7em;
        opacity: 0.85;
      }
      .slab .st {
        font-weight: 850;
        font-variation-settings: "wdth" 100;
        text-transform: uppercase;
        font-size: var(--sf, 48px);
        line-height: 1;
        white-space: nowrap;
        letter-spacing: -0.01em;
      }
      .slab .sa {
        font-size: calc(var(--sf, 48px) * 0.6);
        font-weight: 400;
        transition: transform 0.2s;
      }
      .slab:hover,
      .slab:focus-visible {
        background: var(--sl-hov-bg);
        color: var(--sl-hov-fg);
        outline: none;
      }
      .slab:hover .st,
      .slab:focus-visible .st {
        font-family: var(--px);
        font-weight: 400;
        font-size: calc(var(--sf, 48px) * 0.84);
        letter-spacing: 0;
      }
      .slab:hover .sa {
        transform: translateX(6px);
      }
      .slab[href="#work"]:hover .sa {
        transform: translateY(4px);
      }

      /* ── dither lens ── */
      .lens {
        position: relative;
        height: clamp(460px, 112svh, 1200px);
        background: var(--coral);
        overflow: hidden;
        touch-action: pan-y;
        cursor: crosshair;
      }
      @media (max-width: 699px) {
        .lens {
          height: 78svh;
        }
      }
      .lens canvas,
      .lens img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .lens canvas {
        image-rendering: pixelated;
        opacity: 0;
        transition: opacity 0.8s;
      }
      .lens.on canvas {
        opacity: 1;
      }
      .lens img {
        object-fit: cover;
        clip-path: circle(0px at 50% 50%);
      }
      .lring {
        position: absolute;
        left: 0;
        top: 0;
        width: 0;
        height: 0;
        border-radius: 50%;
        box-shadow:
          0 0 0 2px var(--on),
          0 0 0 8px var(--coral);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s;
      }
      .lens.live .lring {
        opacity: 1;
      }
      .lcap {
        position: absolute;
        left: var(--g);
        right: var(--g);
        bottom: var(--g);
        margin: 0;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 12px;
      }
      .lcap span {
        background: var(--coral);
        padding: 5px 8px;
      }
      @media (max-width: 699px) {
        .lhint {
          display: none;
        }
      }

      /* ── selects ── */
      .work {
        background: var(--ink);
        color: var(--paper);
        padding: clamp(56px, 10vw, 120px) var(--g) clamp(80px, 12vw, 160px);
        overflow: hidden;
      }
      .big {
        font-weight: 900;
        font-variation-settings: "wdth" 112;
        text-transform: uppercase;
        font-size: clamp(64px, 15vw, 230px);
        line-height: 0.82;
        letter-spacing: -0.02em;
        margin: 0;
      }
      .shead {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: clamp(28px, 5vw, 64px);
      }
      .shead .big {
        color: var(--hi);
      }
      .shead p {
        font-size: 13px;
        line-height: 1.5;
        margin: 0;
        color: var(--mute2);
        max-width: 28em;
      }
      .cols {
        columns: 2;
        column-gap: 8px;
      }
      .cols.js {
        columns: auto;
        display: flex;
        gap: 8px;
        align-items: flex-start;
      }
      .col {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        will-change: transform;
      }
      @media (min-width: 900px) {
        .cols,
        .cols.js,
        .col {
          gap: 14px;
          column-gap: 14px;
        }
      }
      .tile {
        display: block;
        width: 100%;
        padding: 0;
        border: 0;
        background: none;
        text-align: left;
        break-inside: avoid;
        margin: 0 0 8px;
        position: relative;
        opacity: 0;
        transform: translateY(28px);
        transition:
          opacity 0.7s ease,
          transform 0.9s cubic-bezier(0.2, 0.7, 0.1, 1);
      }
      .cols.js .tile {
        margin: 0;
      }
      .tile.in {
        opacity: 1;
        transform: none;
      }
      .tile .fr {
        position: relative;
        display: block;
        aspect-ratio: var(--ar);
        overflow: hidden;
        background: var(--frame);
      }
      .tile canvas,
      .tile img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .tile canvas {
        image-rendering: pixelated;
      }
      .tile img {
        opacity: 0;
        transition:
          opacity 1.1s ease 0.35s,
          transform 0.6s cubic-bezier(0.2, 0.7, 0.1, 1);
      }
      .tile.sharp img {
        opacity: 1;
      }
      .tile:hover img {
        transform: scale(1.03);
      }
      .tile .cap {
        display: block;
        font-size: 11px;
        line-height: 1.35;
        padding: 7px 0 0;
        color: var(--mute);
      }
      .tile .cap b {
        font-weight: 500;
        color: var(--paper);
      }
      /* coloured block variants */
      .tile.v1 {
        background: var(--coral);
        padding: 10px 10px 12px;
      }
      .tile.v1 .cap,
      .tile.v1 .cap b {
        color: var(--on);
      }
      .tile.v2 {
        width: 84%;
        margin-left: auto;
      }
      .tile.v3 {
        background: var(--pg);
        padding: 10px 10px 12px;
        width: 92%;
      }
      .tile.v3 .cap,
      .tile.v3 .cap b {
        color: var(--pt);
      }
      .tile:focus-visible {
        outline-color: var(--coral);
      }

      /* ── what I shoot / what you get ── */
      .get {
        background: var(--pg);
        color: var(--pt);
        padding: clamp(64px, 10vw, 140px) var(--g);
      }
      .bio {
        font-weight: 700;
        font-variation-settings: "wdth" 100;
        font-size: clamp(28px, 4.6vw, 72px);
        line-height: 1.04;
        letter-spacing: -0.02em;
        margin: 0 0 clamp(56px, 9vw, 120px);
        max-width: 17em;
        text-wrap: pretty;
      }
      .sw {
        display: inline-block;
        color: var(--coral);
        text-align: center;
        white-space: nowrap;
        cursor: default;
        border-radius: 2px;
      }
      .sw.pxl {
        font-family: var(--px);
        font-weight: 400;
        font-size: 0.86em;
        letter-spacing: 0;
        color: var(--pt);
      }
      .sw:focus-visible {
        outline-offset: 2px;
      }
      .svc {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
      }
      @media (min-width: 760px) {
        .svc {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (min-width: 1200px) {
        .svc {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }
      .box {
        container-type: inline-size;
        border: 2px solid var(--pt);
        padding: 18px 18px 22px;
        min-height: clamp(220px, 34vw, 320px);
        display: flex;
        flex-direction: column;
        outline: none;
      }
      .box.coral {
        background: var(--coral);
        color: var(--on);
      }
      .box.ink {
        background: var(--ink);
        color: var(--paper);
      }
      .box .bn {
        font-size: 40px;
        line-height: 1;
      }
      .box.paper .bn {
        color: var(--coral);
      }
      .box.ink .bn {
        color: var(--hi);
      }
      .box h3 {
        margin: auto 0 14px;
        padding-top: 36px;
        font-weight: 800;
        font-variation-settings: "wdth" 100;
        font-size: min(56px, 11.4cqi);
        line-height: 0.92;
        text-transform: uppercase;
        letter-spacing: -0.015em;
        transition:
          font-variation-settings 0.35s cubic-bezier(0.2, 0.7, 0.1, 1),
          font-weight 0.35s;
      }
      .box .ln {
        display: block;
        white-space: nowrap;
      }
      .box:hover h3,
      .box:focus-visible h3 {
        font-variation-settings: "wdth" 62;
        font-weight: 900;
      }
      .box p {
        margin: 0;
        font-size: 13px;
        line-height: 1.5;
        max-width: 26em;
      }

      /* ── clients ── */
      .clients {
        background: var(--coral);
        padding: clamp(48px, 7vw, 96px) var(--g);
      }
      .clients h2 {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin: 0 0 28px;
        font-weight: 500;
      }
      .clients ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 2px solid var(--on);
      }
      @media (min-width: 760px) {
        .clients ul {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .clients li {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        padding: clamp(28px, 4vw, 56px) 12px;
        border-bottom: 2px solid var(--on);
        border-right: 2px solid var(--on);
      }
      .clients li:nth-child(2n) {
        border-right: 0;
      }
      @media (min-width: 760px) {
        .clients li:nth-child(2n) {
          border-right: 2px solid var(--on);
        }
        .clients li:last-child {
          border-right: 0;
        }
      }
      .mark {
        display: block;
        height: clamp(44px, 6vw, 84px);
        aspect-ratio: var(--r);
        max-width: 80%;
        background: var(--on);
        -webkit-mask: var(--m) center / contain no-repeat;
        mask: var(--m) center / contain no-repeat;
      }
      .clients .nm {
        font-weight: 800;
        text-transform: uppercase;
        font-size: clamp(14px, 1.4vw, 20px);
        letter-spacing: 0.02em;
      }

      /* ── testimonials ── */
      .words {
        background: var(--ink);
        color: var(--paper);
        padding: clamp(64px, 10vw, 140px) var(--g);
      }
      .words .kicker {
        color: var(--hi);
      }
      .q {
        margin: 0 0 clamp(56px, 8vw, 110px);
        max-width: 15em;
        font-size: clamp(32px, 5.4vw, 84px);
        position: relative;
      }
      .q:last-child {
        margin-bottom: 0;
      }
      .q.r {
        margin-left: auto;
        text-align: right;
      }
      .qm {
        display: block;
        color: var(--hi);
        font-size: 2.2em;
        line-height: 0.6;
        height: 0.5em;
      }
      .q blockquote {
        margin: 0;
        font-weight: 800;
        font-variation-settings: "wdth" 100;
        line-height: 1.02;
        letter-spacing: -0.02em;
        text-wrap: balance;
      }
      .q figcaption {
        font-size: 13px;
        margin-top: 18px;
        color: var(--hi);
      }
      .q figcaption span {
        color: var(--mute);
      }

      /* ── book ── */
      .book {
        background: var(--coral);
        min-height: 100svh;
        padding: clamp(40px, 6vw, 80px) var(--g) clamp(56px, 8vw, 100px);
      }
      .bookh {
        margin: 0;
        font-weight: 900;
        font-variation-settings: "wdth" 125;
        text-transform: uppercase;
        line-height: 0.8;
        letter-spacing: -0.03em;
        white-space: nowrap;
        font-size: 22vw;
      }
      .bsub {
        font: 600 clamp(17px, 1.6vw, 22px) / 1.35 var(--sans);
        margin: 18px 0 clamp(28px, 4vw, 52px);
        max-width: 36em;
        text-wrap: balance;
      }
      .bk {
        display: grid;
        gap: 14px;
      }
      @media (min-width: 960px) {
        .bk {
          grid-template-columns: minmax(320px, 5fr) 7fr;
          gap: 18px;
          align-items: start;
        }
        .cal {
          position: sticky;
          top: 18px;
        }
      }
      .step {
        border: 0;
        margin: 0;
        padding: 0;
        min-width: 0;
      }
      .right {
        display: grid;
        gap: 26px;
      }
      .sl {
        font-weight: 800;
        font-size: 20px;
        margin: 0 0 12px;
        padding: 0;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .sl .px {
        display: inline-grid;
        place-items: center;
        width: 30px;
        height: 30px;
        background: var(--on);
        color: var(--coral);
        font-size: 18px;
      }
      .sl em {
        font-style: normal;
        font-weight: 400;
        font-size: 12px;
        opacity: 0.75;
      }
      .cal {
        background: var(--ink);
        color: var(--paper);
        padding: 16px;
      }
      .cal .sl .px {
        background: var(--coral);
        color: var(--on);
      }
      .calhead {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 6px 0 10px;
      }
      .calhead span {
        font-size: 26px;
        text-transform: uppercase;
      }
      .calhead button {
        width: 44px;
        height: 44px;
        border: 1.5px solid var(--rule);
        background: none;
        font-size: 18px;
      }
      .calhead button:disabled {
        opacity: 0.25;
        cursor: default;
      }
      .dow,
      .days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 4px;
      }
      .dow span {
        text-align: center;
        font-size: 11px;
        color: var(--mute3);
        padding-bottom: 4px;
      }
      .day {
        height: clamp(40px, 5.2vh, 52px);
        border: 0;
        background: var(--cell);
        color: var(--paper);
        font-family: var(--px);
        font-size: clamp(16px, 1.6vw, 22px);
      }
      .day:hover:not(:disabled) {
        background: var(--cell-hov);
      }
      .day:disabled {
        background: transparent;
        color: var(--cell-off);
        cursor: default;
      }
      .day[aria-pressed="true"] {
        background: var(--coral);
        color: var(--on);
      }
      .day.today {
        box-shadow: inset 0 0 0 1.5px var(--today);
      }
      .calfoot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-top: 12px;
        flex-wrap: wrap;
      }
      .picked {
        margin: 0;
        font-weight: 700;
        font-size: 17px;
      }
      .picked.has {
        color: var(--hi);
      }
      .tiles {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
      }
      @media (min-width: 600px) {
        .tiles {
          grid-template-columns: repeat(4, 1fr);
        }
      }
      .tiles.four {
        margin-top: 6px;
        grid-template-columns: repeat(4, 1fr);
      }
      .tile-in {
        position: relative;
        display: block;
      }
      .tile-in input {
        position: absolute;
        opacity: 0;
        inset: 0;
        margin: 0;
        cursor: pointer;
      }
      .tile-in span {
        display: flex;
        align-items: center;
        min-height: 56px;
        padding: 10px 12px;
        background: var(--pg);
        color: var(--pt);
        font-weight: 650;
        font-size: 15px;
        line-height: 1.15;
        transition:
          background 0.12s,
          color 0.12s;
      }
      .tile-in.small span {
        min-height: 44px;
        font-size: 13px;
        justify-content: center;
        text-align: center;
        padding: 8px 6px;
      }
      .tile-in:hover span {
        background: var(--lift);
      }
      .tile-in input:checked + span {
        background: var(--sel-bg);
        color: var(--sel-fg);
      }
      .tile-in input:checked + span::before {
        content: "✓";
        font-family: var(--px);
        margin-right: 8px;
      }
      .tile-in input:focus-visible + span {
        outline: 3px solid var(--on);
        outline-offset: 2px;
      }
      .cal .tile-in span {
        background: var(--cell);
        color: var(--paper);
        padding: 8px 14px;
      }
      .cal .tile-in input:checked + span {
        background: var(--coral);
        color: var(--on);
      }
      .cal .tile-in input:focus-visible + span {
        outline-color: var(--coral);
      }
      .row2 {
        display: grid;
        gap: 6px;
        margin-bottom: 6px;
      }
      @media (min-width: 600px) {
        .row2 {
          grid-template-columns: 1fr 1fr;
        }
      }
      .fld {
        display: block;
        background: var(--pg);
        color: var(--pt);
        padding: 10px 12px 4px;
      }
      .fld span {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .fld em {
        font-style: normal;
        text-transform: none;
        letter-spacing: 0;
        opacity: 0.6;
      }
      .fld input,
      .fld textarea {
        width: 100%;
        border: 0;
        background: transparent;
        font: 600 18px/1.3 var(--sans);
        padding: 6px 0 8px;
        color: var(--pt);
        resize: vertical;
      }
      .fld:focus-within {
        outline: 3px solid var(--on);
        outline-offset: 2px;
      }
      .fld input:focus,
      .fld textarea:focus {
        outline: none;
      }
      .send {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        border: 0;
        background: var(--on);
        color: var(--coral);
        padding: 22px 22px;
        font-weight: 850;
        font-size: clamp(28px, 3.4vw, 48px);
        text-transform: uppercase;
        letter-spacing: -0.01em;
        transition:
          background 0.15s,
          color 0.15s;
      }
      .send:hover,
      .send:focus-visible {
        background: var(--sl-hov-bg);
        color: var(--sl-hov-fg);
      }
      .send:hover span:first-child {
        font-family: var(--px);
        font-weight: 400;
      }
      .err {
        margin: -14px 0 0;
        font-size: 13px;
        font-weight: 600;
        min-height: 0;
      }
      .err:empty {
        display: none;
      }
      .fine {
        font-size: 12px;
        line-height: 1.5;
        margin: -12px 0 0;
      }

      /* ── footer ── */
      .foot {
        background: var(--ink);
        color: var(--paper);
        padding: clamp(64px, 9vw, 120px) var(--g) calc(var(--g) + 50px + env(safe-area-inset-bottom));
      }
      .foot .kicker {
        color: var(--hi);
      }
      .email {
        display: inline-block;
        color: var(--hi);
        text-decoration: none;
        white-space: nowrap;
        line-height: 1;
        font-size: 9vw;
        margin: 0 0 clamp(28px, 4vw, 56px);
      }
      .email:hover {
        color: var(--paper);
      }
      .fsoc {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 6px;
      }
      @media (min-width: 760px) {
        .fsoc {
          grid-template-columns: 1fr 1fr;
        }
      }
      .fsoc a {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        border: 2px solid var(--paper);
        padding: 18px 20px;
        text-decoration: none;
        font-weight: 850;
        text-transform: uppercase;
        font-size: clamp(32px, 4.4vw, 64px);
        line-height: 1;
        transition:
          background 0.15s,
          color 0.15s;
      }
      .fsoc a {
        flex-wrap: wrap;
      }
      body:has(.viewer:not([hidden])) .psw,
      body:has(.viewer:not([hidden])) .fab {
        display: none;
      }
      .fsoc a .mono {
        font-size: 13px;
        font-weight: 400;
        text-transform: none;
      }
      .fsoc a:hover {
        background: var(--coral);
        border-color: var(--coral);
        color: var(--on);
      }
      .colo {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        font-size: 12px;
        color: var(--mute3);
        margin: 40px 0 0;
      }

      /* floating book pill (after hero, hidden at the form) */
      .fab {
        position: fixed;
        left: 10px;
        bottom: calc(10px + env(safe-area-inset-bottom));
        z-index: 40;
        background: var(--ink);
        color: var(--hi);
        text-decoration: none;
        font-weight: 800;
        font-size: 14px;
        padding: 12px 16px;
        border-radius: 999px;
        box-shadow: 0 0 0 1.5px var(--coral);
        transform: translateY(160%);
        transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
      }
      .fab.show {
        transform: none;
      }

      /* ── viewer ── */
      .viewer {
        position: fixed;
        inset: 0;
        z-index: 60;
        background: var(--vbg);
        color: var(--paper);
        display: grid;
        grid-template-rows: auto 1fr auto;
      }
      .viewer[hidden] {
        display: none;
      }
      .vtop,
      .vbot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 10px var(--g);
      }
      .vtop {
        padding-top: calc(10px + env(safe-area-inset-top));
        font-size: 12px;
      }
      .vtop #vnum {
        color: var(--hi);
      }
      .vbtns {
        display: flex;
        gap: 6px;
      }
      .vtop button {
        border: 1.5px solid var(--rule2);
        background: none;
        padding: 10px 12px;
        font-size: 12px;
        font-family: var(--mono);
        min-height: 40px;
      }
      .vtop button:hover {
        border-color: var(--hi);
      }
      .vstage {
        position: relative;
        min-height: 0;
      }
      .vstage img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .blink {
        position: absolute;
        inset: 0;
        background: #000;
        opacity: 0;
        pointer-events: none;
      }
      .blink.go {
        animation: blink 0.07s steps(1) 1;
      }
      @keyframes blink {
        0% {
          opacity: 1;
        }
        100% {
          opacity: 0;
        }
      }
      .vbot {
        padding-bottom: calc(14px + env(safe-area-inset-bottom));
        align-items: end;
        padding-right: calc(var(--g) + 0px);
      }
      .vcap {
        margin: 0 0 4px;
        font-weight: 800;
        font-size: clamp(20px, 2.2vw, 30px);
        text-transform: uppercase;
        line-height: 1;
      }
      #vexif {
        margin: 0;
        font-size: 11px;
        color: var(--mute);
        line-height: 1.5;
      }
      .vnav {
        display: flex;
        gap: 6px;
        margin-bottom: 36px;
      }
      .vnav button {
        width: 52px;
        height: 52px;
        border: 1.5px solid var(--rule2);
        background: none;
        font-size: 20px;
      }
      .vnav button:hover {
        background: var(--coral);
        color: var(--on);
        border-color: var(--coral);
      }
      @media (min-width: 700px) {
        .vnav {
          margin-bottom: 0;
        }

      }
      @media (prefers-reduced-motion: reduce) {
        .tile,
        .tile img,
        .box h3,
        .fab {
          transition: none !important;
        }
        .tile {
          opacity: 1;
          transform: none;
        }
      }
    </style>

    <script>
      import { shutter, bindMute } from "@/components/photos/opus/r3/shutter";
      import { readJSON, reduced, viewerNav, lockScroll, mailto, loadImage, atkinson, instant, type ClientShot } from "@/components/photos/opus/r3/client";

      type Shot = ClientShot & { mid: string };
      const shots = readJSON<Shot[]>("shots");
      const RM = reduced();
      // dither inks from the scheme: the lens prints in the on-accent colour, the selects in the accent
      const { lens: INK, tile: CORAL } = JSON.parse(document.documentElement.dataset.dither!) as Record<"lens" | "tile", [number, number, number]>;
      const ready = (document as any).fonts?.ready ?? Promise.resolve();

      /* ───── hero: fit title + slabs, slow letter trades ───── */
      const titleEl = document.getElementById("title")!;
      const hero = document.querySelector<HTMLElement>(".hero")!;
      const slabs = document.getElementById("slabs")!;
      const chars = [...titleEl.querySelectorAll<HTMLElement>(".ch")];

      function fitHero() {
        // title: widest line fills the content width
        chars.forEach((c) => (c.style.width = ""));
        const avail = hero.clientWidth - 2 * parseFloat(getComputedStyle(hero).paddingLeft);
        titleEl.style.fontSize = "100px";
        const ws = [...titleEl.querySelectorAll<HTMLElement>(".w")];
        const widest = innerWidth < 700 ? Math.max(...ws.map((w) => w.offsetWidth)) + 4 : Math.max(ws[0].offsetWidth + ws[1].offsetWidth, ws[2].offsetWidth) + 22;
        let fs = (100 * avail) / widest;
        if (innerWidth >= 700) fs = Math.min(fs, innerHeight * 0.165);
        titleEl.style.fontSize = Math.floor(fs) + "px";
        // lock every letter's width so a font trade never shifts layout
        chars.forEach((c) => (c.style.width = c.getBoundingClientRect().width.toFixed(2) + "px"));

        // slabs: one common size where the longest label fits, capped by height
        const items = [...slabs.querySelectorAll<HTMLElement>(".slab")];
        slabs.style.setProperty("--sf", "100px");
        let k = Infinity;
        for (const s of items) {
          const st = s.querySelector<HTMLElement>(".st")!;
          const room = s.clientWidth - (s.querySelector<HTMLElement>(".sn")!.offsetWidth + s.querySelector<HTMLElement>(".sa")!.offsetWidth) - 2 * parseFloat(getComputedStyle(s).paddingLeft) - 2 * parseFloat(getComputedStyle(s).columnGap) - 4;
          k = Math.min(k, (100 * room) / st.scrollWidth);
        }
        const lede = hero.querySelector<HTMLElement>(".lede")!;
        const used = lede.getBoundingClientRect().bottom - hero.getBoundingClientRect().top + 24;
        const hMax = innerWidth >= 700 ? (innerHeight - used - 28 - 18 - 8 * 4) / 4 / 1.18 : 999;
        const sf = Math.max(30, Math.min(k, hMax, 170));
        slabs.style.setProperty("--sf", sf.toFixed(1) + "px");
        let sh = sf * 1.18 + 8;
        if (innerWidth < 700) sh = Math.max(sh, Math.min(96, (innerHeight - used - 60 - 24) / 4 - 6));
        slabs.style.setProperty("--sh", Math.round(sh) + "px");
      }
      fitHero();
      ready.then(fitHero);
      let lastW = innerWidth;
      addEventListener("resize", () => {
        if (Math.abs(innerWidth - lastW) < 2 && matchMedia("(pointer: coarse)").matches) return;
        lastW = innerWidth;
        fitHero();
        fitFoot();
        lockWords();
      });

      // one letter at a time trades into Geist Pixel, slowly
      if (!RM) {
        const on = new Set<HTMLElement>();
        const swap = () => {
          if (document.hidden) return;
          const pool = chars.filter((c) => !on.has(c) && c.textContent !== ".");
          const c = pool[Math.floor(Math.random() * pool.length)];
          if (!c || on.size >= 2) return;
          on.add(c);
          c.classList.add("pxl");
          setTimeout(() => {
            c.classList.remove("pxl");
            on.delete(c);
          }, 2600);
        };
        setTimeout(() => {
          swap();
          setInterval(swap, 1500);
        }, 900);
      }

      /* ───── dither lens ───── */
      const lensEl = document.getElementById("lens")!;
      const lcan = document.getElementById("lcan") as HTMLCanvasElement;
      const limg = document.getElementById("limg") as HTMLImageElement;
      const ring = document.getElementById("lring")!;
      let lensImg: HTMLImageElement | null = null;
      function paintLens() {
        if (!lensImg) return;
        const cell = innerWidth < 700 ? 2 : 2;
        const w = Math.min(1100, Math.round(lensEl.clientWidth / cell));
        const h = Math.round((w * lensEl.clientHeight) / lensEl.clientWidth);
        const data = atkinson(lensImg, w, h, INK, 0.04, 1.35);
        lcan.width = w;
        lcan.height = h;
        lcan.getContext("2d")!.putImageData(data, 0, 0);
        lensEl.classList.add("on");
      }
      const lio = new IntersectionObserver(
        async (e) => {
          if (!e[0].isIntersecting) return;
          lio.disconnect();
          try {
            lensImg = await loadImage(lensEl.dataset.small!);
            paintLens();
            limg.src = lensEl.dataset.src!;
          } catch {}
        },
        { rootMargin: "400px" },
      );
      lio.observe(lensEl);
      addEventListener("resize", () => paintLens());

      // lens follows pointer; drifts on its own on touch / before first move
      let lx = 0.62,
        ly = 0.42,
        tx = lx,
        ty = ly,
        rad = 0,
        trad = 0,
        driving = false,
        lastMove = 0,
        lensVisible = false;
      const R = () => Math.min(220, Math.max(110, lensEl.clientWidth * 0.14));
      new IntersectionObserver((e) => (lensVisible = e[0].isIntersecting)).observe(lensEl);
      lensEl.addEventListener("pointermove", (e) => {
        const r = lensEl.getBoundingClientRect();
        tx = (e.clientX - r.left) / r.width;
        ty = (e.clientY - r.top) / r.height;
        driving = true;
        lastMove = performance.now();
      });
      lensEl.addEventListener("pointerleave", () => (driving = false));
      const t0 = performance.now();
      const lensTick = (now: number) => {
        requestAnimationFrame(lensTick);
        if (!lensVisible || !lensEl.classList.contains("on")) return;
        if (!driving || now - lastMove > 2500) {
          if (RM) {
            tx = 0.6;
            ty = 0.45;
          } else {
            const t = (now - t0) / 1000;
            tx = 0.5 + 0.28 * Math.sin(t * 0.31);
            ty = 0.48 + 0.2 * Math.sin(t * 0.47 + 1);
          }
        }
        trad = limg.complete && limg.naturalWidth ? R() : 0;
        const k = RM ? 1 : 0.12;
        lx += (tx - lx) * k;
        ly += (ty - ly) * k;
        rad += (trad - rad) * (RM ? 1 : 0.1);
        const W = lensEl.clientWidth,
          H = lensEl.clientHeight;
        const x = lx * W,
          y = ly * H;
        limg.style.clipPath = `circle(${rad.toFixed(1)}px at ${x.toFixed(1)}px ${y.toFixed(1)}px)`;
        ring.style.transform = `translate(${(x - rad).toFixed(1)}px, ${(y - rad).toFixed(1)}px)`;
        ring.style.width = ring.style.height = (2 * rad).toFixed(1) + "px";
        lensEl.classList.toggle("live", rad > 20);
      };
      requestAnimationFrame(lensTick);

      /* ───── selects: masonry columns + parallax + dither→photo ───── */
      const colsEl = document.getElementById("cols")!;
      const tiles = [...colsEl.querySelectorAll<HTMLButtonElement>(".tile")];
      let cols: HTMLElement[] = [];
      const nCols = () => (innerWidth >= 1200 ? 4 : innerWidth >= 760 ? 3 : 2);
      const speeds = [
        [0, -0.09],
        [-0.04, 0.05, -0.1],
        [-0.03, 0.06, -0.11, 0.02],
      ];
      function layoutCols() {
        const n = nCols();
        if (cols.length === n) return;
        cols.forEach((c) => c.remove());
        cols = Array.from({ length: n }, () => {
          const c = document.createElement("div");
          c.className = "col";
          colsEl.appendChild(c);
          return c;
        });
        colsEl.classList.add("js");
        const hs = new Array(n).fill(0);
        tiles.forEach((t) => {
          const s = shots[+t.dataset.i!];
          let j = 0;
          for (let q = 1; q < n; q++) if (hs[q] < hs[j] - 0.05) j = q;
          cols[j].appendChild(t);
          hs[j] += s.h / s.w + 0.12;
        });
      }
      layoutCols();
      addEventListener("resize", layoutCols);

      function reveal(t: HTMLElement) {
        const img = t.querySelector("img")!;
        const c = t.querySelector("canvas")!;
        const done = () => {
          try {
            const w = Math.max(60, Math.round(t.clientWidth / 3));
            const s = shots[+t.dataset.i!];
            const h = Math.round((w * s.h) / s.w);
            const d = atkinson(img, w, h, CORAL, 0.02, 1.3);
            c.width = w;
            c.height = h;
            c.getContext("2d")!.putImageData(d, 0, 0);
          } catch {}
          t.classList.add("in");
          requestAnimationFrame(() => setTimeout(() => t.classList.add("sharp"), RM ? 0 : 120));
        };
        img.addEventListener("load", done, { once: true });
        img.addEventListener("error", () => t.classList.add("in", "sharp"), { once: true });
        img.src = img.dataset.src!;
      }
      const tio = new IntersectionObserver(
        (ents) =>
          ents.forEach((e) => {
            if (!e.isIntersecting) return;
            tio.unobserve(e.target);
            reveal(e.target as HTMLElement);
          }),
        { rootMargin: "0px 0px 120px 0px", threshold: 0.01 },
      );
      tiles.forEach((t) => tio.observe(t));

      if (!RM) {
        const work = document.getElementById("work")!;
        let wv = false;
        new IntersectionObserver((e) => (wv = e[0].isIntersecting)).observe(work);
        const pl = () => {
          requestAnimationFrame(pl);
          if (!wv) return;
          const r = colsEl.getBoundingClientRect();
          const d = r.top + r.height / 2 - innerHeight / 2;
          const sp = speeds[cols.length - 2] ?? [];
          cols.forEach((c, i) => (c.style.transform = `translate3d(0, ${(d * (sp[i] ?? 0)).toFixed(1)}px, 0)`));
        };
        pl();
      }

      /* ───── words: fixed-width swap to pixel on hover ───── */
      const sws = [...document.querySelectorAll<HTMLElement>(".sw")];
      function lockWords() {
        sws.forEach((w) => {
          w.classList.remove("pxl");
          w.style.width = "";
          w.style.width = w.getBoundingClientRect().width.toFixed(2) + "px";
        });
      }
      ready.then(lockWords);
      lockWords();
      sws.forEach((w) => {
        const on = () => w.classList.add("pxl");
        const off = () => w.classList.remove("pxl");
        w.addEventListener("pointerenter", on);
        w.addEventListener("pointerleave", off);
        w.addEventListener("focus", on);
        w.addEventListener("blur", off);
      });

      /* ───── footer email: fit to width ───── */
      const emailEl = document.getElementById("email")!;
      function fitFoot() {
        emailEl.style.fontSize = "100px";
        const avail = emailEl.parentElement!.clientWidth - 2 * parseFloat(getComputedStyle(emailEl.parentElement!).paddingLeft);
        emailEl.style.fontSize = Math.floor((100 * avail) / emailEl.offsetWidth) + "px";
      }
      fitFoot();
      ready.then(fitFoot);
      // "Book Oscar" fills the width too
      const bookt = document.getElementById("bookt")!;
      const fitBook = () => {
        const h = bookt.parentElement!;
        h.style.fontSize = "100px";
        h.style.fontSize = Math.floor((100 * (h.clientWidth - 4)) / bookt.offsetWidth) + "px";
      };
      fitBook();
      ready.then(fitBook);
      addEventListener("resize", fitBook);

      /* ───── floating book pill ───── */
      const fab = document.getElementById("fab")!;
      const bookEl = document.getElementById("book")!;
      const footEl = document.getElementById("contact")!;
      let pastHero = false,
        atBook = false;
      const syncFab = () => fab.classList.toggle("show", pastHero && !atBook);
      new IntersectionObserver((e) => {
        pastHero = !e[0].isIntersecting && e[0].boundingClientRect.top < 0;
        syncFab();
      }).observe(hero);
      const vis = new Set<Element>();
      new IntersectionObserver((es) => {
        es.forEach((e) => (e.isIntersecting ? vis.add(e.target) : vis.delete(e.target)));
        atBook = vis.size > 0;
        syncFab();
      }).observe(bookEl);
      new IntersectionObserver((es) => {
        es.forEach((e) => (e.isIntersecting ? vis.add(e.target) : vis.delete(e.target)));
        atBook = vis.size > 0;
        syncFab();
      }).observe(footEl);

      /* ───── viewer ───── */
      const V = document.getElementById("viewer")!;
      const vimg = document.getElementById("vimg") as HTMLImageElement;
      const blink = document.getElementById("blink")!;
      const vnum = document.getElementById("vnum")!;
      const vcap = document.getElementById("vcap")!;
      const vexif = document.getElementById("vexif")!;
      let cur = 0,
        opener: HTMLElement | null = null;
      function show(i: number, sound = true) {
        cur = (i + shots.length) % shots.length;
        const s = shots[cur];
        const tileImg = tiles[cur].querySelector("img")!;
        // the tile's mid-size image is already decoded → instant; else the thumb
        const low = tileImg.complete && tileImg.naturalWidth ? s.mid : s.thumb;
        instant(vimg, low, s.src);
        vimg.alt = s.caption;
        vnum.textContent = `${String(cur + 1).padStart(2, "0")} / ${shots.length}`;
        vcap.textContent = s.caption;
        vexif.textContent = `${s.event} · ${s.place} — ${s.exif.camera}, ${s.exif.lens}, ${s.exif.aperture}, ${s.exif.shutter}s, ISO ${s.exif.iso}`;
        if (sound) shutter();
        if (!RM) {
          blink.classList.remove("go");
          void blink.offsetWidth;
          blink.classList.add("go");
        }
        // warm the neighbours
        [cur + 1, cur - 1].forEach((j) => {
          const n = shots[(j + shots.length) % shots.length];
          const im = new Image();
          im.src = n.mid;
        });
      }
      function open(i: number, from: HTMLElement) {
        opener = from;
        V.hidden = false;
        lockScroll(true);
        show(i);
        document.getElementById("vclose")!.focus({ preventScroll: true });
      }
      function close() {
        V.hidden = true;
        lockScroll(false);
        opener?.focus({ preventScroll: true });
      }
      tiles.forEach((t) => t.addEventListener("click", () => open(+t.dataset.i!, t)));
      document.getElementById("vclose")!.addEventListener("click", close);
      document.getElementById("vprev")!.addEventListener("click", () => show(cur - 1));
      document.getElementById("vnext")!.addEventListener("click", () => show(cur + 1));
      vimg.addEventListener("click", () => show(cur + 1));
      viewerNav(V, { prev: () => show(cur - 1), next: () => show(cur + 1), close, isOpen: () => !V.hidden });
      const muteBtn = document.getElementById("mute")!;
      bindMute(muteBtn, (m) => (muteBtn.textContent = m ? "Sound off" : "Sound on"));
      // keep focus inside the dialog
      V.addEventListener("keydown", (e) => {
        if (e.key !== "Tab") return;
        const f = [...V.querySelectorAll<HTMLElement>("button")];
        const i = f.indexOf(document.activeElement as HTMLElement);
        if (e.shiftKey && i <= 0) {
          e.preventDefault();
          f[f.length - 1].focus();
        } else if (!e.shiftKey && i === f.length - 1) {
          e.preventDefault();
          f[0].focus();
        }
      });

      /* ───── booking ───── */
      const daysEl = document.getElementById("days")!;
      const mlabel = document.getElementById("mlabel")!;
      const picked = document.getElementById("picked")!;
      const unsure = document.getElementById("unsure") as HTMLInputElement;
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      let view = new Date(today.getFullYear(), today.getMonth(), 1);
      let sel: Date | null = null;
      const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      function renderCal() {
        mlabel.textContent = view.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
        const first = (view.getDay() + 6) % 7;
        const n = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
        let h = "";
        for (let i = 0; i < first; i++) h += `<span></span>`;
        for (let d = 1; d <= n; d++) {
          const dt = new Date(view.getFullYear(), view.getMonth(), d);
          const past = dt < today;
          const on = !!sel && iso(sel) === iso(dt);
          h += `<button type="button" class="day${iso(dt) === iso(today) ? " today" : ""}" data-d="${iso(dt)}" ${past ? "disabled" : ""} aria-pressed="${on}" aria-label="${dt.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" })}">${d}</button>`;
        }
        daysEl.innerHTML = h;
        (document.getElementById("mprev") as HTMLButtonElement).disabled = view <= new Date(today.getFullYear(), today.getMonth(), 1);
      }
      function setPicked() {
        if (sel) {
          picked.textContent = sel.toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "long" });
          picked.classList.add("has");
        } else {
          picked.textContent = unsure.checked ? "Date TBC — that’s fine" : "No date picked";
          picked.classList.toggle("has", unsure.checked);
        }
      }
      daysEl.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".day");
        if (!b || b.disabled) return;
        sel = sel && iso(sel) === b.dataset.d ? null : new Date(b.dataset.d + "T00:00:00");
        if (sel) unsure.checked = false;
        setPicked();
        renderCal();
        daysEl.querySelector<HTMLElement>(`[data-d="${b.dataset.d}"]`)?.focus();
      });
      unsure.addEventListener("change", () => {
        if (unsure.checked) sel = null;
        setPicked();
        renderCal();
      });
      document.getElementById("mprev")!.addEventListener("click", () => {
        view = new Date(view.getFullYear(), view.getMonth() - 1, 1);
        renderCal();
      });
      document.getElementById("mnext")!.addEventListener("click", () => {
        view = new Date(view.getFullYear(), view.getMonth() + 1, 1);
        renderCal();
      });
      renderCal();

      const form = document.getElementById("form") as HTMLFormElement;
      const err = document.getElementById("err")!;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const name = String(fd.get("name") || "").trim();
        const email = String(fd.get("email") || "").trim();
        if (!name || !/^\S+@\S+\.\S+$/.test(email)) {
          err.textContent = !name ? "↑ Just need your name so I know who to reply to." : "↑ That email doesn’t look quite right.";
          (form.querySelector<HTMLInputElement>(!name ? "[name=name]" : "[name=email]")!).focus();
          return;
        }
        err.textContent = "";
        const type = String(fd.get("type") || "event");
        location.href = mailto("hello@oscarama.dev", `${type} — ${sel ? iso(sel) : "date tbc"}`, [
          ["date", sel ? iso(sel) : "not sure yet"],
          ["event", fd.get("type") ? String(fd.get("type")) : undefined],
          ["need", fd.getAll("need").join(", ")],
          ["length", fd.get("len") ? String(fd.get("len")) : undefined],
          ["name", name],
          ["reply to", email],
          ["notes", String(fd.get("notes") || "")],
        ]);
      });
    </script>
  </body>
</html>
