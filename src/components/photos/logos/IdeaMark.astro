---
// Round 2 of the Oscar Shoots concepts: ideas pulled from the double meanings (green shoots, the Oscar statuette)
// and from the gear (camera screen, focus peaking, contact sheets, slates, rolling shutter, bracketing, aperture),
// plus the one event object everyone wears: the lanyard pass. Same colour contract as Mark.astro.
import Bits from "@/components/photos/fable/r3/Bits.astro";
import { sprout, statuette, aperture, type IdeaId } from "./marks";

interface Props { id: IdeaId; mark?: boolean }
const { id, mark = false } = Astro.props;
const word = mark ? "os" : "oscar shoots";
const slices = 7;
---
<span class:list={["mk", `id-${id}`, { compact: mark }]}>
  {id === "sprout" && <span class="wm">{!mark && "oscar shoots"}<Bits rows={sprout} class="spr" /></span>}

  {id === "statuette" && <span class="stat"><Bits rows={statuette} class="fig" />{!mark && <span class="sw2"><small>and the</small><span class="wm sm">oscar shoots</span></span>}</span>}

  {id === "screen" && (
    <span class="scr">
      <span class="hud t"><span><i class="dot" />{mark ? "" : " REC"}</span>{!mark && <span>▮▮▮▯</span>}</span>
      <span class="fb"><i /><i /><i /><i /><span class="wm sm">{word}</span></span>
      {!mark && <span class="hud b"><span>1/250</span><span>f/1.8</span><span>ISO 3200</span></span>}
    </span>
  )}

  {id === "peaking" && (
    <svg class="pk" viewBox={mark ? "0 0 120 100" : "0 0 600 100"} aria-label={word}>
      <text x="2" y="80" textLength={mark ? 114 : 594} lengthAdjust="spacingAndGlyphs">{word}</text>
    </svg>
  )}

  {id === "contact" && (
    <span class="cs">
      <span class="strip">
        {(mark ? ["o"] : ["", "oscar", "shoots", ""]).map((w, i) => <span class:list={["fr", { pick: mark || i === 2 }]}><span>{w}</span></span>)}
      </span>
      <svg class="ring" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true"><path d="M8 34 C 6 10, 60 2, 88 16 C 104 26, 92 54, 52 56 C 20 58, 4 46, 12 26" /></svg>
    </span>
  )}

  {id === "pass" && (
    <span class="pass">
      <i class="slot" />
      <span class="band">{mark ? "" : "ALL ACCESS"}</span>
      <span class="who">{mark ? "OS" : <>OSCAR<br />SHOOTS</>}</span>
      {!mark && <span class="role">PHOTO + VIDEO</span>}
    </span>
  )}

  {id === "slate" && (
    <span class="slate">
      <span class="clap" />
      {mark ? <span class="body s" /> : <span class="body"><span>PROD</span><b>OSCAR SHOOTS</b><span>SCENE</span><b>01</b><span>TAKE</span><b>01</b></span>}
    </span>
  )}

  {id === "rolling" && (
    <span class="roll">
      <span class="wm base">{word}</span>
      {Array.from({ length: slices }, (_, i) => (
        <span class:list={["wm", "sl", { ac: i === slices - 2 }]} aria-hidden="true" style={`clip-path:inset(${(i * 100) / slices}% 0 ${100 - ((i + 1) * 100) / slices}% 0);transform:translateX(${(i * 0.035).toFixed(3)}em)`}>{word}</span>
      ))}
    </span>
  )}

  {id === "burst" && <span class="wm bst">{mark ? "os" : <>oscar <span class="echo">shoots</span></>}</span>}

  {id === "bracket" && (
    mark
      ? <span class="brk3"><i /><i /><i /></span>
      : <span class="brk">{["−1", "0", "+1"].map((ev, i) => <span class:list={["ev", `e${i}`]}><small>{ev}</small><span class="wm sm">oscar shoots</span></span>)}</span>
  )}

  {id === "aperture" && (
    <span class="ap">
      <svg class="apx" viewBox="-50 -50 100 100" aria-hidden="true"><circle r={aperture.R} /><polygon points={aperture.hex} /><path d={aperture.blades} /></svg>
      {!mark && <span class="wm">scar shoots</span>}
    </span>
  )}
</span>
