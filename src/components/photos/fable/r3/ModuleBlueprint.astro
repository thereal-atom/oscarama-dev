---
import Switcher from "@/components/photos/Switcher.astro";
import Viewer from "@/components/photos/fable/r3/Viewer.astro";
import Dim from "@/components/photos/fable/r3/Dim.astro";
import TitleBlock from "@/components/photos/fable/r3/TitleBlock.astro";
import { palettes, vars } from "@/components/photos/fable/r3/blueprint";
import { events, contact, clients } from "@/data/photos";

import type { SchemeId } from "@/components/photos/schemes";

interface Props { scheme: SchemeId }
const P = palettes[Astro.props.scheme];
import { quotes, mixed, shotIndex } from "@/components/photos/fable/derive";

const picks = mixed.slice(0, 24);
type Size = [number, number];
type Box = { c: number; r: number; w: number; h: number };

/** first-fit packer on a square module: every photo lands on whole cells; cells nothing fits in stay open */
function pack(cols: number, pref: (i: number, portrait: boolean) => Size[]) {
  const occ: boolean[][] = [];
  const free = (r: number, c: number) => !occ[r]?.[c];
  const fits = (r: number, c: number, w: number, h: number) => {
    if (c + w > cols) return false;
    for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) if (!free(r + y, c + x)) return false;
    return true;
  };
  const mark = (r: number, c: number, w: number, h: number) => { for (let y = 0; y < h; y++) { occ[r + y] ??= []; for (let x = 0; x < w; x++) occ[r + y][c + x] = true; } };
  const out: Box[] = [], holes: Box[] = [];
  let r = 0, c = 0;
  picks.forEach((s, i) => {
    for (;;) {
      while (!free(r, c)) { c++; if (c >= cols) { c = 0; r++; } }
      const cand = pref(i, s.height > s.width).find(([w, h]) => fits(r, c, w, h));
      if (cand) { mark(r, c, cand[0], cand[1]); out.push({ r, c, w: cand[0], h: cand[1] }); break; }
      mark(r, c, 1, 1); holes.push({ r, c, w: 1, h: 1 });
    }
  });
  const rows = occ.length;
  for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) if (free(y, x)) { mark(y, x, 1, 1); holes.push({ r: y, c: x, w: 1, h: 1 }); }
  // merge neighbouring open cells along a row
  holes.sort((a, b) => a.r - b.r || a.c - b.c);
  const merged: Box[] = [];
  for (const h of holes) { const l = merged[merged.length - 1]; if (l && l.r === h.r && l.c + l.w === h.c) l.w++; else merged.push({ ...h }); }
  return { out, holes: merged, rows };
}
const pm = pack(6, (i, p) => p
  ? ([[[4, 5], [2, 3], [2, 2]], [[2, 3], [2, 2]]] as Size[][])[i % 2]
  : ([[[6, 4], [3, 2], [2, 2]], [[3, 2], [2, 2]], [[4, 3], [3, 2], [2, 2]], [[3, 2], [2, 2]]] as Size[][])[i % 4]);
const pd = pack(16, (i, p) => p
  ? ([[[4, 5], [3, 4], [2, 3], [2, 2]], [[3, 4], [2, 3], [2, 2]]] as Size[][])[i % 2]
  : ([[[9, 6], [6, 4], [3, 2], [2, 2]], [[3, 2], [2, 2]], [[6, 4], [3, 2], [2, 2]], [[4, 3], [3, 2], [2, 2]], [[3, 2], [2, 2]]] as Size[][])[i % 5]);
const area = (b: Box) => `${b.r + 1}/${b.c + 1}/span ${b.h}/span ${b.w}`;
const pad = (n: number) => String(n).padStart(2, "0");

const lead = events[2].shots[4]; // a portrait frame beside the headline
const L = Array.from({ length: 17 }, (_, i) => i);

const links = [
  { href: "#work", t: "Work", d: "24 selects" },
  { href: "#get", t: "What you get", d: "photo · video · portraits" },
  { href: "#book", t: "Book", d: "pick a date, send a message" },
  { href: "#contact", t: "Contact", d: "email + socials" },
];
const get = [
  { n: "01", t: "Event photography", d: "Conferences, hackathons, demo nights, launches. Candid over posed — the room as it actually felt." },
  { n: "02", t: "Recap video", d: "A 60–90 second reel cut for socials, plus a longer cut if you want one for the website." },
  { n: "03", t: "Speaker portraits", d: "Speakers, founders, your team. A mini studio in a corner of the venue, or whatever light we've got." },
  { n: "04", t: "Quick selects", d: "A first batch of the best frames lands fast, so you can post while people are still talking about it." },
];
const kinds = ["hackathon", "demo night", "conference", "launch", "panel", "meetup", "offsite", "something else"];
const needs = ["photos", "recap video", "portraits"];
const ig = `https://instagram.com/${contact.instagram}`, tw = `https://x.com/${contact.x}`;
---

<!--
  FABLE R3 / 2 — "MODULE", drawn as a BLUEPRINT. One component, one palette per scheme (see blueprint.ts),
  served at /photos/fable-2-blueprint/<scheme>:
    blue-light    classic cyanotype: Prussian-blue ground · white line work · pale-blue lettering
    orange-dark   ink ground · orange line work · paper lettering
    orange-light  whiteprint: paper ground · orange line work · ink lettering
    green         green-ground print · ink line work + lettering
  Same structure, content and interactions as 2-orange-dark; the graphic language moves to a technical drawing:
    · drafting paper: a fine 1/4-module grid under the module rules, a faint paper tooth
    · dimension lines (Dim.astro) with real, live px figures: every section's width, the headline cap-height
    · balloons: section letters, photo item numbers; one leader-line callout onto the hero frame
    · centre marks on the frames (edge ticks; a full mark on hover and on the hero frame)
    · open cells: section hatching, registration targets, cell co-ordinates
    · hatched outline lettering for section titles (the hero stays solid)
    · a revision cloud round "your logo", and a drawing title block (TitleBlock.astro) closing the sheet
  Original concept notes follow.

  FABLE R3 / 2 — "MODULE" (the grid, exposed)
  Concept: no metaphor — just a Swiss grid with the construction lines left on. One square module (1/6 of the
           screen on a phone, 1/16 on desktop) runs the whole page: rows are numbered down a paper margin,
           columns across a sticky ruler, and every piece — headline caps, photos, links, logos, quotes, form
           fields, calendar days — sits on whole cells. The headline's cap-height is exactly one (or two) modules.
  Motion:  one thing only — the grid draws itself. Each section's column rules wipe in as you reach it, and the
           column count reconfigures per section (6 → 3 → 2 → 7 for the calendar…); the ruler re-divides with it.
  Palette: see blueprint.ts
  Fonts:   Inter Tight (900/800) · Geist Mono · Geist Pixel (numerals, calendar, the footer email)
  Signature interactions:
           1. grid lines draw in per section; the sticky column ruler re-divides to the section's column count
           2. selects are packed onto the module (6×4, 3×2, 4×5, 2×3… cells); open cells stay open and show the grid
           3. booking is a grid too: a 7-column calendar where each day is a cell, tiles and inputs on whole cells
           4. instant viewer + mechanical shutter on any frame
-->
<!doctype html>
<html lang="en" style={vars(P)} data-bp={P.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={P.ground} />
    <title>Oscar shoots events — photo + video for tech events, London</title>
    <meta name="description" content="Freelance event photography and recap video for hackathons, demo nights, conferences and launches. London, will travel." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://picsum.photos" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;800;900&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <style is:inline>
      @font-face{font-family:"Geist Pixel";src:url("https://cdn.jsdelivr.net/npm/geist@1.9.2/dist/fonts/geist-pixel/GeistPixel-Square.woff2") format("woff2");font-display:swap}
      :root{--base:6;--gut:22px;--pad:8px;--inset:2px;
        --sans:"Inter Tight","Helvetica Neue",Helvetica,Arial,sans-serif;--mono:"Geist Mono",ui-monospace,monospace;--px:"Geist Pixel","Geist Mono",monospace}
      @media (min-width:900px){:root{--base:16;--gut:36px;--pad:12px;--inset:3px}}
      *{box-sizing:border-box}
      html{background:var(--paper);scroll-behavior:smooth;-webkit-text-size-adjust:100%}
      body{margin:0;background:var(--paper);color:var(--ink);font:500 15px/1.4 var(--sans);overflow-x:clip;-webkit-font-smoothing:antialiased}
      a{color:inherit;text-decoration:none}
      p,h1,h2,h3,figure,blockquote{margin:0}
      ::selection{background:var(--blue);color:var(--paper)}
      :focus-visible{outline:3px solid var(--blue);outline-offset:-3px}
      .mono{font:500 11px/1.35 var(--mono);text-transform:uppercase;letter-spacing:.04em}

      /* ── the module ── */
      .page{container-type:inline-size;position:relative}
      .page>*,.body>*{--r:calc((100cqw - var(--gut)) / var(--base))}
      @supports (width:round(down,10.5px,1px)){.page>*,.body>*{--r:round(down,calc((100cqw - var(--gut)) / var(--base)),1px)}}
      .body{position:relative}
      .g{--cols:var(--cm);width:calc(var(--r) * var(--base));margin-left:auto;position:relative;display:grid;
        grid-template-columns:repeat(var(--cols),minmax(0,1fr));grid-auto-rows:var(--r);color:var(--fg);--cw:calc(var(--r) * var(--base) / var(--cols))}
      /* drafting paper: fine quarter-module grid + a faint tooth, under every cell */
      .g,.c,.q .in,.mailw{background-color:var(--bg);
        background-image:linear-gradient(var(--minor) 1px,transparent 1px),linear-gradient(90deg,var(--minor) 1px,transparent 1px),var(--tooth);
        background-size:100% calc(var(--r) / 4),calc(var(--cw) / 4) 100%,180px 180px}
      @media (min-width:900px){.g{--cols:var(--cd)}}
      .t-paper{--bg:var(--paper);--fg:var(--ink);--line:var(--p-line);--minor:var(--p-minor);--hi:var(--blue);--on:var(--paper)}
      .t-ink{--bg:var(--a-bg);--fg:var(--a-fg);--line:var(--a-line);--minor:var(--a-minor);--hi:var(--a-hi);--on:var(--a-bg)}
      .t-blue{--bg:var(--s-bg);--fg:var(--s-fg);--line:var(--s-line);--minor:var(--s-minor);--hi:var(--s-hi);--on:var(--s-bg)}
      /* row rules */
      .g::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(var(--line) 1px,transparent 1px) 0 0/100% var(--r)}
      /* column rules (drawn) */
      .vl{position:absolute;inset:0;overflow:hidden;pointer-events:none}
      .vl i{position:absolute;top:0;bottom:0;width:1px;background:var(--line);left:calc(var(--i) * 100% / var(--cols));transform-origin:top}
      .js .vl i{transform:scaleY(0);transition:transform 1s cubic-bezier(.3,.7,.1,1);transition-delay:calc(var(--i) * 40ms)}
      .js .g::before{clip-path:inset(0 100% 0 0);transition:clip-path 1s cubic-bezier(.3,.7,.1,1)}
      .js .g.in .vl i{transform:none}
      .js .g.in::before{clip-path:inset(0)}
      .g>:not(.vl),.g .cap{position:relative;z-index:1;min-width:0;grid-area:var(--am)}
      @media (min-width:900px){.g>:not(.vl),.g .cap{grid-area:var(--ad,var(--am))}}
      [data-snap]>.in{display:block}
      @media (max-width:899px){.dk{display:none !important}}
      @media (min-width:900px){.mo{display:none !important}}
      /* a cell with something in it: covers the rules inside, keeps its own top/left rule */
      .c{box-shadow:inset 1px 0 var(--line),inset 0 1px var(--line);padding:var(--pad);display:block}
      .fill{background:var(--hi);color:var(--on);box-shadow:inset 1px 0 var(--bg)}
      a.c,button.c,label.c{transition:background-color .1s,color .1s;cursor:pointer}
      a.c:hover,a.c:focus-visible,button.c:hover{background:var(--hi);color:var(--on)}
      a.fill:hover,a.fill:focus-visible,button.fill:hover{background:var(--fg);color:var(--bg)}
      .lab{display:flex;justify-content:space-between;align-items:flex-end;gap:10px;background:none;box-shadow:none}
      .lab b{font-weight:500;color:var(--hi)}
      /* display type: cap-height = k modules, sitting exactly on the row rules */
      .cap{font:900 calc(var(--r) * 1.3755 * var(--k,1))/calc(var(--r) * var(--k,1)) var(--sans);letter-spacing:-.04em;text-transform:uppercase;white-space:nowrap;padding-left:.035em;color:var(--hi);display:block}
      @media (min-width:900px){.cap{--k:2}}

      /* ── rulers ── */
      .rl{position:sticky;top:0;z-index:40;height:18px;background:var(--paper);color:var(--blue);display:flex;border-bottom:1px solid var(--blue);font:500 9px/17px var(--mono)}
      .rl b{flex:0 0 calc(100cqw - var(--r) * var(--base));font-weight:500;text-align:center;background:var(--blue);color:var(--paper)}
      .rl i{flex:1 1 0;min-width:0;overflow:hidden;font-style:normal;padding-left:3px;box-shadow:inset 1px 0 var(--blue);white-space:nowrap;transition:flex-grow .6s cubic-bezier(.3,.7,.1,1)}
      .rl i.off{flex-grow:0;padding:0;box-shadow:none}
      .rr{position:absolute;left:0;top:0;bottom:0;width:calc(100cqw - var(--r) * var(--base));overflow:hidden;color:var(--blue);font:500 8px/1 var(--mono);pointer-events:none}
      .rr span{display:block;height:var(--r);padding:3px 3px 0 0;text-align:right}
      @media (min-width:900px){.rr{font-size:9px}.rr span{padding:4px 6px 0 0}}

      /* ── hero ── */
      .brand{display:flex;flex-direction:column;justify-content:space-between}
      .brand b{font:900 17px/1 var(--sans);letter-spacing:-.02em}
      .soc{display:flex;align-items:flex-end;white-space:nowrap}
      .lede{display:flex;align-items:flex-end;text-transform:none;letter-spacing:0;font-size:12px}
      .lk{display:flex;align-items:stretch;padding:0}
      .lk .n{flex:0 0 var(--r);padding:var(--pad);color:var(--blue)}
      .lk .t{flex:1;font:800 clamp(26px,8.4cqw,40px)/.95 var(--sans);letter-spacing:-.035em;text-transform:uppercase;display:flex;align-items:center;white-space:nowrap}
      .lk .a{flex:0 0 var(--r);display:grid;place-items:center;font:400 24px/1 var(--px);box-shadow:inset 1px 0 var(--line)}
      .lk .d{display:none}
      .lk .m{flex:1;display:flex;align-items:center;min-width:0}
      .lk:hover .n,.lk:focus-visible .n{color:inherit}
      @media (min-width:900px){
        .lk{flex-direction:column;justify-content:space-between;padding:var(--pad)}
        .lk .n{flex:none;padding:0;display:flex;justify-content:space-between}
        .lk .t{flex:none;font-size:clamp(34px,3.5cqw,56px);white-space:normal;align-items:flex-end;max-width:6em}
        .lk .a{display:none}
        .lk .m{flex:none;display:block}
        .lk .d{display:block;opacity:.6;text-transform:none;letter-spacing:0;margin-top:6px}
        .lede{font-size:13px}
      }

      /* ── photos on the module ── */
      .ph{display:block;margin:var(--inset);overflow:hidden;background:var(--a-bg);cursor:zoom-in;color:var(--paper)}
      .ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
      .ph .no{position:absolute;left:5px;top:5px;width:19px;height:19px;border-radius:50%;display:grid;place-items:center;background:var(--paper);color:var(--blue);box-shadow:0 0 0 1px var(--blue);font:500 8.5px/1 var(--mono);z-index:2}
      .ph .cp{position:absolute;left:0;right:0;bottom:0;background:var(--blue);color:var(--paper);padding:5px 6px;opacity:0;transition:opacity .1s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:10px}
      .ph:hover .cp,.ph:focus-visible .cp{opacity:1}
      .ph:focus-visible{outline-offset:2px}
      .hole{display:flex;align-items:flex-end;padding:5px;color:var(--blue);font:500 8px/1.2 var(--mono);letter-spacing:.04em}
      .hole.x{margin:var(--inset);background:repeating-linear-gradient(-45deg,var(--blue) 0 1px,transparent 1px 7px);box-shadow:inset 0 0 0 1px var(--blue)}
      .hole.p{align-items:center;justify-content:center;font-size:0;background:
        linear-gradient(var(--blue),var(--blue)) 50% 50%/1px 30px no-repeat,linear-gradient(var(--blue),var(--blue)) 50% 50%/30px 1px no-repeat,
        radial-gradient(circle closest-side at 50% 50%,transparent 0 8px,var(--blue) 8.2px 9.2px,transparent 9.6px) 50% 50%/22px 22px no-repeat}

      /* ── text blocks ── */
      .say{font:800 clamp(27px,4.6cqw,66px)/1.02 var(--sans);letter-spacing:-.03em;text-wrap:balance}
      .say em{font-style:normal;color:var(--blue)}
      .t-ink .say em{color:inherit;box-shadow:inset 0 -.09em var(--a-em)}
      .body2{font:400 13px/1.55 var(--mono)}
      .sv{display:flex;flex-direction:column;justify-content:space-between;gap:6px}
      .sv .n{font:400 clamp(40px,11cqw,150px)/.8 var(--px);color:var(--blue)}
      .sv h3{font:800 clamp(24px,2.6cqw,40px)/1 var(--sans);letter-spacing:-.03em;text-transform:uppercase;margin-bottom:6px}
      .sv p{font:400 12px/1.5 var(--mono);max-width:40ch}
      .sv:hover,.sv:active{background:var(--blue);color:var(--paper)}
      .sv:hover .n,.sv:active .n{color:var(--paper)}
      @media (max-width:899px){.sv{flex-direction:row;justify-content:flex-start;gap:14px}.sv .n{flex:0 0 calc(var(--r) * 1.5 - var(--pad))}}
      .logo{display:grid;place-items:center;gap:8px;align-content:center;text-align:center}
      .logo img{height:clamp(40px,5cqw,72px);width:auto;max-width:60%;object-fit:contain;display:block}
      .you{display:flex;flex-direction:column;justify-content:space-between}
      .you b{font:400 clamp(22px,2.4cqw,34px)/1 var(--px)}
      .q{display:flex;align-items:stretch}
      .q.r{flex-direction:row-reverse}
      .q .mk{flex:0 0 var(--r);height:var(--r);background:var(--blue);color:var(--paper);font:400 calc(var(--r) * 1.5)/1.25 var(--px);text-align:center;overflow:hidden}
      .q .in{flex:0 0 calc(var(--r) * var(--qw));max-width:calc(100% - var(--r));box-shadow:inset 1px 0 var(--line),inset 0 1px var(--line),inset -1px 0 var(--line);padding:var(--pad) var(--pad) calc(var(--pad) + 4px)}
      .q blockquote{font:800 clamp(25px,3.7cqw,54px)/1.03 var(--sans);letter-spacing:-.03em;text-wrap:balance}
      .q figcaption{margin-top:14px;display:flex;flex-wrap:wrap;gap:2px 14px;color:var(--blue)}
      .q{--qw:5}@media (min-width:900px){.q{--qw:9}}

      /* ── booking ── */
      .bk{background:var(--s-bg)}
      @media (min-width:900px){.bk{display:flex;width:calc(var(--r) * 16);margin-left:auto}.bk .g{margin:0;--cw:var(--r)}.bk .g7{width:calc(var(--r) * 7)}.bk .g9{width:calc(var(--r) * 9)}}
      #cal-grid{display:contents}
      #cal-grid>*,.cal-b{position:relative;z-index:1;display:grid;place-items:center;font:400 clamp(17px,1.6cqw,24px)/1 var(--px);font-style:normal}
      #cal-grid span{font:500 10px/1 var(--mono);opacity:.75;align-items:end;padding-bottom:6px}
      #cal-grid button,.cal-b{border:0;border-radius:0;background:none;color:inherit;cursor:pointer;padding:0;margin:0}
      #cal-grid button:hover:not(:disabled),.cal-b:hover:not(:disabled){background:var(--s-hov-bg);color:var(--s-hov-fg)}
      #cal-grid button:disabled,.cal-b:disabled{opacity:.3;cursor:default}
      #cal-grid button[aria-pressed="true"]{background:var(--s-key-bg);color:var(--s-key-hi)}
      .cal-t{display:grid;place-items:center;font:400 clamp(19px,1.9cqw,26px)/1 var(--px);text-transform:uppercase}
      .tile{position:relative;padding:0;display:block}
      .tile input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
      .tile span{position:absolute;inset:0;display:flex;align-items:flex-end;padding:var(--pad);font:400 clamp(14px,1.3cqw,18px)/1.05 var(--px);text-transform:uppercase}
      .tile:hover span{background:var(--s-hov-bg);color:var(--s-hov-fg)}
      .tile input:checked+span{background:var(--s-key-bg);color:var(--s-key-hi)}
      .tile input:focus-visible+span{outline:3px solid var(--s-key-bg);outline-offset:-5px}
      .fld{padding:0}
      .fld input,.fld textarea{width:100%;height:100%;border:0;border-radius:0;background:var(--s-key-bg);color:var(--s-key-fg);font:500 17px/1.3 var(--sans);padding:var(--pad) calc(var(--pad) + 2px);display:block;resize:none;box-shadow:inset 1px 0 var(--s-bg),inset 0 1px var(--s-bg)}
      .fld input::placeholder,.fld textarea::placeholder{color:var(--s-key-fg);opacity:.5}
      .fld input:focus,.fld textarea:focus{outline:3px solid var(--s-key-fg);outline-offset:-3px}
      .send{border:0;border-radius:0;font:900 clamp(34px,4.4cqw,64px)/1 var(--sans);letter-spacing:-.04em;text-transform:uppercase;display:flex;justify-content:space-between;align-items:flex-end;text-align:left;background:var(--s-key-bg);color:var(--s-key-hi);padding:var(--pad) calc(var(--pad) + 2px)}
      .send:hover,.send:focus-visible{background:var(--s-hov-bg);color:var(--s-hov-fg)}
      .fine{font:400 11px/1.45 var(--mono);background:none;box-shadow:none}
      .fine a{text-decoration:underline}

      /* ── footer ── */
      .mailw{display:flex;align-items:center;padding:0 var(--pad);box-shadow:inset 0 1px var(--line)}
      .mail{font:400 30px/1 var(--px);color:var(--blue);white-space:nowrap;letter-spacing:-.03em}
      .mailw:hover,.mailw:focus-visible{background:var(--blue)}
      .mailw:hover .mail,.mailw:focus-visible .mail{color:var(--paper)}
      .big{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;font:900 clamp(32px,5cqw,84px)/.9 var(--sans);letter-spacing:-.04em;text-transform:uppercase}
      .big small{font:500 11px/1.2 var(--mono);letter-spacing:.02em;text-transform:none}

      /* ── blueprint pieces ── */
      /* ruler graduations */
      .rl i{background:linear-gradient(90deg,var(--blue) 1px,transparent 1px) 0 100%/25% 4px repeat-x}
      .rr span{background:linear-gradient(var(--blue) 1px,transparent 1px) 100% 0/4px 25% repeat-y}
      /* dimension line */
      .dim{display:flex;align-items:center;gap:5px;color:var(--hi);font:500 8px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;pointer-events:none}
      .dim b{font-weight:500}.dim em{font-style:normal}
      .dim .dl{flex:1 1 0;position:relative;background:currentColor;opacity:.8}
      .dim .dl::before,.dim .dl::after{content:"";position:absolute;background:currentColor}
      .dim.h .dl{height:1px}
      .dim.h .dl::before{top:-6px;width:1px;height:13px}
      .dim.h .dl::after{top:-2.5px;width:8px;height:6px}
      .dim.h .dl:first-child::before,.dim.h .dl:first-child::after{left:0}
      .dim.h .dl:last-child::before,.dim.h .dl:last-child::after{right:0}
      .dim.h .dl:first-child::after{clip-path:polygon(0 50%,100% 0,100% 100%)}
      .dim.h .dl:last-child::after{clip-path:polygon(100% 50%,0 0,0 100%)}
      .dim.v{flex-direction:column}
      .dim.v .dl{width:1px}
      .dim.v b{writing-mode:vertical-rl;transform:rotate(180deg)}
      .dim.v .dl::before{left:-6px;height:1px;width:13px}
      .dim.v .dl::after{left:-2.5px;height:8px;width:6px}
      .dim.v .dl:first-child::before,.dim.v .dl:first-child::after{top:0}
      .dim.v .dl:last-child::before,.dim.v .dl:last-child::after{bottom:0}
      .dim.v .dl:first-child::after{clip-path:polygon(50% 0,100% 100%,0 100%)}
      .dim.v .dl:last-child::after{clip-path:polygon(50% 100%,0 0,100% 0)}
      /* a section's overall width, across the top of its label row */
      .lab{position:relative}
      .lab>.dim{position:absolute;left:0;right:0;top:11px}
      @media (min-width:900px){.dim{font-size:9px}.lab>.dim{top:17px}}
      /* headline cap-height */
      .d-cap{justify-self:center}
      @media (min-width:900px){.d-cap{justify-self:end;margin-right:calc(var(--r) * .2)}}
      /* balloons */
      .bal{display:inline-grid;place-items:center;width:17px;height:17px;border-radius:50%;box-shadow:inset 0 0 0 1px currentColor;font:500 9px/1 var(--mono);font-style:normal;letter-spacing:0;margin-right:7px;vertical-align:baseline;color:var(--hi)}
      /* leader-line callout onto the hero frame */
      .call{color:var(--hi);pointer-events:none;z-index:2 !important;font:500 9px/1.35 var(--mono);letter-spacing:.05em;text-transform:uppercase}
      .call svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
      .call .hd{position:absolute;left:8px;bottom:calc(72% + 5px)}
      .call .tx{position:absolute;left:8px;top:calc(28% + 6px);color:var(--fg);opacity:.85}
      .call .dot{position:absolute;right:-10px;top:calc(64% - 3.5px);width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 0 2px var(--paper)}
      /* centre marks on the frames */
      .ph::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;--ck:rgba(255,255,255,.9);
        background:linear-gradient(var(--ck),var(--ck)) 50% 0/1px 8px no-repeat,linear-gradient(var(--ck),var(--ck)) 50% 100%/1px 8px no-repeat,
          linear-gradient(var(--ck),var(--ck)) 0 50%/8px 1px no-repeat,linear-gradient(var(--ck),var(--ck)) 100% 50%/8px 1px no-repeat,
          linear-gradient(var(--ck),var(--ck)) 50% 50%/1px 0 no-repeat,linear-gradient(var(--ck),var(--ck)) 50% 50%/0 1px no-repeat;
        transition:background-size .18s}
      .ph.lead::after,.ph:hover::after,.ph:focus-visible::after{background-size:1px 8px,1px 8px,8px 1px,8px 1px,1px 17px,17px 1px}
      /* hatched outline lettering for section titles */
      /* (the outline is a solid copy run through an erode filter, so overlapping letters and font contours merge cleanly;
         if the filter is unsupported the copy just shows solid) */
      .cap.ht{color:transparent;background:repeating-linear-gradient(-45deg,var(--hi) 0 1.5px,transparent 1.5px 7px);-webkit-background-clip:text;background-clip:text}
      .cap.ht::before{content:attr(data-t);position:absolute;left:0;top:0;padding-left:inherit;color:var(--hi);filter:url(#bp-ring);pointer-events:none}
      @media (max-width:899px){.cap.ht{background-image:repeating-linear-gradient(-45deg,var(--hi) 0 1.2px,transparent 1.2px 5px)}.cap.ht::before{filter:url(#bp-ring-s)}}
      /* revision cloud */
      .you{border:11px solid transparent;border-image:var(--cloud) 12/11px round;padding:calc(var(--pad) - 6px) calc(var(--pad) - 2px);background-clip:border-box;box-shadow:none}
      /* title block */
      .tb{display:flex;flex-direction:column;justify-content:flex-start;gap:9px;padding:8px var(--pad) 8px;background:var(--bg);box-shadow:inset 1px 0 var(--blue),inset 0 1px var(--blue),inset 0 -1px var(--blue);overflow:hidden}
      .tb>span{font-size:8px;color:var(--blue);opacity:.85}
      .tb b{font:800 clamp(15px,1.5cqw,21px)/1 var(--sans);letter-spacing:-.02em;text-transform:uppercase;white-space:nowrap}
      .tb b i{font-style:normal}
      .tb small{font-size:8.5px;opacity:.7;white-space:nowrap;margin-top:-3px}
      .tb-p b{font-size:clamp(19px,1.9cqw,27px);color:var(--blue)}
      .tb-rev{position:relative;width:26px;height:23px;display:block;color:var(--blue)}
      .tb-rev svg{position:absolute;inset:0;width:100%;height:100%}
      .tb-rev i{position:absolute;inset:8px 0 0;text-align:center;font:500 10px/1 var(--mono)}
      a.tb-top{transition:background-color .1s,color .1s}
      a.tb-top:hover,a.tb-top:focus-visible{background:var(--blue);color:var(--paper)}
      a.tb-top:hover span,a.tb-top:focus-visible span{color:inherit}
      .tb:nth-last-child(1 of .tb){box-shadow:inset 1px 0 var(--blue),inset 0 1px var(--blue),inset 0 -1px var(--blue),inset -1px 0 var(--blue)}
      @media (max-width:899px){.tb{padding:6px var(--pad);gap:6px}.tb small{display:none}.tb-p small{display:block}}

      .cta{position:fixed;left:0;bottom:calc(10px + env(safe-area-inset-bottom));z-index:60;background:var(--blue);color:var(--paper);padding:11px 13px 10px;transform:translateX(-101%);transition:transform .2s;box-shadow:0 0 0 1px var(--paper)}
      .cta.on{transform:none}
      .cta:hover{background:var(--ink)}
      [id]{scroll-margin-top:18px}
      @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}.js .vl i,.js .g::before,.rl i,.cta,.ph::after{transition:none}}
    </style>
  </head>
  <body>
    <div class="page">
      <div class="rl mono" id="rl" aria-hidden="true"><b id="rl-s">A</b>{L.slice(0, 16).map((i) => <i>{pad(i + 1)}</i>)}</div>
      <div class="body" id="body">
        <div class="rr" id="rr" aria-hidden="true"></div>

        <header class="g t-paper" id="top" data-sec="A" style="--cm:6;--cd:16">
          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          <a class="c brand" href="#top" style="--am:1/1/span 1/span 2;--ad:1/1/span 1/span 3"><b>OSCAR</b><span class="mono">photo + video</span></a>
          <p class="c mono lede dk" style="--ad:1/4/span 1/span 5">Event photography + recap video for tech events. {contact.basedIn}, will travel.</p>
          <a class="c fill soc mono" href={ig} target="_blank" rel="noopener" style="--am:1/3/span 1/span 2;--ad:1/11/span 1/span 2">Instagram ↗</a>
          <a class="c fill soc mono" href={tw} target="_blank" rel="noopener" style="--am:1/5/span 1/span 1;--ad:1/13/span 1/span 1">X ↗</a>
          <a class="c soc mono" href={`mailto:${contact.email}`} style="--am:1/6/span 1/span 1;--ad:1/14/span 1/span 1">Mail</a>
          <a class="c soc mono dk" href="#book" style="--ad:1/15/span 1/span 2">Book a shoot →</a>
          <h1 style="display:contents" aria-label="Oscar shoots events.">
            {["Oscar", "shoots", "events."].map((t, i) => <span class="cap" aria-hidden="true" style={`--am:${2 + i}/1/span 1/span 6;--ad:${2 + i * 2}/1/span 2/span 12`}>{t}</span>)}
          </h1>
          <p class="c mono lede mo" style="--am:5/1/span 1/span 6">Event photography + recap video for hackathons, demo nights and launches. {contact.basedIn}, will travel.</p>
          {links.map((l, i) => (
            <a class="c lk" href={l.href} style={`--am:${6 + i}/1/span 1/span 6;--ad:8/${1 + i * 3}/span 2/span 3`}>
              <span class="n mono"><span>{pad(i + 1)}</span><span class="dk" aria-hidden="true">↓</span></span>
              <span class="m"><span class="t">{l.t}</span><span class="d mono">{l.d}</span></span>
              <span class="a" aria-hidden="true">↓</span>
            </a>
          ))}
          <p class="c mono lede dk" style="--ad:8/13/span 2/span 4">Hackathons, demo nights, conferences, launches. I turn up, stay out of the way, and you get pictures people actually post.</p>
          <Dim dir="v" class="d-cap" measure="size" label="cap ht " style="--am:2/6/span 1/span 1;--ad:2/10/span 2/span 1" />
          <a class="ph lead" href={lead.src} data-shot={shotIndex.get(lead.id)} aria-label={`open photo: ${lead.caption}`} style="--am:10/1/span 4/span 6;--ad:2/13/span 6/span 4">
            <img src={lead.src} alt={lead.caption} width={lead.width} height={lead.height} decoding="async" fetchpriority="high" />
            <span class="cp mono">{lead.caption} · {events[2].name}</span>
          </a>
          <div class="call dk" aria-hidden="true" style="--ad:2/11/span 2/span 2">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none"><polyline points="4,28 62,28 100,64" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" /></svg>
            <span class="hd"><i class="bal">1</i>Detail 1 · 4 × 6 mod</span>
            <span class="tx">{lead.caption}<br />{events[2].name}</span>
            <i class="dot"></i>
          </div>
        </header>

        <section class="g t-paper" id="work" data-sec="B" style="--cm:6;--cd:16">
          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          <p class="c lab mono" style="--am:1/1/span 1/span 6;--ad:1/1/span 1/span 16"><Dim measure="sec" /><span><i class="bal">B</i><span class="dk">Section B–B · </span>Selects</span><b>24 frames · tap any</b></p>
          <h2 class="cap ht" data-t="Selects" style="--am:2/1/span 1/span 6;--ad:2/1/span 2/span 11">Selects</h2>
          <p class="c body2" data-snap style="--am:3/1/span var(--rs,2)/span 6;--ad:2/13/span 2/span 4"><span class="in">A few favourites from the last few months of hackathons, demo nights, launches and one river. Every frame sits on whole cells of the grid — tap one to open it.</span></p>
        </section>
        <section class="g t-paper" data-sec="B" aria-label="selected photos" style="--cm:6;--cd:16">
          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          {picks.map((s, i) => (
            <a class="ph" href={s.src} data-shot={shotIndex.get(s.id)} aria-label={`${s.caption} — ${s.event.name}`} style={`--am:${area(pm.out[i])};--ad:${area(pd.out[i])}`}>
              <img src={s.thumb} srcset={`${s.thumb} 533w, ${s.src} 1600w`} sizes={`(min-width:900px) ${(pd.out[i].w * 6.2).toFixed(0)}vw, ${(pm.out[i].w * 16).toFixed(0)}vw`} alt="" width={s.width} height={s.height} loading="lazy" decoding="async" />
              <span class="no">{pad(i + 1)}</span>
              <span class="cp mono">{s.caption} · {s.event.name}</span>
            </a>
          ))}
          {pm.holes.map((h, i) => <i class:list={["hole mo", ["x", "p", "", "x"][i % 4]]} style={`--am:${area(h)}`} aria-hidden="true">{["", "+", `R${pad(h.r + 1)} C${pad(h.c + 1)}`, ""][i % 4]}</i>)}
          {pd.holes.map((h, i) => <i class:list={["hole dk", ["x", "p", "", ""][i % 4]]} style={`--ad:${area(h)}`} aria-hidden="true">{["", "+", `R${pad(h.r + 1)} C${pad(h.c + 1)}`, "open cell"][i % 4]}</i>)}
        </section>

        <section class="g t-ink" id="about" data-sec="C" style="--cm:3;--cd:8">
          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          <p class="c lab mono" style="--am:1/1/span 1/span 3;--ad:1/1/span 1/span 8"><Dim measure="sec" /><span><i class="bal">C</i><span class="dk">Section C–C · </span>Who's holding the camera</span><b class="dk">3 → 8 columns</b></p>
          <p class="c say" data-snap style="--am:2/1/span var(--rs,7)/span 3;--ad:2/1/span var(--rs,4)/span 6"><span class="in" style="display:block">I'm Oscar. I shoot the events tech people actually go to — <em>hackathons</em> at hour 22, <em>demo nights</em> where the wifi holds, <em>launch parties</em>, panels, and founders in wetsuits.</span></p>
          <p class="c body2" data-snap style="--am:auto/1/span var(--rs,3)/span 3;--ad:2/7/span var(--rs,4)/span 2"><span class="in" style="display:block">I build things too, so I know which moments matter: the demo that lands, the room reacting, the hallway chat that turns into a company. I work quietly, I don't need a brief the length of a PRD, and you get pictures people actually want to post.</span></p>
        </section>

        <section class="g t-paper" id="get" data-sec="D" style="--cm:2;--cd:4">
          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          <p class="c lab mono" style="--am:1/1/span 1/span 2;--ad:1/1/span 1/span 4"><Dim measure="sec" /><span><i class="bal">D</i><span class="dk">Section D–D · </span>What you get</span><b>four things</b></p>
          <h2 style="display:contents" aria-label="What you get">
            <span class="cap ht mo" aria-hidden="true" data-t="What" style="--am:2/1/span 1/span 2">What</span>
            <span class="cap ht mo" aria-hidden="true" data-t="you" style="--am:3/1/span 1/span 2">you</span>
            <span class="cap ht mo" aria-hidden="true" data-t="get" style="--am:4/1/span 1/span 2">get</span>
            <span class="cap ht dk" aria-hidden="true" data-t="What you" style="--ad:2/1/span 2/span 4">What you</span>
            <span class="cap ht dk" aria-hidden="true" data-t="get" style="--ad:4/1/span 2/span 4">get</span>
          </h2>
          {get.map((s, i) => (
            <article class="c sv" style={`--am:${5 + i * 3}/1/span 3/span 2;--ad:6/${i + 1}/span 5/span 1`}>
              <span class="n">{s.n}</span>
              <div><h3>{s.t}</h3><p>{s.d}</p></div>
            </article>
          ))}
        </section>

        <section class="g t-ink" id="clients" data-sec="E" style="--cm:2;--cd:5">
          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          <p class="c lab mono" style="--am:1/1/span 1/span 2;--ad:1/1/span 1/span 5"><Dim measure="sec" /><span><i class="bal">E</i><span class="dk">Section E–E · </span>Shot for</span><b class="dk">2 → 5 columns</b></p>
          {clients.map((c, i) => <div class="logo" style={`--am:${2 + Math.floor(i / 2) * 2}/${(i % 2) + 1}/span 2/span 1;--ad:2/${i + 1}/span 2/span 1`}><img src={c.logo.src} alt={c.name} loading="lazy" style={P.alt.darkLogos ? "filter:brightness(0)" : undefined} /><span class="mono">{c.name}</span></div>)}
          <a class="c fill you" href="#book" style="--am:6/1/span 1/span 2;--ad:2/5/span 2/span 1"><span class="mono">next · rev</span><b>YOUR LOGO →</b></a>
        </section>

        <section class="g t-paper" data-sec="F" aria-label="testimonials" style="--cm:6;--cd:16">
          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          <p class="c lab mono" style="--am:1/1/span 1/span 6;--ad:1/1/span 1/span 16"><Dim measure="sec" /><span><i class="bal">F</i><span class="dk">Section F–F · </span>Said afterwards</span><b>{quotes.length} quotes</b></p>
          {quotes.map((q, i) => (
            <figure class:list={["q", { r: i % 2 }]} data-snap style={`--am:auto/1/span var(--rs,4)/span 6;--ad:auto/${i % 2 ? 6 : 1}/span var(--rs,3)/span ${i % 2 ? 11 : 10}`}>
              <span class="mk" aria-hidden="true">“</span>
              <div class="in">
                <blockquote>{q.text[0].toUpperCase() + q.text.slice(1)}.</blockquote>
                <figcaption class="mono"><span>— {q.by}</span><span>{q.event}</span></figcaption>
              </div>
            </figure>
          ))}
          <i style="--am:auto/1/span 1/span 6;--ad:auto/1/span 1/span 16" aria-hidden="true"></i>
        </section>

        <section id="book" aria-label="booking">
          <div class="g t-blue" data-sec="G" style="--cm:6;--cd:16">
            <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
            <p class="lab mono" style="--am:1/1/span 1/span 6;--ad:1/1/span 1/span 16;padding:var(--pad)"><Dim measure="sec" /><span><i class="bal">G</i><span class="dk">Section G–G · </span>Book</span><b>four steps · one minute</b></p>
            <h2 class="cap ht" data-t="Book" style="--am:2/1/span 1/span 6;--ad:2/1/span 2/span 8">Book</h2>
            <p class="say" data-snap style="--am:3/1/span var(--rs,3)/span 6;--ad:2/9/span 2/span 8;padding:var(--pad);font-size:clamp(20px,2.2cqw,32px);line-height:1.12"><span class="in" style="display:block">Pick a date, tap what it is, leave your email. I'll reply within a day with availability and a quote.</span></p>
          </div>
          <form class="bk" id="form" novalidate>
            <div class="g t-blue g7" data-sec="G" style="--cm:7;--cd:7">
              <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
              <p class="lab mono" style="--am:1/1/span 1/span 7;padding:var(--pad)"><Dim measure="sec" /><span>1 — When is it?</span><b id="cal-picked">optional</b></p>
              <button class="cal-b" type="button" id="cal-prev" aria-label="previous month" style="--am:2/1/span 1/span 1">←</button>
              <b class="cal-t" id="cal-title" aria-live="polite" style="--am:2/2/span 1/span 5"></b>
              <button class="cal-b" type="button" id="cal-next" aria-label="next month" style="--am:2/7/span 1/span 1">→</button>
              <div id="cal-grid"></div>
              <label class="tile" style="--am:10/1/span 1/span 7"><input type="checkbox" id="nodate" /><span>No date yet — just asking</span></label>
            </div>
            <div class="g t-blue g9" data-sec="G" style="--cm:6;--cd:9">
              <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
              <p class="lab mono" style="--am:auto/1/span 1/span 6;--ad:auto/1/span 1/span 9;padding:var(--pad)"><span>2 — What is it?</span><b>pick one</b></p>
              {kinds.map((k) => <label class="tile" style="--am:auto/auto/span 1/span 3"><input type="radio" name="kind" value={k} /><span>{k}</span></label>)}
              <i class="dk" style="--ad:auto/auto/span 1/span 3" aria-hidden="true"></i>
              <p class="lab mono" style="--am:auto/1/span 1/span 6;--ad:auto/1/span 1/span 9;padding:var(--pad)"><span>3 — What do you need?</span><b>pick any</b></p>
              {needs.map((k, i) => <label class="tile" style="--am:auto/auto/span 1/span 2;--ad:auto/auto/span 1/span 3"><input type="checkbox" name="need" value={k} checked={i === 0} /><span>{k}</span></label>)}
              <p class="lab mono" style="--am:auto/1/span 1/span 6;--ad:auto/1/span 1/span 9;padding:var(--pad)"><span>4 — Where do I reply?</span></p>
              <div class="fld" style="--am:auto/1/span 1/span 6;--ad:auto/1/span 1/span 4"><input type="text" name="name" placeholder="Your name" autocomplete="name" aria-label="your name" /></div>
              <div class="fld" style="--am:auto/1/span 1/span 6;--ad:auto/5/span 1/span 5"><input type="email" name="email" placeholder="Your email" autocomplete="email" aria-label="your email" required /></div>
              <div class="fld" style="--am:auto/1/span 2/span 6;--ad:auto/1/span 1/span 9"><textarea name="note" placeholder="Anything else? Venue, size, vibe — optional" aria-label="anything else"></textarea></div>
              <button class="send" type="submit" style="--am:auto/1/span 2/span 6;--ad:auto/1/span 2/span 9"><span>Send message</span><span aria-hidden="true">→</span></button>
              <p class="fine" data-snap style="--am:auto/1/span var(--rs,1)/span 6;--ad:auto/1/span var(--rs,1)/span 9;padding:var(--pad)"><span class="in" id="sent" style="display:block">Opens your email app with this written out. Or just write to <a href={`mailto:${contact.email}`}>{contact.email}</a></span></p>
            </div>
          </form>
        </section>

        <footer class="g t-paper" id="contact" data-sec="H" style="--cm:6;--cd:16">
          <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
          <p class="c lab mono" style="--am:1/1/span 1/span 6;--ad:1/1/span 1/span 16"><Dim measure="sec" /><span><i class="bal">H</i><span class="dk">Section H–H · </span>Or skip the form</span><b>{contact.basedIn}, will travel</b></p>
          <a class="mailw" href={`mailto:${contact.email}`} style="--am:2/1/span 1/span 6;--ad:2/1/span 2/span 16"><span class="mail" id="mail">{contact.email}</span></a>
          <a class="c big" href={ig} target="_blank" rel="noopener" style="--am:3/1/span 1/span 6;--ad:4/1/span 2/span 8"><span>Instagram ↗</span><small>@{contact.instagram}</small></a>
          <a class="c big" href={tw} target="_blank" rel="noopener" style="--am:4/1/span 1/span 6;--ad:4/9/span 2/span 8"><span>X ↗</span><small>@{contact.x}</small></a>
          <TitleBlock m={5} d={6} project="Oscar shoots events" title="event photo + video — hire sheet" by="Oscar" where={`${contact.basedIn}, will travel`} />
          <i style="--am:8/1/span 1/span 6;--ad:7/1/span 1/span 16" aria-hidden="true"></i>
        </footer>
      </div>
    </div>
    <a class="cta mono" id="cta" href="#book">Book →</a>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="bp-ring" x="-3%" y="-12%" width="106%" height="124%"><feMorphology in="SourceAlpha" operator="erode" radius="2" result="e" /><feComposite in="SourceGraphic" in2="e" operator="out" /></filter>
      <filter id="bp-ring-s" x="-3%" y="-12%" width="106%" height="124%"><feMorphology in="SourceAlpha" operator="erode" radius="1" result="e" /><feComposite in="SourceGraphic" in2="e" operator="out" /></filter>
    </svg>

    <Viewer bg={P.viewer.bg} fg={P.viewer.fg} accent={P.viewer.accent} onAccent={P.viewer.onAccent} mono='"Geist Mono", ui-monospace, monospace' display='"Inter Tight", sans-serif' />
    <Switcher />

    <script define:vars={{ email: contact.email }}>window.__mail = email;</script>
    <script>
      import { wireBook, fitText } from "@/components/photos/fable/r3/book";
      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const gs = [...document.querySelectorAll<HTMLElement>(".g")];

      // ── snap: text blocks grow in whole rows ──
      const rowH = () => parseFloat(getComputedStyle(gs[0]).gridAutoRows) || 60;
      function snap() {
        const r = rowH();
        document.querySelectorAll<HTMLElement>("[data-snap]").forEach((el) => {
          const inn = el.querySelector<HTMLElement>(".in"); if (!inn) return;
          const cs = getComputedStyle(el), own = inn.parentElement === el ? parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom) : 0;
          inn.style.alignSelf = "flex-start"; const h = inn.offsetHeight + own; inn.style.alignSelf = "";
          el.style.setProperty("--rs", String(Math.max(1, Math.ceil((h - 1) / r))));
        });
        // row numbers down the margin
        const rr = $("rr"), n = Math.round($("body").offsetHeight / r);
        dims(r);
        if (rr.childElementCount !== n) rr.innerHTML = Array.from({ length: n }, (_, i) => `<span>${String(i + 1).padStart(3, "0")}</span>`).join("");
      }
      // ── dimension lines carry real figures ──
      function dims(r: number) {
        document.querySelectorAll<HTMLElement>("[data-dim]").forEach((el) => {
          const em = el.querySelector("em"); if (!em) return;
          if (el.dataset.dim === "sec") {
            const g = el.closest<HTMLElement>(".g"); if (!g) return;
            const n = parseInt(getComputedStyle(g).getPropertyValue("--cols")) || 1, w = g.offsetWidth;
            em.textContent = `${n} × ${+(w / n).toFixed(1)} = ${w}`;
          } else em.textContent = String(Math.round(el.classList.contains("v") ? el.offsetHeight : el.offsetWidth));
        });
        document.querySelectorAll<HTMLElement>("[data-mod]").forEach((el) => (el.textContent = String(Math.round(r))));
      }
      fitText($("mail"));
      snap(); addEventListener("resize", snap); addEventListener("load", snap); (document as any).fonts?.ready.then(snap);

      // ── the grid draws itself, once per section ──
      const draw = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); draw.unobserve(e.target); } }), { rootMargin: "0px 0px -18% 0px" });
      gs.forEach((g) => draw.observe(g));

      // ── sticky ruler re-divides to the current section's columns ──
      const ticks = [...$("rl").querySelectorAll<HTMLElement>("i")], letter = $("rl-s");
      let curG: HTMLElement | null = null;
      function ruler() {
        let g = gs[0];
        for (const x of gs) { if (x.getBoundingClientRect().top <= 60) g = x; }
        if (g === curG) return; curG = g;
        const n = parseInt(getComputedStyle(g).getPropertyValue("--cols")) || 6;
        const wide = g.offsetWidth / gs[0].offsetWidth; // the 7 + 9 pair shares the ruler
        const total = wide < 0.9 ? 16 : n;
        ticks.forEach((t, i) => t.classList.toggle("off", i >= total));
        letter.textContent = g.dataset.sec ?? "";
      }
      let tick = false;
      addEventListener("scroll", () => { if (!tick) { tick = true; requestAnimationFrame(() => { tick = false; ruler(); }); } }, { passive: true });
      addEventListener("resize", () => { curG = null; ruler(); }); ruler();

      new IntersectionObserver(([e]) => $("cta").classList.toggle("on", !e.isIntersecting && e.boundingClientRect.top < 0)).observe($("top"));

      wireBook({
        form: $<HTMLFormElement>("form"), email: (window as any).__mail,
        cal: { grid: $("cal-grid"), title: $("cal-title"), prev: $<HTMLButtonElement>("cal-prev"), next: $<HTMLButtonElement>("cal-next") },
        nodate: $<HTMLInputElement>("nodate"), sent: $("sent"), picked: $("cal-picked"),
      });
    </script>
  </body>
</html>
