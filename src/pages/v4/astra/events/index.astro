---
import Layout from "../../../../v4/astra/Layout.astro";
import Icon from "../../../../v4/astra/Icon.astro";
import { Image } from "astro:assets";
import { eventSeriesList } from "../../../../data/eventSeries";
const contexts = [
  "the open invitation",
  "with the coloop crew",
  "less pitch deck. more demo.",
  "networking, with better scenery",
];
const copy = [
  "london's tech & AI builders and founders. hackathons, coworking, dinners, and the occasional very good excuse to leave the house.",
  "community events, meetups, and gatherings hosted by the coloop team. come meet the people behind the software.",
  "engineers, builders, and very early founders showing what they've been making in AI. real work, in a real room.",
  "interesting people, interesting places. bouldering, ramen classes, bikepacking. we don't do traditional networking. we venture, out.",
];
---

<Layout
  page="events"
  title="people & events — oscar.workspace"
  description="four ways to find your people. hackathons, demo nights, meetups and outdoor adventures with oscar falemara."
>
  <div class="document-heading">
    <span class="mono"><span class="purple-text">#</span> people.irl</span><span
      class="document-note"><span class="status-dot"></span> better in person</span
    >
  </div>
  <section class="events-hero">
    <div>
      <span class="eyebrow">a calendar is just a reason to say hi.</span><h1>
        close a few tabs.<br /><span>open a few doors.</span>
      </h1><p>
        i run outpost, a community for those building at the frontier. these are four of the
        calendars i’m involved with. find your kind of people, then come along.
      </p>
    </div><div class="events-stats">
      <div><strong>30+</strong><span>events hosted &<br />helped organise</span></div><div>
        <strong>2,000+</strong><span>people through<br />the door</span>
      </div>
    </div>
  </section>
  <div class="section-heading">
    <h2><span class="section-symbol">↳</span> find your people</h2><span class="mono subtle"
      >04 calendars</span
    >
  </div>
  <section class="calendar-list" aria-label="Event calendars">
    {
      eventSeriesList.map((series, i) => (
        <article class="calendar-card">
          <>
            <div class="calendar-card-visual">
              <>
                <span>CALENDAR / 0{i + 1}</span>
                <Image src={series.logo} alt="" width={96} height={96} />
              </>
            </div>
            <div class="calendar-card-content">
              <>
                <span class="mono">{contexts[i]}</span>
                <h2>{series.name.toLowerCase()}</h2>
                <p>{copy[i]}</p>
                <a class="button" href={`/v4/astra/events/${series.slug}`}>
                  open calendar <Icon name="arrow" size={16} />
                </a>
              </>
            </div>
          </>
        </article>
      ))
    }
  </section>
  <div class="calendar-bottom">
    <p>don't know anyone yet? that's a good reason to come.</p><a
      class="text-link"
      href="https://luma.com/oscarama"
      target="_blank"
      rel="noreferrer">my calendar on luma <Icon name="external" size={16} /></a
    >
  </div>
  <section class="people-section">
    <div class="people-copy">
      <span class="mono section-kicker">A RECENT HIGHLIGHT</span><h2>
        one organiser.<br /><span>a hundred builders.</span>
      </h2><p>
        i organised the london stop of vercel's zero to agent hackathon. three tracks, £5.8k in
        cash, and $1m+ in credits. a very good day of building.
      </p><a class="button primary" href="/events/zero-to-agent"
        >read the recap <Icon name="arrow" size={16} /></a
      >
    </div><div class="community-metrics">
      <div><strong>02<span>/05</span></strong><span>may 2026<br />london, uk</span></div><p
        class="mono"
      >
        with vercel.<br />sponsored by coderabbit,<br />bright data & mubit.
      </p>
    </div>
  </section>
  <section class="contact-section">
    <span class="mono">PEOPLE > PROFILES</span><h2>let's make something happen.</h2><p>
      an event, an idea, or a conversation. my dms are open.
    </p><div>
      <a class="button primary" href="https://x.com/oscarfalll" target="_blank" rel="noreferrer"
        >say hello <Icon name="external" size={16} /></a
      ><a class="text-link" href="/v4/astra"
        >back to the workspace <Icon name="arrow" size={16} /></a
      >
    </div>
  </section>
</Layout>
