---
import Posthog from "@/components/posthog.astro";
import TopBar from "../components/TopBar.astro";
import "../styles/opus.css";

interface Props {
  title?: string;
  description?: string;
  ogUrl?: string;
  /** which theme the page starts in, drives the top bar colours before JS runs */
  hud?: "light" | "dark";
  bodyClass?: string;
}

const {
  title = "oscar falemara · software engineer, community builder, aspiring rocket person",
  description = "self-taught software engineer from london. engineer at coloop ai (yc s21), runs outpost, a community for people building at the frontier. obsessed with aerospace.",
  ogUrl = "https://oscarama.dev/v2/opus",
  hud = "light",
  bodyClass = "",
} = Astro.props;

const ogImage = new URL("/og.png", ogUrl).href;
---

<!doctype html>
<html lang="en" data-hud={hud}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <Posthog />
    <meta name="robots" content="noindex" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={hud === "dark" ? "#05070f" : "#ece6d9"} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="oscarama.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@oscarfalll" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Stencil:opsz,wght@10..72,400..900&family=Big+Shoulders:opsz,wght@10..72,400..900&family=Instrument+Serif:ital@0;1&family=Martian+Mono:wdth,wght@75..112.5,300..700&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">skip to content</a>
    <TopBar />
    <slot />
    <script>
      import "../scripts/reveal";
      import "../scripts/hello";
    </script>
  </body>
</html>
