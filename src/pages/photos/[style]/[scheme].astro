---
// The prototype matrix: /photos/<style>/<scheme>. The site builds statically, so every pair is prerendered here
// and anything else is a 404. Styles + schemes live in src/components/photos/schemes.ts.
import Opus from "@/components/photos/opus/r3/Opus.astro";
import Module from "@/components/photos/fable/r3/Module.astro";
import ModuleBlueprint from "@/components/photos/fable/r3/ModuleBlueprint.astro";
import BitsPage from "@/components/photos/fable/r3/BitsPage.astro";
import { styleIds, schemeIds, type SchemeId, type StyleId } from "@/components/photos/schemes";

export function getStaticPaths() {
  return styleIds.flatMap((style) => schemeIds.map((scheme) => ({ params: { style, scheme } })));
}
const { style, scheme } = Astro.params as { style: StyleId; scheme: SchemeId };
---
{style === "opus-1" && <Opus scheme={scheme} />}
{style === "fable-2" && <Module scheme={scheme} />}
{style === "fable-2-blueprint" && <ModuleBlueprint scheme={scheme} />}
{style === "fable-4" && <BitsPage scheme={scheme} />}
