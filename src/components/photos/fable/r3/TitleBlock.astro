---
// Drawing title block for the blueprint pages. Sits on the module like everything else: its cells are direct
// children of a 6 / 16 column .g, starting at row `m` (mobile) / `d` (desktop). 3 rows on mobile, 1 on desktop.
interface Props { m: number; d: number; project: string; title: string; by: string; where: string; rev?: string; sheet?: string }
const { m, d, project, title, by, where, rev = "03", sheet = "1 / 1" } = Astro.props;
const date = new Date().toISOString().slice(0, 10);
---
<div class="tb tb-p" style={`--am:${m}/1/span 1/span 6;--ad:${d}/1/span 1/span 5`}><span class="mono">Project</span><b>{project}</b><small class="mono">{title}</small></div>
<div class="tb" style={`--am:${m + 1}/1/span 1/span 3;--ad:${d}/6/span 1/span 3`}><span class="mono">Drawn by</span><b>{by}</b><small class="mono">{where}</small></div>
<div class="tb" style={`--am:${m + 1}/4/span 1/span 3;--ad:${d}/9/span 1/span 2`}><span class="mono">Scale</span><b>1 mod = <i data-mod>–</i> px</b><small class="mono">do not scale drawing</small></div>
<div class="tb" style={`--am:${m + 2}/1/span 1/span 2;--ad:${d}/11/span 1/span 2`}><span class="mono">Sheet</span><b>{sheet}</b></div>
<div class="tb" style={`--am:${m + 2}/3/span 1/span 1;--ad:${d}/13/span 1/span 1`}><span class="mono">Rev</span><b class="tb-rev"><svg viewBox="0 0 26 23" aria-hidden="true"><path d="M13 1.5 24.5 21.5h-23Z" fill="none" stroke="currentColor" stroke-width="1.3" /></svg><i>{rev.replace(/^0/, "")}</i></b></div>
<div class="tb" style={`--am:${m + 2}/4/span 1/span 2;--ad:${d}/14/span 1/span 2`}><span class="mono">Date</span><b>{date}</b></div>
<a class="tb tb-top" href="#top" style={`--am:${m + 2}/6/span 1/span 1;--ad:${d}/16/span 1/span 1`}><span class="mono">Top</span><b aria-hidden="true">↑</b></a>
