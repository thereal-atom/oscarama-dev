---
// Invoice in the fable 2 language: an A4 sheet on a square module (12 mm, 15 × 22) with the construction lines
// left on, giant Inter Tight caps, Geist Pixel figures, an accent slab for the total and the same dither dissolve
// into the footer. Sized in mm so it prints 1:1 (Print → Save as PDF).
// Data: ./data.ts (same shape as citadel's InvoiceData).
import Switcher from "@/components/photos/Switcher.astro";
import Bits from "@/components/photos/fable/r3/Bits.astro";
import { icons, dissolve } from "@/components/photos/fable/r3/bits";
import { schemes, alpha, onAccent, type SchemeId } from "@/components/photos/schemes";
import { sample as data, invoiceTotals, lineTotal, formatMoney, formatDate, paymentRows } from "./data";

interface Props { scheme: SchemeId }
const S = schemes[Astro.props.scheme];
const ink = S.dark ? S.paper : S.ink, paper = S.dark ? S.ink : S.paper;
const onA = S.dark ? paper : onAccent(S, "paper", 3);
const vars = [
  `--acc:${S.accent}`, `--ink:${ink}`, `--paper:${paper}`, `--on-a:${onA}`,
  `--line:${alpha(S.accent, S.dark ? 0.3 : 0.24)}`, `--sub:${alpha(S.accent, 0.55)}`, `--mute:${alpha(ink, 0.62)}`,
  `--frame:color-mix(in srgb, ${S.accent} ${S.dark ? 30 : 24}%, ${paper})`, // the cell-line colour, made opaque
  `--desk:${S.dark ? "#000" : "#D9D7D0"}`,
].join(";");

const money = (n: number) => formatMoney(n, data.currency);
const T = invoiceTotals(data);
const items = data.items.filter((i) => i.description.trim() || i.quantity || i.unitPrice);
const pay = paymentRows(data.payment);
const notes = data.notes.trim();
const fromLines = [data.from.email, data.from.website, ...data.from.address.split("\n")].map((l) => l.trim()).filter(Boolean);
const custLines = [data.customer.contactName, data.customer.email, ...data.customer.address.split("\n")].map((l) => l.trim()).filter(Boolean);

// ── row plan (rows are 12 mm modules; everything lands on whole cells) ──
const COLS = 15;
let row = 11; // 1 header · 2–3 INVOICE · 4 meta · 6–8 parties · 10 table head
const rows = items.map((it) => { const h = it.description.length > 62 ? 2 : 1; /* ~62 characters fit on one line of the description */ const r = row; row += h; return { it, r, h }; });
const t0 = row;
const sums: Array<[string, string]> = [["subtotal", money(T.subtotal)]];
if (T.discount > 0) sums.push(["discount", `-${money(T.discount)}`]);
if (data.taxRate > 0) sums.push([`${data.taxLabel.trim() || "tax"} (${data.taxRate}%)`, money(T.tax)]);
const totalRow = t0 + sums.length;
const totalsEnd = totalRow + 2;
const paySpan = pay.length ? Math.max(2, Math.ceil(((pay.length + 1) * 4.6 + 4) / 12)) : 0;
const notesRow = Math.max(totalsEnd, t0 + paySpan);
const notesSpan = notes ? 2 : 0;
const last = Math.max(22, notesRow + notesSpan + 2); // dissolve row, then the footer slab
const at = (r: number, c: number, h: number, w: number) => `grid-area:${r}/${c}/span ${h}/span ${w}`;
// dissolve: 4 mm pixels (3 to a module) — two dithered rows, then a solid one sitting on the footer slab
const dz = dissolve(42, COLS * 3, 2).flatMap((line, y) => [...line].flatMap((ch, x) => (ch === "#" ? [`${y + 1}/${x + 1}`] : [])));

---
<!doctype html>
<html lang="en" style={vars} data-scheme={S.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{`invoice ${data.number} — ${data.from.name}`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;800;900&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style is:inline>
      @font-face{font-family:"Geist Pixel";src:url("https://cdn.jsdelivr.net/npm/geist@1.9.2/dist/fonts/geist-pixel/GeistPixel-Square.woff2") format("woff2");font-display:block}
      :root{--mm:min(1mm,calc((100vw - 32px) / 210));--m:calc(12 * var(--mm));
        --sans:"Inter Tight","Helvetica Neue",Helvetica,Arial,sans-serif;--mono:"Geist Mono",ui-monospace,monospace;--px:"Geist Pixel","Geist Mono",monospace;
        -webkit-print-color-adjust:exact;print-color-adjust:exact}
      *{box-sizing:border-box}
      html{background:var(--desk)}
      body{margin:0;background:var(--desk);color:var(--ink);font:500 calc(3.2 * var(--mm))/1.35 var(--sans);-webkit-font-smoothing:antialiased;padding:56px 16px 96px}
      p,h1,h2,dl,dd{margin:0}
      a{color:inherit;text-decoration:none}

      .sheet{position:relative;width:calc(210 * var(--mm));min-height:calc(297 * var(--mm));margin:0 auto;background:var(--paper);
        padding:calc(18 * var(--mm)) calc(15 * var(--mm)) calc(15 * var(--mm));box-shadow:0 1px 2px rgba(0,0,0,.12),0 12px 40px rgba(0,0,0,.18)}
      .grid{position:relative;display:grid;grid-template-columns:repeat(15,var(--m));grid-template-rows:repeat(var(--rows),var(--m));
        background-image:linear-gradient(to right,var(--line) 1px,transparent 1px),linear-gradient(var(--line) 1px,transparent 1px);
        background-size:var(--m) var(--m);box-shadow:inset -1px -1px var(--line)}
      .grid>*{min-width:0;position:relative}
      /* the outer frame: one heavier, opaque rule drawn over the edge cells (so every edge block reads as closed and
         the thin cell lines butt into it cleanly); the accent slabs sit above it */
      .grid::after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 0 calc(.6 * var(--mm)) var(--frame);pointer-events:none;z-index:3}
      .grid>.fill,.grid>.dz{z-index:4}

      .c{background:var(--paper);box-shadow:inset 1px 0 var(--line),inset 0 1px var(--line);padding:calc(2 * var(--mm))}
      .fill{background:var(--acc);color:var(--on-a);box-shadow:none}
      .mono{font:500 calc(2.1 * var(--mm))/1.35 var(--mono);text-transform:uppercase;letter-spacing:.04em}
      .lab{color:var(--acc);display:block}
      .fill .lab{color:inherit;opacity:.8}
      .cap{font:900 calc(var(--m) * 1.3755 * var(--k,1))/calc(var(--m) * var(--k,1)) var(--sans);letter-spacing:-.04em;text-transform:uppercase;white-space:nowrap;padding-left:.035em;color:var(--acc)}

      .brand{display:flex;flex-direction:column;justify-content:space-between}
      .brand b{font:900 calc(4.6 * var(--mm))/1 var(--sans);letter-spacing:-.02em}
      .ic{display:grid;place-items:center;padding:0;--p:calc(var(--m) / 12)}
      .bm{display:block;width:calc(var(--bw) * var(--p));height:calc(var(--bh) * var(--p));fill:currentColor;stroke:currentColor;stroke-width:.04;overflow:visible}
      .bm .ac{fill:var(--acc);stroke:var(--acc)}

      .meta{display:flex;flex-direction:column;justify-content:space-between}
      .meta b{font:400 calc(4.4 * var(--mm))/1 var(--px);font-weight:400;white-space:nowrap}

      .party{display:flex;flex-direction:column;gap:calc(1.2 * var(--mm))}
      .party h2{font:800 calc(5.6 * var(--mm))/1 var(--sans);letter-spacing:-.03em;text-transform:uppercase}
      .party p{color:var(--mute);white-space:pre-line}

      .th{display:flex;align-items:flex-end;padding:0 calc(2 * var(--mm)) calc(1.6 * var(--mm));color:var(--acc);box-shadow:inset 0 calc(-.5 * var(--mm)) var(--acc)}
      .td{display:flex;align-items:center;padding:0 calc(2 * var(--mm))}
      .r{justify-content:flex-end;text-align:right}
      .num{font:400 calc(2.9 * var(--mm))/1 var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap}
      .desc{font-weight:500;line-height:1.25}
      .amt{font-weight:500;color:var(--ink)}
      .qty,.unit{color:var(--mute)}

      .sum{display:flex;align-items:center;justify-content:space-between;padding:0 calc(2 * var(--mm))}
      .sum span:first-child{color:var(--mute)}
      .total{display:flex;flex-direction:column;justify-content:space-between;padding:calc(2 * var(--mm)) calc(2.4 * var(--mm))}
      .total b{align-self:flex-end;font:900 calc(9.5 * var(--mm))/.9 var(--sans);letter-spacing:-.04em;white-space:nowrap}

      .pay dl{display:grid;grid-template-columns:auto 1fr;gap:calc(.6 * var(--mm)) calc(3 * var(--mm));margin-top:calc(1.6 * var(--mm))}
      .pay dt{color:var(--mute);font:500 calc(2.1 * var(--mm))/1.6 var(--mono);text-transform:uppercase;letter-spacing:.04em}
      .pay dd{font:400 calc(2.9 * var(--mm))/1.35 var(--mono)}
      .notes p{margin-top:calc(1.2 * var(--mm));color:var(--mute)}

      .dz{display:grid;grid-template-columns:repeat(45,1fr);grid-template-rows:repeat(3,1fr)}
      .dz i{background:var(--acc)}
      .dz .solid{grid-area:3/1/4/-1}

      .foot{display:flex;align-items:flex-end;justify-content:space-between;gap:calc(4 * var(--mm));padding:0 calc(2 * var(--mm)) 0 0}
      .foot .cap{color:var(--on-a)}
      .foot .mono{padding-bottom:calc(2 * var(--mm));text-align:right}

      .tools{position:fixed;left:16px;top:14px;z-index:50;display:flex;gap:8px}
      .tools button{font:500 11px/1 "Geist Mono",monospace;text-transform:uppercase;letter-spacing:.04em;border:0;border-radius:0;padding:9px 11px;background:var(--acc);color:var(--on-a);cursor:pointer}
      .tools button:hover{background:var(--ink);color:var(--paper)}

      @page{size:A4;margin:0}
      @media print{
        :root{--mm:1mm}
        html,body{background:var(--paper)}
        body{padding:0}
        .sheet{box-shadow:none;margin:0}
        .tools,.psw{display:none !important}
      }
    </style>
  </head>
  <body>
    <div class="tools">
      <button type="button" onclick="print()">Print / save PDF</button>
    </div>
    <main class="sheet">
      <div class="grid" style={`--rows:${last}`}>
        <div class="c brand" style={at(1, 1, 1, 4)}><b>OSCAR</b><span class="mono">photo + video</span></div>
        <div class="c ic" style={at(1, 15, 1, 1)} aria-hidden="true"><Bits rows={icons.camera} /></div>

        <h1 class="cap" style={`${at(2, 1, 2, 15)};--k:2`}>Invoice</h1>

        <div class="c meta" style={at(4, 1, 1, 4)}><span class="mono lab">No.</span><b>{data.number || "—"}</b></div>
        <div class="c meta" style={at(4, 5, 1, 4)}><span class="mono lab">Issued</span><b>{formatDate(data.issueDate)}</b></div>
        <div class="c meta" style={at(4, 9, 1, 4)}><span class="mono lab">Due</span><b>{formatDate(data.dueDate)}</b></div>

        <div class="c party" style={at(6, 1, 3, 7)}>
          <span class="mono lab">Billed to</span>
          <h2>{data.customer.company || "customer"}</h2>
          <p>{custLines.join("\n")}</p>
        </div>
        <div class="c party" style={at(6, 9, 3, 7)}>
          <span class="mono lab">From</span>
          <h2>{data.from.name}</h2>
          <p>{fromLines.join("\n")}</p>
        </div>

        <span class="th mono" style={at(10, 1, 1, 8)}>Description</span>
        <span class="th mono r" style={at(10, 9, 1, 2)}>Qty</span>
        <span class="th mono r" style={at(10, 11, 1, 2)}>Unit</span>
        <span class="th mono r" style={at(10, 13, 1, 3)}>Amount</span>
        {rows.map(({ it, r, h }) => (
          <>
            <span class="c td desc" style={at(r, 1, h, 8)}>{it.description || "—"}</span>
            <span class="c td r num qty" style={at(r, 9, h, 2)}>{it.quantity || 0}</span>
            <span class="c td r num unit" style={at(r, 11, h, 2)}>{money(Number(it.unitPrice) || 0)}</span>
            <span class="c td r num amt" style={at(r, 13, h, 3)}>{money(lineTotal(it))}</span>
          </>
        ))}
        {items.length === 0 && <span class="c td qty" style={at(11, 1, 1, 15)}>no line items yet</span>}

        {sums.map(([l, v], i) => <div class="c sum num" style={at(t0 + i, 9, 1, 7)}><span>{l}</span><span>{v}</span></div>)}
        <div class="c fill total" style={at(totalRow, 9, 2, 7)}><span class="mono lab">Total · {data.currency}</span><b>{money(T.total)}</b></div>

        {pay.length > 0 && (
          <div class="c pay" style={at(t0, 1, paySpan, 7)}>
            <span class="mono lab">Payment details</span>
            <dl>{pay.map(([l, v]) => <><dt>{l}</dt><dd>{v}</dd></>)}</dl>
          </div>
        )}
        {notes && <div class="c notes" style={at(notesRow, 1, notesSpan, 15)}><span class="mono lab">Notes</span><p>{notes}</p></div>}

        <div class="dz" style={at(last - 1, 1, 1, 15)} aria-hidden="true">{dz.map((a) => <i style={`grid-area:${a}`} />)}<i class="solid" /></div>
        <div class="fill foot" style={at(last, 1, 1, 15)}>
          <span class="cap">Thank you</span>
          <span class="mono">{[data.from.website, data.from.email].filter(Boolean).join(" · ")}</span>
        </div>
      </div>
    </main>
    <Switcher />
  </body>
</html>
