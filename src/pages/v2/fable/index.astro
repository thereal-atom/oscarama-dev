  <script>
    const doc = document.documentElement;
    const body = document.body;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const secs = Array.from(document.querySelectorAll<HTMLElement>(".ascent > [data-alt]"));
    const altEl = document.querySelector<HTMLElement>("[data-alt].hud__alt b, .hud [data-alt]");
    const phaseEl = document.querySelector<HTMLElement>(".hud [data-phase]");
    const rail = document.querySelector<HTMLElement>(".rail")!;
    const dot = document.querySelector<HTMLElement>(".rail__dot")!;
    const ridgePaths = Array.from(document.querySelectorAll<SVGPathElement>(".peaks__ridges path"));
    const peaks = document.getElementById("peaks")!;

    const maxScroll = () => doc.scrollHeight - window.innerHeight;
    const jump = (y: number, smooth = false) =>
      window.scrollTo({ top: y, behavior: smooth && !reduce ? "smooth" : "instant" });
    // in a page that climbs, "going to a section" means parking its floor on the viewport floor
    const floorOf = (el: HTMLElement) =>
      Math.max(0, el.getBoundingClientRect().bottom + window.scrollY - window.innerHeight);

    // ── start on the ground ──
    history.scrollRestoration = "manual";
    let touched = false;
    const settle = () => {
      if (touched) return;
      const target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
      jump(target ? floorOf(target) : maxScroll());
    };
    settle();
    // the browser's own #hash jump lands late and aims for section tops; we want floors
    window.addEventListener("load", () => {
      settle();
      setTimeout(settle, 60);
      setTimeout(settle, 400);
    });
    window.addEventListener("hashchange", () => {
      const t = document.getElementById(location.hash.slice(1));
      if (t) jump(floorOf(t));
    });
    // fonts and images shift the stack while it loads; stay parked until the visitor takes over
    new ResizeObserver(settle).observe(document.querySelector(".ascent")!);
    document.fonts?.ready.then(settle);
    ["wheel", "touchstart", "keydown", "pointerdown"].forEach((e) =>
      window.addEventListener(e, () => (touched = true), { passive: true, once: true })
    );

    // ── rail ticks ──
    const ticks: { el: HTMLElement; sec: HTMLElement }[] = [];
    for (const sec of secs) {
      if (!sec.dataset.label) continue;
      const t = document.createElement("div");
      t.className = "rail__tick";
      const a = document.createElement("a");
      a.href = `#${sec.id}`;
      a.textContent = sec.dataset.label;
      a.dataset.jump = "";
      t.append(a);
      rail.append(t);
      ticks.push({ el: t, sec });
    }
    const placeTicks = () => {
      const m = maxScroll() || 1;
      for (const t of ticks) t.el.style.bottom = `${(1 - floorOf(t.sec) / m) * 100}%`;
    };

    // ── altitude ──
    const fmt = (m: number) => {
      if (m >= 1.4e11) return "1 au";
      if (m >= 1e9) return `${(m / 1e9).toFixed(1)}m km`;
      if (m >= 1e5) return `${Math.round(m / 1000).toLocaleString("en-GB")} km`;
      if (m >= 1e4) return `${(m / 1000).toFixed(1)} km`;
      return `${Math.round(m).toLocaleString("en-GB")} m`;
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const m = maxScroll() || 1;
      const up = 1 - window.scrollY / m; // 0 on the pad, 1 at the top

      let alt = 0;
      let phase = secs[0].dataset.phase!;
      let active = secs[0];
      for (let i = 0; i < secs.length; i++) {
        const r = secs[i].getBoundingClientRect();
        // at the very top the final section may be shorter than the viewport; it still counts
        const last = i === secs.length - 1;
        if (window.scrollY <= 1 && !last) continue;
        // sections run bottom → top in DOM order: the first one whose ceiling is above the viewport floor is where we are
        if (r.top < vh - 1 || last) {
          const a = Number(secs[i].dataset.alt);
          const b = Number(secs[i].dataset.altEnd ?? secs[i + 1]?.dataset.alt ?? a);
          const span = last ? Math.max(1, r.height - vh) : r.height;
          const g = window.scrollY <= 1 ? 1 : Math.min(1, Math.max(0, (r.bottom - vh) / span));
          alt = a > 0 && b / a > 20 ? a * Math.pow(b / a, g) : a + (b - a) * g;
          phase = secs[i].dataset.phase!;
          active = secs[i];
          break;
        }
      }
      if (altEl) altEl.textContent = fmt(alt);
      if (phaseEl) phaseEl.textContent = phase;
      dot.style.transform = `translateY(${-up * (rail.clientHeight - 11)}px)`;
      for (const t of ticks) t.el.classList.toggle("on", t.sec === active);
      body.classList.toggle("flying", window.scrollY < m - 40);

      if (!reduce) {
        const pr = peaks.getBoundingClientRect();
        if (pr.bottom > 0 && pr.top < vh) {
          const d = pr.bottom - vh; // 0 when the foot of the mountains meets the viewport floor
          for (const p of ridgePaths) {
            p.style.transform = `translateY(${(d * Number(p.dataset.k)).toFixed(1)}px)`;
          }
        }
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      placeTicks();
      onScroll();
    });
    window.addEventListener("load", () => {
      placeTicks();
      update();
    });
    placeTicks();
    update();

    // ── in-page jumps ──
    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>("a[data-jump]");
      if (!a) return;
      const target = document.getElementById(a.hash.slice(1));
      if (!target) return;
      e.preventDefault();
      stopBurn();
      jump(floorOf(target), true);
      history.replaceState(null, "", a.hash);
    });

    // ── reveal ──
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            en.target.classList.add("in");
            io.unobserve(en.target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
    );
    document.querySelectorAll(".rv").forEach((el) => io.observe(el));

    // ── launch: countdown, then a slow burn all the way up ──
    const btn = document.querySelector<HTMLButtonElement>("[data-launch]")!;
    const label = document.querySelector<HTMLElement>("[data-launch-label]")!;
    let burn = 0;
    let timers: number[] = [];
    function stopBurn() {
      cancelAnimationFrame(burn);
      burn = 0;
      timers.forEach(clearTimeout);
      timers = [];
      body.classList.remove("counting");
      label.textContent = "launch";
    }
    const ignite = () => {
      body.classList.remove("counting");
      label.textContent = "liftoff";
      let last = performance.now();
      let v = 60;
      const step = (now: number) => {
        const dt = Math.min(50, now - last) / 1000;
        last = now;
        v = Math.min(520, v + 260 * dt);
        const y = window.scrollY - v * dt;
        window.scrollTo(0, y);
        if (y <= 0) return stopBurn();
        burn = requestAnimationFrame(step);
      };
      burn = requestAnimationFrame(step);
    };
    btn.addEventListener("click", () => {
      window.posthog?.capture("v2_fable_launch");
      if (burn || timers.length) return stopBurn();
      if (reduce) return jump(0);
      body.classList.add("counting");
      ["t-3", "t-2", "t-1"].forEach((t, i) =>
        timers.push(window.setTimeout(() => (label.textContent = t), i * 650))
      );
      timers.push(
        window.setTimeout(() => {
          timers = [];
          ignite();
        }, 3 * 650)
      );
    });
    ["wheel", "touchstart", "keydown"].forEach((e) =>
      window.addEventListener(e, () => burn && stopBurn(), { passive: true })
    );
    document.querySelector("[data-land]")?.addEventListener("click", () => jump(maxScroll(), true));

    document
      .querySelectorAll<HTMLElement>("[data-social]")
      .forEach((a) =>
        a.addEventListener("click", () =>
          window.posthog?.capture("social_link_clicked", { platform: a.dataset.social, v: "fable" })
        )
      );

    console.log(
      "%c▲ oscarama / fable %c\nyou opened the hatch. respect. → https://github.com/thereal-atom",
      "background:#ff4d00;color:#15130e;font-weight:bold;padding:4px 8px",
      "color:inherit"
    );
  </script>
</Layout>
