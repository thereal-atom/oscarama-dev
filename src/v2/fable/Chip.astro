---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  src: ImageMetadata | string;
  text: string;
  internal?: boolean;
}
const { href, src, text, internal = false } = Astro.props;
const ext = internal ? {} : { target: "_blank", rel: "noopener noreferrer" };
const url =
  typeof src === "string"
    ? src
    : (await getImage({ src, width: 72, height: 72, fit: "contain" })).src;
---

<a class="chip" href={href} {...ext}
  ><img src={url} alt="" width="18" height="18" loading="lazy" decoding="async" /><span>{text}</span
  ></a
>
