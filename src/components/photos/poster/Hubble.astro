---
// HUBBLE — a black page, one small sans, and colour that only ever comes from the photographs.
// Art direction from the "before Hubble" poster: huge soft pixel-mosaic colour fields with film grain around a black
// void, tiny precise type sitting in the void, minimal meta in a corner.
// Each section's field is computed from a photo: the frame is averaged down to ~30 cells across, its tones are
// graded onto the scheme's two colour families (by luminance and by warmth), and a void is cut around whatever
// sits in the section (the photo, or the text). The one interaction: a photo arrives as that same coarse mosaic
// and steps into focus (1 → 2 → 4 → sharp) the first time it is on screen.
import Switcher from "@/components/photos/Switcher.astro";
import Viewer from "@/components/photos/fable/r3/Viewer.astro";
import { schemes, alpha, type SchemeId } from "@/components/photos/schemes";
import { allShots, services, contact, clients } from "@/data/photos";
import { mixed, shotIndex } from "@/components/photos/fable/derive";

interface Props { scheme: SchemeId }
const S = schemes[Astro.props.scheme];
// two colour families per scheme, deep → pale. cool-toned parts of a photo take the first, warm-toned the second
const ramps = S.id === "infrared"
  ? { cool: ["#7A0E5C", "#D81B60", "#FF5C7A", "#FFD0C8"], warm: ["#B3260F", "#FF5A1F", "#FF9A3D", "#FFE6B8"] }
  : { cool: ["#1420A8", "#2F6BFF", "#45C8E8", "#D6F6FF"], warm: ["#3A1FC0", "#6A3DF0", "#A58BFF", "#EDE4FF"] };

const idx = (s: { id: string }) => shotIndex.get(s.id)!;
const heroSrc = allShots[10], aboutSrc = allShots[31], getSrc = allShots[13], footSrc = allShots[27];
const plates = [1, 18, 20, 30, 22, 9].map((i) => allShots[i]);
const taken = new Set(plates.map((s) => s.id));
const rest = mixed.filter((s) => !taken.has(s.id)).slice(0, 18);
// where each plate's photo sits on the 36-column desktop grid (start column), and which side its caption takes
const X = [4, 11, 8, 12, 3, 17];
const pad = (n: number) => String(n).padStart(2, "0");
const ig = `https://instagram.com/${contact.instagram}`, tw = `https://x.com/${contact.x}`;
const kinds = ["conference", "hackathon", "demo night", "launch", "panel", "meetup", "offsite", "something else"];
const needs = ["photos", "recap video", "portraits"];
const vars = `--accent:${S.accent};--ink:${S.ink};--paper:${S.paper};--dim:${alpha(S.paper, 0.56)};--line:${alpha(S.paper, 0.22)}`;
---
<!doctype html>
<html lang="en" class="hb" style={vars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Oscar — event photography + video for tech events</title>
    <meta name="description" content="Freelance event photography and video for tech and startup events. London, will travel." />
    <meta name="theme-color" content={S.ink} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://picsum.photos" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <style is:inline>
      *,*::before,*::after{box-sizing:border-box}
      /* html.hb prefix: other styles on this route leak bare html/body rules, so ours must out-rank them */
      html.hb{-webkit-text-size-adjust:100%;scroll-behavior:smooth;background:var(--ink)}
      html.hb body{margin:0;background:var(--ink);color:var(--paper);font:400 14px/1.45 "Inter",Helvetica,Arial,sans-serif;letter-spacing:-.006em;overflow-x:clip;-webkit-font-smoothing:antialiased;--cell:calc(100vw/30);--gx:20px}
      @media (min-width:900px){html.hb body{--cell:calc(100vw/36);--gx:40px}}
      a{color:inherit;text-decoration:none}
      a:hover,a:focus-visible{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
      :focus-visible{outline:1px solid currentColor;outline-offset:4px}
      img{display:block}
      p,h1,h2,h3{margin:0;font:inherit}
      .lg{font-size:22px;line-height:1.18;font-weight:500;letter-spacing:-.02em}
      .dim{color:var(--dim)}
      .sm{font-size:12px;line-height:1.4}
      @media (min-width:900px){.lg{font-size:26px}}

      /* ── a plate: a colour field (canvas, giant pixels) + grain, and a void around .core ── */
      .plate{position:relative;overflow:hidden;background:var(--ink);isolation:isolate}
      .fld{position:absolute;left:0;top:0;width:100%;height:100%;image-rendering:pixelated;z-index:-2;opacity:0;transition:opacity .6s}
      .fld.in{opacity:1}
      .plate::after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;mix-blend-mode:overlay;opacity:.3;
        background-image:var(--grain);background-size:140px 140px}
      .meta{position:absolute;left:var(--gx);right:var(--gx);top:16px;display:flex;justify-content:space-between;gap:16px;z-index:2}
      .meta span+span{margin-left:1.6em}

      /* ── hero ── */
      .hero{min-height:100svh;display:grid;place-items:center;padding:calc(var(--cell)*6) var(--gx)}
      .hero .core{display:grid;gap:28px}
      .links{display:grid;grid-template-columns:auto auto;column-gap:40px;justify-content:start}
      .links a{display:flex;align-items:center;min-height:36px}
      .links div{display:grid;align-content:start}

      /* ── selects: one photo per plate ── */
      .shot{margin:0;padding:calc(var(--cell)*11) 0 calc(var(--cell)*11)}
      .shot .core{display:grid;gap:calc(var(--cell)*1);margin-left:calc(var(--cell)*2);width:calc(var(--cell)*26)}
      .shot.p .core{margin-left:calc(var(--cell)*4);width:calc(var(--cell)*22)}
      .ph{position:relative;display:block;height:calc(var(--cell)*17);overflow:hidden;background:var(--ink);cursor:zoom-in}
      .shot.p .ph{height:calc(var(--cell)*28)}
      .ph img{width:100%;height:100%;object-fit:cover}
      .ph canvas{position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated;display:none}
      .js .ph.px canvas{display:block}
      .cap{display:grid;grid-template-columns:auto 1fr;column-gap:1.6em;align-items:start}
      @media (min-width:900px){
        .shot{padding:calc(var(--cell)*6) 0 calc(var(--cell)*6)}
        .shot .core,.shot.p .core{display:flex;align-items:flex-end;gap:calc(var(--cell)*1);width:auto;margin-left:calc(var(--cell)*var(--x))}
        .shot.r .core{flex-direction:row-reverse;justify-content:flex-end;margin-left:calc(var(--cell)*(var(--x) - 7))}
        .ph{width:calc(var(--cell)*21);height:calc(var(--cell)*14);flex:none}
        .shot.p .ph{width:calc(var(--cell)*12);height:calc(var(--cell)*15)}
        .cap{display:block;width:calc(var(--cell)*6);flex:none}
        .cap .dim{margin-top:.5em}
        .shot.r .cap{text-align:right}
      }

      /* ── index of the rest ── */
      .void{position:relative;padding:calc(var(--cell)*5) var(--gx) calc(var(--cell)*7)}
      .head{display:flex;justify-content:space-between;gap:16px;padding-bottom:18px}
      .idx{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--cell)}
      .idx a{position:relative;display:block;aspect-ratio:1;overflow:hidden;background:#000;cursor:zoom-in}
      .idx img{width:100%;height:100%;object-fit:cover}
      @media (min-width:900px){.idx{grid-template-columns:repeat(9,1fr)}.void{padding:calc(var(--cell)*3) var(--gx) calc(var(--cell)*4)}}

      /* ── text plates ── */
      .words{padding:calc(var(--cell)*9) var(--gx)}
      .words .core{max-width:30em;margin:0 auto;display:grid;gap:14px}
      .words .core .sm{padding-bottom:6px}
      @media (min-width:900px){.words{padding:calc(var(--cell)*6) var(--gx)}.about .core{margin-left:calc(var(--cell)*8 - var(--gx))}}

      /* the one flip: a section set in ink on a full field */
      .get{color:var(--ink);padding:calc(var(--cell)*5) var(--gx) calc(var(--cell)*6)}
      .get .dim{color:inherit;opacity:.7}
      .get ol{list-style:none;margin:0;padding:0;display:grid;gap:26px}
      .get li{display:grid;gap:5px;max-width:22em}
      .get li p{font-weight:500}
      @media (min-width:900px){.get{padding:calc(var(--cell)*3) var(--gx) calc(var(--cell)*4)}.get ol{grid-template-columns:repeat(4,1fr);gap:40px}}

      .logos{list-style:none;margin:0;padding:calc(var(--cell)*2) 0 0;display:grid;grid-template-columns:1fr 1fr;gap:44px 20px;justify-items:center}
      .logos li{display:grid;justify-items:center;gap:12px}
      .logos img{height:30px;width:auto;max-width:120px;object-fit:contain;filter:brightness(0) invert(1)}
      @media (min-width:900px){.logos{grid-template-columns:repeat(4,1fr);max-width:calc(var(--cell)*24);margin:0 auto}}

      /* ── contact ── */
      .contact .col{max-width:520px;margin:0 auto;display:grid;gap:30px}
      .contact .lede{display:grid;gap:10px}
      form{display:grid;gap:28px}
      fieldset{border:0;margin:0;padding:0;min-width:0}
      legend,.flab{display:block;padding:0 0 8px;color:var(--dim);font-size:12px}
      .opts{display:flex;flex-wrap:wrap;column-gap:22px}
      .opt{position:relative;display:flex;align-items:center;gap:9px;min-height:40px;cursor:pointer}
      .opt input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
      .opt i{width:9px;height:9px;border:1px solid var(--dim);flex:none}
      .opt input:checked~i{background:var(--accent);border-color:var(--accent)}
      .opt input:checked~span{color:var(--paper)}
      .opt span{color:var(--dim)}
      .opt:hover span{color:var(--paper)}
      .opt input:focus-visible~span{text-decoration:underline;text-underline-offset:3px}
      .fld-in{display:block}
      .fld-in input,.fld-in textarea{display:block;width:100%;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;color:var(--paper);font:400 16px/1.4 "Inter",Helvetica,Arial,sans-serif;padding:8px 0 10px;min-height:44px;appearance:none;-webkit-appearance:none;color-scheme:dark}
      .fld-in textarea{min-height:76px;resize:vertical}
      .fld-in input::placeholder,.fld-in textarea::placeholder{color:var(--dim);opacity:.7}
      .fld-in input:focus,.fld-in textarea:focus{outline:0;border-bottom-color:var(--paper)}
      .send{position:relative;display:flex;justify-content:space-between;align-items:center;width:100%;min-height:calc(var(--cell)*4);padding:0 18px;border:0;border-radius:0;cursor:pointer;overflow:hidden;
        background:var(--accent) center/100% 100% no-repeat;image-rendering:pixelated;color:var(--ink);font:500 16px/1 "Inter",Helvetica,Arial,sans-serif;letter-spacing:-.01em}
      .send:hover,.send:focus-visible{filter:brightness(1.12)}
      @media (min-width:900px){.send{min-height:calc(var(--cell)*2)}}

      /* ── footer ── */
      .foot{padding:calc(var(--cell)*10) var(--gx) calc(var(--cell)*10 + 60px)}
      .foot .core{display:grid;gap:22px;justify-items:start;width:fit-content;margin:0 auto}
      .mail{font-size:clamp(28px,8.2vw,76px);line-height:1;letter-spacing:-.035em;font-weight:400}
      .socs{display:flex;gap:28px}
      .socs a{display:flex;align-items:center;min-height:40px}
      @media (min-width:900px){.foot{padding:calc(var(--cell)*7) var(--gx)}}
      @media (prefers-reduced-motion:reduce){html.hb{scroll-behavior:auto}.fld{transition:none}}
    </style>
  </head>
  <body data-ramps={JSON.stringify(ramps)} data-ink={S.ink}>
    <header class="plate hero" id="top" data-src={heroSrc.thumb}>
      <canvas class="fld" aria-hidden="true"></canvas>
      <p class="meta sm"><span>Oscar</span><span><span>Photo + video</span><span>{contact.basedIn}</span></span></p>
      <div class="core" data-void>
        <h1 class="lg">Event photography<br />and video for tech<br />and startup events</h1>
        <nav class="links" aria-label="page">
          <div>
            <a href="#selects">Selects</a>
            <a href="#about">About</a>
            <a href="#get">What you get</a>
            <a href="#contact">Contact me</a>
          </div>
          <div>
            <a href={ig} target="_blank" rel="noopener">Instagram ↗</a>
            <a href={tw} target="_blank" rel="noopener">X ↗</a>
            <a href={`mailto:${contact.email}`}>Email ↗</a>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <section id="selects" aria-label="Selects">
        {plates.map((s, i) => (
          <figure class:list={["plate shot", { p: s.height > s.width, r: i % 2 === 1 }]} style={`--x:${X[i]}`}>
            <canvas class="fld" aria-hidden="true"></canvas>
            <div class="core" data-void>
              <a class="ph" href={s.src} data-shot={idx(s)} aria-label={`open photo: ${s.caption}, ${s.event.name}`}>
                <img data-live src={s.thumb} srcset={`${s.thumb} 533w, ${s.src} 1600w`} sizes="(min-width:900px) 59vw, 87vw" alt={s.caption} crossorigin="anonymous" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
                <canvas aria-hidden="true"></canvas>
              </a>
              <figcaption class="cap sm">
                <span>No.{pad(i + 1)}</span>
                <span>
                  <span>{s.caption}</span>
                  <span class="dim" style="display:block">{s.event.name}, {s.event.place}</span>
                  <span class="dim" style="display:block">{s.exif.lens.split(" ")[0]} · {s.exif.aperture} · {s.exif.shutter}s · ISO {s.exif.iso}</span>
                </span>
              </figcaption>
            </div>
          </figure>
        ))}
        <div class="void">
          <p class="head sm"><span>More selects</span><span class="dim">No.{pad(plates.length + 1)}–{pad(plates.length + rest.length)}</span></p>
          <div class="idx">
            {rest.map((s) => (
              <a href={s.src} data-shot={idx(s)} aria-label={`open photo: ${s.caption}, ${s.event.name}`}><img src={s.thumb} alt={s.caption} loading="lazy" decoding="async" /></a>
            ))}
          </div>
        </div>
      </section>

      <section class="plate words about" id="about" data-src={aboutSrc.thumb}>
        <canvas class="fld" aria-hidden="true"></canvas>
        <div class="core" data-void>
          <p class="sm dim">About</p>
          <h2 class="lg">I'm Oscar. I photograph and film tech and startup events.</h2>
          <p>Conferences, hackathons, demo nights, launches, panels, offsites. The keynote and the hallway, the 3am of a hackathon, the moment the demo works.</p>
          <p>I come from that world, so I know who and what matters in the room. Candid over posed, and edited fast enough that you can post while people are still talking about it.</p>
          <p class="dim">Based in {contact.basedIn}, will travel.</p>
        </div>
      </section>

      <section class="plate get" id="get" data-src={getSrc.thumb} data-mode="full">
        <canvas class="fld" aria-hidden="true"></canvas>
        <p class="head sm"><span>What you get</span><span class="dim">Mix and match</span></p>
        <ol>
          {services.map((s, i) => (
            <li><span class="sm dim">No.{pad(i + 1)}</span><h3 class="lg">{s.name.charAt(0).toUpperCase() + s.name.slice(1)}</h3><p>{s.detail.charAt(0).toUpperCase() + s.detail.slice(1)}</p></li>
          ))}
        </ol>
      </section>

      <section class="void" id="clients">
        <p class="head sm"><span>Clients</span><span class="dim">Shot events for</span></p>
        <ul class="logos">
          {clients.map((c) => <li><img src={c.name === "SpaceX AI" ? "/photos/opus/spacexai-mark.svg" : c.logo.src} alt="" loading="lazy" /><span class="sm dim">{c.name}</span></li>)}
        </ul>
      </section>

      <section class="void contact" id="contact">
        <div class="col">
          <div class="lede">
            <p class="sm dim">Contact me</p>
            <h2 class="lg">Tell me what the event is and where to reply.</h2>
            <p class="dim">I'll come back within a day with availability and a quote.</p>
          </div>
          <form id="form" novalidate>
            <fieldset><legend>What is it?</legend>
              <div class="opts">{kinds.map((k) => <label class="opt"><input type="radio" name="kind" value={k} /><i></i><span>{k.charAt(0).toUpperCase() + k.slice(1)}</span></label>)}</div>
            </fieldset>
            <fieldset><legend>What do you need?</legend>
              <div class="opts">{needs.map((k, i) => <label class="opt"><input type="checkbox" name="need" value={k} checked={i === 0} /><i></i><span>{k.charAt(0).toUpperCase() + k.slice(1)}</span></label>)}</div>
            </fieldset>
            <label class="fld-in"><span class="flab">When is it? Optional</span><input type="date" name="date" /></label>
            <label class="fld-in"><span class="flab">Your name</span><input type="text" name="name" autocomplete="name" /></label>
            <label class="fld-in"><span class="flab">Where do I reply?</span><input type="email" name="email" autocomplete="email" placeholder="you@company.com" required /></label>
            <label class="fld-in"><span class="flab">Anything else? Optional</span><textarea name="note" placeholder="Venue, size, what you want out of it"></textarea></label>
            <button class="send" id="send" type="submit" data-src={footSrc.thumb}><span>Send message</span><span aria-hidden="true">→</span></button>
            <p class="sm dim" id="sent" aria-live="polite">Opens your email app with this written out. Or write to <a href={`mailto:${contact.email}`} style="color:var(--paper)">{contact.email}</a></p>
          </form>
        </div>
      </section>
    </main>

    <footer class="plate foot" id="direct" data-src={footSrc.thumb}>
      <canvas class="fld" aria-hidden="true"></canvas>
      <div class="core" data-void>
        <p class="sm dim">Or skip the form</p>
        <a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a>
        <p class="socs lg"><a href={ig} target="_blank" rel="noopener">Instagram ↗</a><a href={tw} target="_blank" rel="noopener">X ↗</a></p>
        <p class="sm dim">Oscar · event photo + video · {contact.basedIn} &nbsp; <a href="#top">Back to top ↑</a></p>
      </div>
    </footer>

    <Viewer bg="#000000" fg={S.paper} accent={S.accent} onAccent={S.ink} bookHref="#contact" bookLabel="contact me about a shoot like this →" mono='"Inter", sans-serif' display='"Inter", sans-serif' />
    <Switcher />
    <script define:vars={{ email: contact.email }}>window.__mail = email;</script>
    <script>
      import { wireBook } from "@/components/photos/fable/r3/book";
      type RGB = [number, number, number];
      const hex = (h: string): RGB => { const n = parseInt(h.slice(1), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255]; };
      const R = JSON.parse(document.body.dataset.ramps!) as { cool: string[]; warm: string[] };
      const cool = R.cool.map(hex), warm = R.warm.map(hex), INK = hex(document.body.dataset.ink!);
      const clamp = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
      const ss = (a: number, b: number, x: number) => { const t = clamp((x - a) / (b - a)); return t * t * (3 - 2 * t); };
      const ramp = (st: RGB[], t: number, k: number) => { const u = clamp(t) * (st.length - 1), i = Math.min(st.length - 2, Math.floor(u)), f = u - i; return st[i][k] + (st[i + 1][k] - st[i][k]) * f; };
      const COLS = () => (innerWidth >= 900 ? 36 : 30);
      const rank = (v: Float32Array) => { const o = Array.from(v.keys()).sort((a, b) => v[a] - v[b]), r = new Float32Array(v.length); o.forEach((i, k) => (r[i] = k / (v.length - 1))); return r; };

      /** paint a field of cols×rows cells from `img` (or a synthetic fallback), graded to the scheme, with a void around `rect` (in cells) */
      function paint(cv: HTMLCanvasElement, img: HTMLImageElement | null, cols: number, rows: number, rect: { x: number; y: number; w: number; h: number } | null, full: boolean, seed: number, fall = 5, round = 0.3, floor = 0.18, fade = 3) {
        cv.width = cols; cv.height = rows;
        const x = cv.getContext("2d", { willReadFrequently: true })!;
        const n = cols * rows, L = new Float32Array(n), Wm = new Float32Array(n);
        let ok = false;
        if (img && img.naturalWidth) {
          try {
            // average the frame right down first, then stretch it back: soft blobs many cells wide
            const s = document.createElement("canvas"); s.width = Math.max(3, Math.round(cols / 5)); s.height = Math.max(3, Math.round(rows / 5));
            const sx = s.getContext("2d")!; sx.imageSmoothingQuality = "high";
            const r = Math.max(s.width / img.naturalWidth, s.height / img.naturalHeight), dw = img.naturalWidth * r, dh = img.naturalHeight * r;
            sx.drawImage(img, (s.width - dw) / 2, (s.height - dh) / 2, dw, dh);
            x.imageSmoothingEnabled = true; x.imageSmoothingQuality = "high"; x.drawImage(s, 0, 0, cols, rows);
            const d = x.getImageData(0, 0, cols, rows).data;
            for (let i = 0; i < n; i++) { L[i] = 0.299 * d[i * 4] + 0.587 * d[i * 4 + 1] + 0.114 * d[i * 4 + 2]; Wm[i] = d[i * 4] - d[i * 4 + 2]; }
            ok = true;
          } catch { /* cross-origin without CORS: fall through */ }
        }
        if (!ok) for (let i = 0; i < n; i++) { const cx = i % cols, cy = (i / cols) | 0; L[i] = Math.sin(cx * 0.21 + seed) * Math.cos(cy * 0.17 + seed * 1.7) + Math.sin((cx + cy) * 0.09 + seed * 3); Wm[i] = Math.cos(cx * 0.13 - cy * 0.11 + seed * 2.3); }
        const lr = rank(L), out = x.createImageData(cols, rows), o = out.data;
        // warmth picks the colour family. a near-monochrome frame has no real warmth signal (ranking it would just be noise),
        // so the less colour a photo has, the more its family follows luminance instead
        let wlo = Infinity, whi = -Infinity; for (let i = 0; i < n; i++) { if (Wm[i] < wlo) wlo = Wm[i]; if (Wm[i] > whi) whi = Wm[i]; }
        const wk = ok ? clamp((whi - wlo) / 50) : 1;
        for (let i = 0; i < n; i++) {
          const cx = (i % cols) + 0.5, cy = ((i / cols) | 0) + 0.5, t = lr[i], w = ss(0.3, 0.7, ((Wm[i] - wlo) / (whi - wlo || 1)) * wk + (1 - t) * (1 - wk));
          let v = 1;
          if (!full) {
            if (rect) {
              // distance outside a rounded rect (radius `rad`), in units of the falloff
              const rad = Math.min(rect.w, rect.h) * round;
              const dx = Math.max(0, Math.abs(cx - (rect.x + rect.w / 2)) - (rect.w / 2 - rad)), dy = Math.max(0, Math.abs(cy - (rect.y + rect.h / 2)) - (rect.h / 2 - rad));
              const d = Math.max(0, Math.hypot(dx, dy) - rad) / fall;
              v = ss(0.12, 1, d + (t - 0.5) * 0.9 * ss(0, 0.5, d)); // black inside the rect, then an edge that follows the photo's tones
            }
            v *= ss(0, 1, Math.min(cy, rows - cy) / fade); // fields never touch each other: they fall to black at the top and bottom of a plate
          }
          const tt = full ? 0.6 + 0.4 * t : floor + (1 - floor) * t;
          for (let k = 0; k < 3; k++) { const a = ramp(cool, tt, k), b = ramp(warm, tt, k); o[i * 4 + k] = INK[k] + (a + (b - a) * w - INK[k]) * v; }
          o[i * 4 + 3] = 255;
        }
        x.putImageData(out, 0, 0);
      }

      // film grain: one small bitmap of noise, tiled and overlaid on every field (a bitmap blends far cheaper than an SVG filter)
      { const c = document.createElement("canvas"); c.width = c.height = 140; const g = c.getContext("2d")!, im = g.createImageData(140, 140);
        for (let i = 0; i < im.data.length; i += 4) { const v = 128 + (Math.random() + Math.random() - 1) * 120; im.data[i] = im.data[i + 1] = im.data[i + 2] = v; im.data[i + 3] = 255; }
        g.putImageData(im, 0, 0); document.documentElement.style.setProperty("--grain", `url(${c.toDataURL()})`); }

      const plates = [...document.querySelectorAll<HTMLElement>(".plate")];
      const srcOf = new Map<HTMLElement, HTMLImageElement>();
      function field(p: HTMLElement, i: number) {
        const cv = p.querySelector<HTMLCanvasElement>(".fld")!, cols = COLS(), W = p.clientWidth, cell = W / cols, rows = Math.max(2, Math.ceil(p.clientHeight / cell - 0.02));
        cv.style.height = rows * cell + "px";
        const core = p.querySelector<HTMLElement>("[data-void]"), shot = p.classList.contains("shot"), hero = p.classList.contains("hero");
        let rect = null;
        if (core) { const a = core.getBoundingClientRect(), b = p.getBoundingClientRect(), m = shot ? 0.5 : 1.2; rect = { x: (a.left - b.left) / cell - m, y: (a.top - b.top) / cell - m, w: a.width / cell + m * 2, h: a.height / cell + m * 2 }; }
        const im = srcOf.get(p) ?? null;
        paint(cv, im && im.complete && im.naturalWidth ? im : null, cols, rows, rect, p.dataset.mode === "full", i * 1.9 + 0.7, shot ? 4.5 : hero ? cols / 3.4 : 5.5, shot ? 0.22 : hero ? 0.42 : 0.28, shot ? 0.34 : 0.18, shot ? 1.6 : 3);
        cv.classList.add("in");
      }
      plates.forEach((p, i) => {
        let im = p.querySelector<HTMLImageElement>(".ph img");
        if (!im) { im = new Image(); im.crossOrigin = "anonymous"; im.decoding = "async"; im.src = p.dataset.src!; }
        srcOf.set(p, im);
        const go = () => field(p, i);
        if (im.complete && im.naturalWidth) go(); else { im.addEventListener("load", go, { once: true }); im.addEventListener("error", go, { once: true }); }
      });
      let lw = innerWidth, tm = 0;
      addEventListener("resize", () => { if (innerWidth === lw) return; lw = innerWidth; clearTimeout(tm); tm = window.setTimeout(() => plates.forEach(field), 150); });
      (document as any).fonts?.ready.then(() => plates.forEach((p, i) => { if (p.querySelector(".fld.in")) field(p, i); }));

      // the send button wears a strip of the footer's field
      const send = document.getElementById("send")!;
      { const im = new Image(); im.crossOrigin = "anonymous"; im.onload = () => { const c = document.createElement("canvas"); paint(c, im, 26, 3, null, true, 1); try { send.style.backgroundImage = `url(${c.toDataURL()})`; } catch {} }; im.src = send.dataset.src!; }

      // a photo arrives at the field's resolution and steps into focus the first time it is on screen
      const still = matchMedia("(prefers-reduced-motion:reduce)").matches;
      function pix(a: HTMLElement, k: number) {
        const im = a.querySelector("img")!, cv = a.querySelector("canvas")!, cell = innerWidth / COLS();
        const cols = Math.max(1, Math.round((a.clientWidth / cell) * k)), rows = Math.max(1, Math.round((a.clientHeight / cell) * k));
        cv.width = cols; cv.height = rows;
        const x = cv.getContext("2d")!, r = Math.max(cols / im.naturalWidth, rows / im.naturalHeight), dw = im.naturalWidth * r, dh = im.naturalHeight * r;
        x.imageSmoothingQuality = "high"; x.drawImage(im, (cols - dw) / 2, (rows - dh) / 2, dw, dh);
      }
      if (!still) {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (!e.isIntersecting) return;
          const a = e.target as HTMLElement; io.unobserve(a);
          const im = a.querySelector("img")!;
          const run = () => { [2, 4].forEach((k, j) => setTimeout(() => pix(a, k), 170 * (j + 1))); setTimeout(() => a.classList.remove("px"), 170 * 3); };
          if (im.complete && im.naturalWidth) run(); else im.addEventListener("load", run, { once: true });
        }), { threshold: 0.6 });
        document.querySelectorAll<HTMLElement>(".shot .ph").forEach((a) => {
          const im = a.querySelector("img")!;
          a.classList.add("px");
          const first = () => pix(a, 1);
          if (im.complete && im.naturalWidth) first(); else im.addEventListener("load", first, { once: true });
          im.addEventListener("error", () => a.classList.remove("px"), { once: true });
          io.observe(a);
        });
      }

      wireBook({ form: document.getElementById("form") as HTMLFormElement, email: (window as any).__mail, sent: document.getElementById("sent") });
    </script>
  </body>
</html>
