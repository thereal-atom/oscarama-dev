---
import { Image } from "astro:assets";
import Topo from "../Topo.astro";
import Ridges from "../Ridges.astro";
import { logos, links, partners } from "../../data/content";
import { eventSeriesList } from "@/data/eventSeries";

const legend = [
  { sym: "▲", t: "mountains" },
  { sym: "⋯", t: "hiking" },
  { sym: "◆", t: "bouldering" },
  { sym: "◢", t: "rock climbing" },
  { sym: "➝", t: "running" },
  { sym: "⟋", t: "skiing" },
  { sym: "△", t: "camping" },
];
---

<section class="camp" id="base-camp" data-alt="900" data-theme="light" data-zone="base camp">
  <div class="wrap">
    <header class="sec-head label" data-reveal>
      <span class="no">§03</span><span>base camp</span><span class="rule"></span><span
        >where the crew gathers</span
      >
    </header>

    <div class="camp__stats">
      <div class="stat" data-reveal>
        <span class="stat__n stencil">30+</span>
        <span class="stat__l label">events hosted &amp;<br />helped organise</span>
      </div>
      <div class="stat" data-reveal style="--d:100">
        <span class="stat__n stencil">2,000+</span>
        <span class="stat__l label">people through<br />the door</span>
      </div>
    </div>

    <div class="camp__grid">
      <div class="camp__copy" data-reveal>
        <p class="camp__lede serif">
          i like putting interesting people in the same room and seeing what happens.
        </p>
        <p>
          hackathons, dinners, coworking, demo nights, run clubs, bouldering sessions. i've hosted
          and helped organise 30+ events with 2,000+ people attending, working with companies like
          these:
        </p>
        <ul class="partners" aria-label="companies i've worked with on events">
          {
            partners.map((p) => {
              const ext = /^https?:/.test(p.href);
              return (
                <li>
                  <a
                    class="partner"
                    href={p.href}
                    target={ext ? "_blank" : undefined}
                    rel={ext ? "noopener noreferrer" : undefined}
                    data-ph="partner"
                    data-ph-label={p.name}
                  >
                    <span class="partner__tile">
                      <Image src={logos[p.logo]} alt="" width={80} height={80} />
                    </span>
                    <span class="label">{p.name}</span>
                  </a>
                </li>
              );
            })
          }
          <li class="partners__more label">+ more</li>
        </ul>
      </div>

      <div class="series" data-reveal style="--d:120">
        <div class="series__head label">
          <span>event series</span><span>{eventSeriesList.length} active</span>
        </div>
        <ul>
          {
            eventSeriesList.map((s, i) => (
              <li>
                <a class="series__row" href={`/v2/opus/events/${s.slug}`}>
                  <span class="series__no label">0{i + 1}</span>
                  <span class="series__logo">
                    <Image src={s.logo} alt="" width={64} height={64} />
                  </span>
                  <span class="series__name">{s.name.toLowerCase()}</span>
                  <span class="series__arr" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="series__ctas">
          <a class="btn btn--hot" href="/v2/opus/events"
            >departures board <span class="arr">→</span></a
          >
          <a
            class="btn"
            href={links.myLuma}
            target="_blank"
            rel="noopener noreferrer"
            data-ph="cta"
            data-ph-label="my-luma">my calendar <span class="arr">↗</span></a
          >
        </div>
      </div>
    </div>

    <div class="offgrid" data-reveal>
      <div class="offgrid__map" aria-hidden="true">
        <Topo
          seed={5}
          levels={11}
          cell={24}
          width={900}
          height={520}
          hot={9}
          scale={0.0034}
          peak={[0.56, 0.52, 0.16, 0.8]}
          summitLabel="summit: tbd"
        />
      </div>
      <div class="offgrid__copy">
        <p class="label offgrid__k">off-grid</p>
        <h3 class="offgrid__h display">gone outside.</h3>
        <p>
          when i'm not at a laptop i'm usually halfway up something: mountains, hiking trails,
          bouldering walls, real rock. also running, skiing and camping. basically anything outdoors
          with a view at the end.
        </p>
        <ul class="legend" aria-label="things i do outside">
          {
            legend.map((l) => (
              <li>
                <span class="legend__sym" aria-hidden="true">
                  {l.sym}
                </span>
                <span class="label">{l.t}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <Ridges class="camp__ridges" />
</section>

<style>
  .camp {
    position: relative;
    padding-top: clamp(56px, 7vw, 110px);
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }

  .camp__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 20px clamp(24px, 5vw, 80px);
    margin: 30px 0 clamp(30px, 4vw, 56px);
  }
  .stat {
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .stat__n {
    font-size: clamp(88px, 11.2vw, 176px);
    line-height: 0.78;
  }
  .stat:nth-child(2) .stat__n {
    color: var(--orange);
  }
  .stat__l {
    padding-bottom: 6px;
    color: var(--ink-2);
  }

  .camp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: start;
  }
  .camp__lede {
    font-size: clamp(28px, 2.7vw, 40px);
    line-height: 1.05;
    max-width: 20ch;
    margin-bottom: 20px;
  }
  .camp__copy > p:not(.camp__lede) {
    max-width: 52ch;
  }

  .partners {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }
  .partner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 86px;
    padding: 12px 6px 9px;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.25s,
      transform 0.35s var(--ease-out),
      background 0.25s;
  }
  .partner:hover {
    border-color: var(--ink);
    background: var(--paper-2);
    transform: translateY(-3px);
  }
  .partner__tile {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    overflow: hidden;
    background: #0e0d0b;
    display: grid;
    place-items: center;
  }
  .partner__tile :global(img) {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }
  .partner .label {
    font-size: 9px;
  }
  .partners__more {
    display: grid;
    place-items: center;
    width: 86px;
    border: 1px dashed var(--rule-strong);
    border-radius: 4px;
    color: var(--ink-2);
    font-size: 9px;
  }

  .series {
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--paper-2);
  }
  .series__head {
    display: flex;
    justify-content: space-between;
    padding: 12px 16px 10px;
    background: var(--ink);
    color: var(--paper);
  }
  .series__head span:last-child {
    color: var(--orange);
  }
  .series__row {
    display: grid;
    grid-template-columns: 28px 36px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
    transition: background 0.2s;
  }
  .series__row:hover {
    background: var(--paper);
  }
  .series__no {
    color: var(--ink-2);
  }
  .series__logo {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    overflow: hidden;
    background: #0e0d0b;
  }
  .series__logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .series__name {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 24px;
    line-height: 1;
    text-transform: uppercase;
    padding-top: 2px;
  }
  .series__arr {
    transition:
      transform 0.3s var(--ease-out),
      color 0.2s;
  }
  .series__row:hover .series__arr {
    transform: translateX(4px);
    color: var(--orange-ink);
  }
  .series__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 16px;
  }

  .offgrid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    margin-top: clamp(56px, 7vw, 110px);
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    overflow: hidden;
    background: var(--paper-2);
  }
  .offgrid__map {
    position: relative;
    min-height: 300px;
    color: var(--ink);
    border-right: 1px solid var(--rule-strong);
    background-image:
      linear-gradient(to right, var(--rule) 1px, transparent 1px),
      linear-gradient(to bottom, var(--rule) 1px, transparent 1px);
    background-size: 80px 80px;
  }
  .offgrid__map :global(svg) {
    position: absolute;
    inset: 0;
  }
  .offgrid__copy {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(22px, 3vw, 40px);
  }
  .offgrid__k {
    color: var(--orange-ink);
  }
  .offgrid__h {
    font-size: clamp(48px, 5.4vw, 84px);
  }
  .offgrid__copy p:not(.label) {
    max-width: 46ch;
  }
  .legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px 18px;
    margin-top: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .legend__sym {
    width: 18px;
    text-align: center;
    color: var(--orange-ink);
    font-size: 13px;
  }

  .camp__ridges {
    margin-top: clamp(48px, 6vw, 96px);
  }

  @media (max-width: 900px) {
    .camp__grid,
    .offgrid {
      grid-template-columns: 1fr;
    }
    .offgrid__map {
      border-right: 0;
      border-bottom: 1px solid var(--rule-strong);
      min-height: 220px;
    }
  }
  @media (max-width: 480px) {
    .stat {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .partners {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .partner,
    .partners__more {
      width: 100%;
    }
    .partners__more {
      min-height: 84px;
    }
    .series__name {
      font-size: 20px;
    }
  }
</style>
