---
import Posthog from "@/components/posthog.astro";
import "./fable.css";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  bodyClass?: string;
}

const {
  title = "oscar falemara — going up",
  description = "self-taught software engineer from london. building at coloop ai (yc s21), running outpost, plotting rockets.",
  path = "/v2/fable",
  bodyClass = "",
} = Astro.props;
const ogUrl = `https://oscarama.dev${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Posthog />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ECE5D5" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://oscarama.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="oscarama.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://oscarama.dev/og.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Instrument+Serif:ital@0;1&family=Martian+Mono:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <slot name="head" />
  </head>
  <body class={`fable ${bodyClass}`}>
    <a class="skip" href="#content">skip to content</a>
    <slot />
  </body>
</html>
