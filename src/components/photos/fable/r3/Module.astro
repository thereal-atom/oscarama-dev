        <section id="contact" aria-label="contact me">
          <div class="g t-blue" data-sec={sec.contact} style="--cm:6;--cd:16">
            <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
            <p class="lab mono" style="--am:1/1/span 1/span 6;--ad:1/1/span 1/span 16;padding:var(--pad)"><span>{sec.contact} — Contact me</span><b>I reply within a day</b></p>
            <h2 style="display:contents" aria-label="Contact me">
              <span class="cap fit" aria-hidden="true" style="--am:2/1/span 1/span 6;--ad:2/1/span 2/span 16">Contact</span>
              <span class="cap fit" aria-hidden="true" style="--am:3/1/span 1/span 6;--ad:4/1/span 2/span 8">me</span>
            </h2>
            <p class="say" data-snap style="--am:4/1/span var(--rs,3)/span 6;--ad:4/9/span 2/span 8;padding:var(--pad);font-size:clamp(20px,2.2cqw,32px);line-height:1.12"><span class="in" style="display:block">Tell me what you're planning — an event, a launch, a product, anything. I'll get back to you with availability and a quote.</span></p>
          </div>
          <form class="g t-blue" id="form" data-sec={sec.contact} novalidate style="--cm:6;--cd:16">
            <div class="vl" aria-hidden="true">{L.map((i) => <i style={`--i:${i}`} />)}</div>
            <div class="fld" style="--am:1/1/span 1/span 6;--ad:1/1/span 1/span 8"><input type="text" name="name" placeholder="Your name" autocomplete="name" aria-label="your name" /></div>
            <div class="fld" style="--am:2/1/span 1/span 6;--ad:1/9/span 1/span 8"><input type="email" name="email" placeholder="Your email" autocomplete="email" aria-label="your email" required /></div>
            <div class="fld" style="--am:3/1/span 3/span 6;--ad:2/1/span 3/span 12"><textarea name="note" placeholder="What's the plan? Date, place, rough idea — whatever you know so far" aria-label="your message"></textarea></div>
            <button class="send" type="submit" style="--am:6/1/span 2/span 6;--ad:2/13/span 3/span 4"><span>Send message</span><span aria-hidden="true">→</span></button>
            <p class="fine" data-snap style="--am:8/1/span var(--rs,1)/span 6;--ad:5/1/span var(--rs,1)/span 16;padding:var(--pad)"><span class="in" id="sent" style="display:block">Opens your email app with this written out. Or just write to <a href={`mailto:${contact.email}`}>{contact.email}</a></span></p>
